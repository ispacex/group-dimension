module

public import Mathlib

@[expose] public section

/-!
# Fifth dimension subgroups: the statements submitted to Palomar

This file states, using Mathlib alone, the results of the development
`GroupDimension` (https://github.com/ispacex/group-dimension) that accompany the paper
S. Vorobev, *On the inclusion `D₅(G) ⊆ γ₄(G)`: reductions, the Lie-ring proof, and evidence*
(2026; https://ispacex.github.io/d5). `Solution.lean` proves every statement below from the
development, with only `propext`, `Classical.choice` and `Quot.sound`.

**Setting.** For a group `G`, `Δ(G)` is the augmentation ideal of the integral group ring
`ℤ[G]` (Mathlib's `MonoidAlgebra ℤ G`), and the `n`-th integral dimension subgroup is
`D_n(G) = {g ∈ G | g - 1 ∈ Δ(G)^n}`. It always contains `γ_n(G)`, the `n`-th term of the lower
central series. Kourovka Problem 20.84 asks whether `D₅(G) ⊆ γ₄(G)` for every group; this is
**open**, and nothing here claims it or its negation.

**Indexing.** Mathlib's `(⊤ : Subgroup G).lowerCentralSeries k` is `γ_{k+1}(G)`: so `γ₂ = (⊤ : Subgroup G).lowerCentralSeries 1`,
`γ₃ = (⊤ : Subgroup G).lowerCentralSeries 2`, `γ₄ = (⊤ : Subgroup G).lowerCentralSeries 3`, `γ₅ = (⊤ : Subgroup G).lowerCentralSeries 4`.

**What is unconditional and what is not.**
* Unconditional: Theorems 6.6 and 6.8 of the paper (`D₅ = γ₅` when `G/γ₂` is a finite group of
  exponent 3, or a finite 3-group whose cubes form a cyclic group); the inclusion
  `D₅(G) ⊆ M₅(G)` (Jennings' "hard" inclusion in the case needed); Lemma 5.6 and the Lean
  part of Proposition 5.7 (statements about *candidates*).
* Conditional, with the hypotheses as explicit arguments (no axioms are added): the
  reduction of Problem 20.84 to finite 2-groups of class 3 (Proposition 2.1), which assumes
  `D₃ = γ₃`, Passi's `D₄² ⊆ γ₄` and a form of Gruenberg's theorem; the passage from a minimal
  counterexample to a candidate (Lemma 5.2), which assumes `D₃ = γ₃`; and the `D₅` form of
  Proposition 5.7, which assumes `D₃ = γ₃` and the computer result of the paper's
  Proposition 5.3 (no group of order `2^10` and class `≤ 3` has `D₅ ≠ 1`).
  These hypotheses are classical theorems (`D₃ = γ₃`, Passi, Gruenberg) or a computer
  result of the paper (Proposition 5.3); none of them is proved here.

**Candidates.** In a candidate (paper, §5) `M₅` is *defined* by Jennings' product formula
`M_n(G) = ∏_{i p^j ≥ n} γ_i(G)^{p^j}` (`jennings` below). The paper uses
`M_n(G) = G ∩ (1 + Δ_{𝔽_p}(G)^n)`; the two agree by Jennings' theorem, which is not formalized
in general. What is formalized is the inclusion that matters for `D₅`:
`D₅(G) ⊆ jennings 2 G 5` for a finite 2-group of class `≤ 3` (`D_five_le_jennings`), so the
condition `n ∈ M₅` of a candidate is met by the elements of `D₅`. Since the formalized inclusion
is `G ∩ (1 + Δ_{𝔽₂}(G)^5) ⊆ jennings 2 G 5` (class `≤ 3`), the non-existence results for
candidates (Lemma 5.6, Proposition 5.7) are at least as strong as the paper's; conversely
`isCandidate_of_minimal` (Lemma 5.2 (b)) yields `n ∈ jennings 2 Q 5`, which is the paper's
`n ∈ M₅` only via the unformalized direction of Jennings' theorem.
-/

namespace GroupDimension.Palomar

open MonoidAlgebra

/-! ## Definitions -/

/-- The augmentation `ε : ℤ[G] → ℤ`, `g ↦ 1`. -/
noncomputable def augmentation (G : Type*) [Group G] : MonoidAlgebra ℤ G →+* ℤ :=
  (MonoidAlgebra.lift ℤ ℤ G (1 : G →* ℤ)).toRingHom

/-- The augmentation ideal `Δ(G) = ker ε` of the integral group ring. -/
noncomputable def augIdeal (G : Type*) [Group G] : Ideal (MonoidAlgebra ℤ G) :=
  RingHom.ker (augmentation G)

/-- The `n`-th integral dimension subgroup `D_n(G) = {g ∈ G | g - 1 ∈ Δ(G)^n}`, as a set.
(It is a normal subgroup; the statements below only use the set.) -/
def DSet (n : ℕ) (G : Type*) [Group G] : Set G :=
  {g | MonoidAlgebra.of ℤ G g - 1 ∈ augIdeal G ^ n}

/-- `H^m`: the subgroup generated by the `m`-th powers of the elements of `H`. -/
def powSubgroup {G : Type*} [Group G] (H : Subgroup G) (m : ℕ) : Subgroup G :=
  Subgroup.closure {g | ∃ h ∈ H, h ^ m = g}

/-- Auxiliary: `expCentralAux p G k = P_{k+1}(G)`. -/
def expCentralAux (p : ℕ) (G : Type*) [Group G] : ℕ → Subgroup G
  | 0 => ⊤
  | k + 1 => ⁅expCentralAux p G k, ⊤⁆ ⊔ powSubgroup (expCentralAux p G k) p

/-- The lower exponent-`p` central series in the paper's numbering: `P₁(G) = G`,
`P_{i+1}(G) = [P_i(G), G] · P_i(G)^p` (and `P₀(G) = G`). -/
def expCentral (p : ℕ) (G : Type*) [Group G] (n : ℕ) : Subgroup G :=
  expCentralAux p G (n - 1)

/-- Jennings' product `M_n(G) = ∏_{i p^j ≥ n} γ_i(G)^{p^j}` over `i ≥ 1`, `j ≥ 0` (the index `i`
below is Mathlib's, `(⊤ : Subgroup G).lowerCentralSeries i = γ_{i+1}(G)`). By Jennings' theorem this equals
`G ∩ (1 + Δ_{𝔽_p}(G)^n)`; that equality is **not** formalized in general (see
`D_five_le_jennings` for the inclusion of `D₅`). -/
def jennings (p : ℕ) (G : Type*) [Group G] (n : ℕ) : Subgroup G :=
  ⨆ (i : ℕ) (j : ℕ) (_ : n ≤ (i + 1) * p ^ j), powSubgroup ((⊤ : Subgroup G).lowerCentralSeries i) (p ^ j)

/-- A *candidate* (paper, §5) with central involution `n`: a finite 2-group of class exactly 3
with cyclic centre, whose central involution `n` lies in `γ₃ ∩ M₅` (`M₅` by Jennings' formula),
and whose 2-class `c` (the length of the series `P_i`) is at least 4 with `P_c = ⟨n⟩`. -/
structure IsCandidate (G : Type*) [Group G] (n : G) : Prop where
  finite : Finite G
  isPGroup : IsPGroup 2 G
  gamma_four_eq_bot : (⊤ : Subgroup G).lowerCentralSeries 3 = ⊥
  gamma_three_ne_bot : (⊤ : Subgroup G).lowerCentralSeries 2 ≠ ⊥
  isCyclic_center : IsCyclic (Subgroup.center G)
  mem_center : n ∈ Subgroup.center G
  orderOf_eq_two : orderOf n = 2
  mem_gamma_three : n ∈ (⊤ : Subgroup G).lowerCentralSeries 2
  mem_jennings : n ∈ jennings 2 G 5
  twoClass : ∃ c ≥ 4, expCentral 2 G (c + 1) = ⊥ ∧ expCentral 2 G c = Subgroup.zpowers n

/-- The abelian group `ℤ/4 × (ℤ/2)^7`, written multiplicatively. -/
abbrev Z4Z2pow7 := Multiplicative (ZMod 4 × (Fin 7 → ZMod 2))

/-! ## Named statements used only as hypotheses

Each is a `Prop`; none is assumed globally and none is proved here. A theorem that needs one
takes it as an explicit argument. They quantify over groups `G : Type` (universe 0), which keeps them in `Prop` without universe
parameters. For `DimensionQuestion5` this is no loss: a counterexample `g ∈ D₅(G) \ γ₄(G)` already
lives in a finitely generated subgroup, which is isomorphic to a group in `Type`. -/

/-- Kourovka Problem 20.84 (**open**): `D₅(G) ⊆ γ₄(G)` for every group `G`. -/
def DimensionQuestion5 : Prop :=
  ∀ (G : Type) [Group G], DSet 5 G ⊆ ((⊤ : Subgroup G).lowerCentralSeries 3 : Set G)

/-- `D₃(G) = γ₃(G)` for every group (classical: G. Higman and R. Rees; I. B. S. Passi, 1968;
see Passi, *Group rings and their augmentation ideals*, LNM 715, 1979). Not proved here. -/
def DThreeEqGammaThree : Prop :=
  ∀ (G : Type) [Group G], DSet 3 G = ((⊤ : Subgroup G).lowerCentralSeries 2 : Set G)

/-- Passi (1968): `g ∈ D₄(G) ⇒ g² ∈ γ₄(G)` for every group. Not proved here. -/
def PassiDFourSquare : Prop :=
  ∀ (G : Type) [Group G], ∀ g ∈ DSet 4 G, g ^ 2 ∈ (⊤ : Subgroup G).lowerCentralSeries 3

/-- Gruenberg (1957), in the form used in the paper's Proposition 2.1: in a finitely generated
nilpotent group, an element none of whose odd powers is trivial survives in some finite
2-group quotient. Not proved here. -/
def GruenbergResidualTwo : Prop :=
  ∀ (G : Type) [Group G], Group.FG G → Group.IsNilpotent G →
    ∀ g : G, (∀ m : ℕ, Odd m → g ^ m ≠ 1) →
      ∃ (N : Subgroup G) (_ : N.Normal), Finite (G ⧸ N) ∧ IsPGroup 2 (G ⧸ N) ∧ g ∉ N

/-! ## Unconditional results -/

/-- **Paper, Theorem 6.6.** If `G/γ₂(G)` is finite of exponent 3, then `D₅(G) = γ₅(G)`.
No hypotheses: the inclusion part of Tahara's Theorem 6.1 (1981), on which the proof rests, is
formalized in the development. -/
theorem D_five_eq_gamma_five_of_exp_three (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1)) (h1 : ∀ x : G, x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    DSet 5 G = ((⊤ : Subgroup G).lowerCentralSeries 4 : Set G) := by
  sorry

/-- **Paper, Theorem 6.8.** If `G/γ₂(G)` is a finite 3-group whose cubes form a cyclic group
(equivalently `G/γ₂ ≅ C_{3^a} × C_3^{s-1}`), then `D₅(G) = γ₅(G)`. Here "the cubes form a cyclic
group" is stated as: there is `t ∈ G` such that every cube `x³` is congruent modulo `γ₂(G)`
to a power of `t³`. No hypotheses beyond these. -/
theorem D_five_eq_gamma_five_of_cubes_cyclic (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1) (t : G)
    (ht : ∀ x : G, ∃ n : ℕ, (t ^ (3 * n))⁻¹ * x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    DSet 5 G = ((⊤ : Subgroup G).lowerCentralSeries 4 : Set G) := by
  sorry

/-- **Jennings' inclusion, in the case used by the paper.** For a finite 2-group of class
`≤ 3`, `D₅(G) ⊆ M₅(G) = ∏_{i 2^j ≥ 5} γ_i(G)^{2^j}`. (This is the "hard" inclusion of Jennings'
theorem `G ∩ (1 + Δ_{𝔽₂}(G)^5) ⊆ M₅(G)`, applied to `D₅(G) ⊆ G ∩ (1 + Δ_{𝔽₂}(G)^5)`.) -/
theorem D_five_le_jennings {G : Type*} [Group G] [Finite G] (hG : IsPGroup 2 G)
    (h4 : (⊤ : Subgroup G).lowerCentralSeries 3 = ⊥) : DSet 5 G ⊆ (jennings 2 G 5 : Set G) := by
  sorry

/-- **Paper, Lemma 5.6.** No candidate of order `2^11` has `Q/P₃(Q) ≅ ℤ/4 × (ℤ/2)^7`.
The isomorphism `Q/P₃(Q) ≅ ℤ/4 × (ℤ/2)^7` is given as a surjective homomorphism
`f : Q → ℤ/4 × (ℤ/2)^7` with kernel `P₃(Q)` (this avoids a quotient-group instance in the
statement). `M₅` in `IsCandidate` is Jennings' formula. -/
theorem not_isCandidate_of_quotient_z4 {Q : Type*} [Group Q] (hcard : Nat.card Q = 2 ^ 11)
    (f : Q →* Z4Z2pow7) (hf : Function.Surjective f) (hker : f.ker = expCentral 2 Q 3)
    (n : Q) : ¬ IsCandidate Q n := by
  sorry

/-- **Paper, Proposition 5.7, the part proved in Lean:** every candidate has
`|P₂(Q)| = |Φ(Q)| ≥ 16`, i.e. no candidate has `|P₂(Q)| ≤ 8`. -/
theorem false_of_card_expCentral_two_le {Q : Type*} [Group Q] [Finite Q] {n : Q}
    (hQ : IsCandidate Q n) (hP2le : Nat.card (expCentral 2 Q 2) ≤ 8) : False := by
  sorry

/-- **Paper, Proposition 5.7, candidate form:** there is no candidate of order `2^11` and rank
`d(Q) ≥ 8`. (Proved without the classification of groups of order `2^9` and without a computer.) -/
theorem not_isCandidate_of_rank {Q : Type*} [Group Q] [Finite Q] (hcard : Nat.card Q = 2 ^ 11)
    (hrank : 8 ≤ Group.rank Q) (n : Q) : ¬ IsCandidate Q n := by
  sorry

/-! ## Conditional results (hypotheses as explicit arguments) -/

/-- **Paper, Proposition 2.1, (1) ⇔ (3), conditional.** *Assuming* `D₃ = γ₃`, Passi's
`D₄² ⊆ γ₄` and Gruenberg's theorem (the three explicit hypotheses), Problem 20.84 has a
positive answer if and only if `D₅(Q) = 1` for every finite 2-group `Q` of class exactly 3.
The paper's (3) also says "metabelian"; a group of class `≤ 3` is automatically metabelian
(`[γ₂, γ₂] ⊆ γ₄`, the paper's Remark 2.2, not formalized), so the word is omitted here. -/
theorem dimensionQuestion5_iff_class_three (hD3 : DThreeEqGammaThree) (hP : PassiDFourSquare)
    (hG : GruenbergResidualTwo) :
    DimensionQuestion5 ↔
      ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
        (⊤ : Subgroup Q).lowerCentralSeries 2 ≠ ⊥ → DSet 5 Q = {1} := by
  sorry

/-- **Paper, Lemma 5.2, conditional on `D₃ = γ₃`.** Let `Q` be a finite 2-group of class
exactly 3 with `D₅(Q) ≠ 1`, minimal in the sense that `D₅(Q/N) = 1` for every central subgroup
`N` of order 2. *Assuming* `D₃ = γ₃` (explicit hypothesis), `Q` is a candidate, with central
involution `n` generating `D₅(Q)`. -/
theorem isCandidate_of_minimal (hD3 : DThreeEqGammaThree) {Q : Type} [Group Q] [Finite Q]
    (hQ : IsPGroup 2 Q) (h4 : (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥) (h3 : (⊤ : Subgroup Q).lowerCentralSeries 2 ≠ ⊥)
    (hmin : ∀ N : Subgroup Q, ∀ _ : N.Normal, N ≤ Subgroup.center Q → Nat.card N = 2 →
      DSet 5 (Q ⧸ N) = {1})
    (hD : DSet 5 Q ≠ {1}) :
    ∃ n, IsCandidate Q n ∧ DSet 5 Q = (Subgroup.zpowers n : Set Q) := by
  sorry

/-- **Paper, Proposition 5.7, `D₅` form, conditional.** *Assuming* `D₃ = γ₃` and `h1024`: every
group of order `2^10` and class `≤ 3` has `D₅ = 1`. For class exactly 3 this is the paper's
Proposition 5.3 (proved there by computer plus paper argument, [computer + paper]); for class
`≤ 2` it follows from `D₃ = γ₃`. Conclusion: every group of order `2^11`, class `≤ 3` and rank
`≥ 8` has `D₅ = 1`. Both assumptions are explicit hypotheses. -/
theorem D_five_eq_bot_of_rank (hD3 : DThreeEqGammaThree)
    (h1024 : ∀ (R : Type) [Group R] [Finite R], Nat.card R = 2 ^ 10 →
      (⊤ : Subgroup R).lowerCentralSeries 3 = ⊥ → DSet 5 R = {1})
    {Q : Type} [Group Q] [Finite Q] (hcard : Nat.card Q = 2 ^ 11)
    (h4 : (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥) (hrank : 8 ≤ Group.rank Q) : DSet 5 Q = {1} := by
  sorry

end GroupDimension.Palomar
