theorem unreduced_ok_ok : checkStr unreduced_ok = true := by native_decide
theorem bad_fail : [ident, ident_a0, mods0, wrongpres, nonpc, nonpc2, swapC, negtok].all (checkStr · == false) = true := by native_decide
/-- Only faithfulness fails for the identity certificate. -/
theorem ident_parts : parts ident = (true, true, true, false) := by native_decide
theorem wrongpres_gen : (parts wrongpres).2.1 = false := by native_decide
theorem swapC_gen : (parts swapC).2.1 = false := by native_decide
theorem nonpc_format : (parts nonpc).1 = false := by native_decide

/-- `ℤ/4 = ⟨g_0, g_1⟩` with `g_1² = g_0`: the bit `0 < 1` is not of pc shape. -/
def z4 : PcPres := { pow := [0, 1], conj := [[2], []] }

def z4C : Fin 2 → Mat 2 := fun k =>
  if k.val = 0 then #v[#v[1, 2], #v[0, 1]] else #v[#v[1, 1], #v[0, 1]]

/-- Only `formatOK` fails. -/
theorem z4_parts : (formatOK 2 z4, (List.finRange 2).all (genOK 2 z4 (fun _ => 2) z4C),
    nilOK 2 (fun _ => 2) z4C, faithOK 2 (fun _ => 2) z4C) = (false, true, true, true) := by
  native_decide

