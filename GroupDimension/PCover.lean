module

public import GroupDimension.ClassFourOrder

@[expose] public section

/-!
# The `p`-covering group of a group of type `(·, 2, 1)` is metabelian (Theorem 6.10)

Let `p` be an odd prime and `P` a group of class `≤ 3` with `|γ₂(P)/γ₃(P)| = p²` and
`|γ₃(P)| = p`. The paper's Theorem 6.10 says `P*'' = 1` for the `p`-covering group
`P* = F/[R,F]R^p` of `P = F/R`. Mathlib has no `p`-covering group; we use only what the proof
uses: `P*` is a central extension of `P` by the multiplier `M = R/[R,F]R^p`, which is central and
of exponent `p`. So the formal statement is about every such extension:

* `metabelian_of_central_ext`: if `π : Q →* P` is onto and `ker π` is central and generated by
  each of its nontrivial elements, then `Q'' = 1`. This is the paper's proof: `Q'' ≤ ker π ∩ γ₄(Q)`;
  if this is not trivial, then `γ₄(Q) = ker π`, so `γ₅(Q) = 1`, `Q` has the factors
  `γ₂/γ₃`, `γ₃/γ₄` of `P`, and Lemma 6.3 (`commutator_gamma_two_le_gamma_five`) gives
  `Q'' ≤ γ₅(Q) = 1`. (The paper splits the first case into `z ∉ γ₂(Q)` and
  `z ∈ γ₂(Q) \ γ₄(Q)`; both are `ker π ∩ γ₄(Q) = 1`.)
* `metabelian_of_central_quotient`: the same for `P = Q/Z`, `Z` central of order `p`. These `Q`
  include all immediate descendants of step size `1` of `P` (`Z = P_c(Q)`).
* `metabelian_of_central_elementary` (**Theorem 6.10**): `Q/M` as above with `M` central of
  exponent `p` (for instance `Q = P*`) implies `Q'' = 1`. As in the paper, `Q'' ≤ M` and the
  subgroups `U` of index `p` in `M` intersect trivially; for each, `Q/U → Q/M` is an extension of
  the first kind.

No finiteness is assumed. Indexing as in `ClassFour`: `(⊤ : Subgroup G).lowerCentralSeries k` is
`γ_{k+1}(G)`.
-/

namespace GroupDimension

open Subgroup ClassFour
open scoped commutatorElement

variable {G : Type*} [Group G]

/-- `γ_{k+1}` of the image of a surjective homomorphism is the image of `γ_{k+1}`. -/
theorem lcs_map_of_surjective {P : Type*} [Group P] {π : G →* P} (hπ : Function.Surjective π)
    (k : ℕ) :
    ((⊤ : Subgroup G).lowerCentralSeries k).map π = (⊤ : Subgroup P).lowerCentralSeries k :=
  le_antisymm ((Subgroup.map_lowerCentralSeries ⊤ π k).le.trans (Subgroup.lowerCentralSeries_mono k le_top))
    (lowerCentralSeries_le_map_of_surjective π hπ k)

/-- If `|γ₂/γ₃| = p²`, then `γ₂/γ₃` is generated by (the images of) two elements. -/
theorem exists_two_gen_of_relIndex {p : ℕ} [Fact p.Prime]
    (h : ((⊤ : Subgroup G).lowerCentralSeries 2).relIndex ((⊤ : Subgroup G).lowerCentralSeries 1) = p ^ 2) :
    ∃ c₁ c₂ : G, c₁ ∈ (⊤ : Subgroup G).lowerCentralSeries 1 ∧ c₂ ∈ (⊤ : Subgroup G).lowerCentralSeries 1 ∧
      ∀ z ∈ (⊤ : Subgroup G).lowerCentralSeries 1, ∃ a b : ℤ,
        (c₁ ^ a * c₂ ^ b)⁻¹ * z ∈ (⊤ : Subgroup G).lowerCentralSeries 2 := by
  set K := (⊤ : Subgroup G).lowerCentralSeries 1
  set M := ((⊤ : Subgroup G).lowerCentralSeries 2).subgroupOf K
  have hKM : Nat.card (K ⧸ M) = p ^ 2 := h
  have : Finite (K ⧸ M) :=
    Nat.finite_of_card_ne_zero (by rw [hKM]; exact pow_ne_zero 2 (Fact.out : p.Prime).ne_zero)
  have hQ : IsPGroup p (K ⧸ M) := IsPGroup.of_card hKM
  obtain ⟨T, hT, hTc⟩ := exists_generators_card_le hQ (n := 2) hKM.le
  obtain ⟨t₁, t₂, hTt, -⟩ := exists_pair_of_card_le_two T hTc
  obtain ⟨k₁, rfl⟩ := QuotientGroup.mk_surjective t₁
  obtain ⟨k₂, rfl⟩ := QuotientGroup.mk_surjective t₂
  have hcl : closure ({(k₁ : K ⧸ M), (k₂ : K ⧸ M)} : Set (K ⧸ M)) = ⊤ :=
    top_le_iff.mp (hT ▸ closure_mono hTt)
  -- `γ₂/γ₃` is abelian
  have hab : Commute (k₁ : K ⧸ M) (k₂ : K ⧸ M) := by
    show ((k₁ * k₂ : K) : K ⧸ M) = ((k₂ * k₁ : K) : K ⧸ M)
    rw [QuotientGroup.eq, mem_subgroupOf]
    have e : (((k₁ * k₂ : K))⁻¹ * (k₂ * k₁) : K) = ⁅(k₂ : G)⁻¹, (k₁ : G)⁻¹⁆ := by
      simp only [commutatorElement_def, coe_mul, coe_inv]; group
    rw [e]
    exact commutator_mem_lcs (by norm_num) (mem_lcs_zero _) (inv_mem k₁.2)
  refine ⟨k₁, k₂, k₁.2, k₂.2, fun z hz => ?_⟩
  obtain ⟨a, b, hab'⟩ := mem_closure_pair_of_commute hab (hcl ▸ mem_top ((⟨z, hz⟩ : K) : K ⧸ M))
  refine ⟨a, b, ?_⟩
  rw [← QuotientGroup.mk_zpow, ← QuotientGroup.mk_zpow, ← QuotientGroup.mk_mul,
    QuotientGroup.eq, mem_subgroupOf] at hab'
  simpa using hab'

/-- `G'' ⊆ γ₄(G)`. -/
theorem derivedSeries_two_le_lcs_three :
    derivedSeries G 2 ≤ (⊤ : Subgroup G).lowerCentralSeries 3 :=
  commutator_lcs_le 1 1

/-- **Theorem 6.10, for an extension by a central subgroup of order `p`.** Let `p` be an odd
prime, `P` a group with `γ₄(P) = 1`, `|γ₂(P)/γ₃(P)| = p²` and `|γ₃(P)| = p`, and `π : Q →* P`
onto, with `ker π` central and generated by each of its nontrivial elements. Then `Q'' = 1`. -/
theorem metabelian_of_central_ext {Q P : Type*} [Group Q] [Group P] {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) {π : Q →* P} (hπ : Function.Surjective π) (hc : π.ker ≤ center Q)
    (hat : ∀ x ∈ π.ker, x ≠ 1 → π.ker ≤ zpowers x)
    (h4 : (⊤ : Subgroup P).lowerCentralSeries 3 = ⊥)
    (h2 : ((⊤ : Subgroup P).lowerCentralSeries 2).relIndex ((⊤ : Subgroup P).lowerCentralSeries 1) = p ^ 2)
    (h3 : Nat.card ((⊤ : Subgroup P).lowerCentralSeries 2) = p) :
    derivedSeries Q 2 = ⊥ := by
  have hmap := lcs_map_of_surjective hπ
  -- `Q'' ≤ ker π`, since `P'' ≤ γ₄(P) = 1`
  have hdk : derivedSeries Q 2 ≤ π.ker := by
    rw [← Subgroup.map_eq_bot_iff, eq_bot_iff, ← h4]
    exact (map_derivedSeries_le_derivedSeries π 2).trans derivedSeries_two_le_lcs_three
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot]
  by_contra hx1
  -- `ker π ∩ γ₄(Q) ∋ x ≠ 1`, hence `γ₄(Q) = ker π`
  have hk4 : π.ker ≤ (⊤ : Subgroup Q).lowerCentralSeries 3 :=
    (hat x (hdk hx) hx1).trans (zpowers_le.mpr (derivedSeries_two_le_lcs_three hx))
  have h4k : (⊤ : Subgroup Q).lowerCentralSeries 3 ≤ π.ker := by
    rw [← Subgroup.map_eq_bot_iff, hmap 3, h4]
  have heq : (⊤ : Subgroup Q).lowerCentralSeries 3 = π.ker := le_antisymm h4k hk4
  -- `γ₅(Q) = [ker π, Q] = 1`
  have h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥ := by
    rw [eq_bot_iff]
    show ⁅(⊤ : Subgroup Q).lowerCentralSeries 3, ⊤⁆ ≤ ⊥
    rw [commutator_le]
    intro a ha b _
    rw [mem_bot, commutatorElement_eq_one_iff_mul_comm]
    exact (mem_center_iff.mp (hc (heq ▸ ha)) b).symm
  -- `|γ₃(Q)/γ₄(Q)| = |γ₃(P)| = p`
  have hr3 : ((⊤ : Subgroup Q).lowerCentralSeries 3).relIndex ((⊤ : Subgroup Q).lowerCentralSeries 2) = p := by
    rw [heq, ← MonoidHom.comap_bot, relIndex_comap, hmap 2, relIndex_bot_left, h3]
  -- `γ₂(Q)/γ₃(Q) = γ₂(P)/γ₃(P)` has two generators
  have hmem2 : ∀ y : Q, π y ∈ (⊤ : Subgroup P).lowerCentralSeries 2 → y ∈ (⊤ : Subgroup Q).lowerCentralSeries 2 := by
    intro y hy
    rw [← hmap 2] at hy
    obtain ⟨y', hy', he⟩ := hy
    have hk : y'⁻¹ * y ∈ (⊤ : Subgroup Q).lowerCentralSeries 2 := by
      refine lcs_mem_of_le (by norm_num : 2 ≤ 3) (heq ▸ ?_)
      rw [MonoidHom.mem_ker, map_mul, map_inv, he, inv_mul_cancel]
    simpa using mul_mem hy' hk
  obtain ⟨c₁, c₂, hc₁, hc₂, hcg⟩ := exists_two_gen_of_relIndex h2
  obtain ⟨d₁, hd₁, rfl⟩ : c₁ ∈ ((⊤ : Subgroup Q).lowerCentralSeries 1).map π := hmap 1 ▸ hc₁
  obtain ⟨d₂, hd₂, rfl⟩ : c₂ ∈ ((⊤ : Subgroup Q).lowerCentralSeries 1).map π := hmap 1 ▸ hc₂
  have key := commutator_gamma_two_le_gamma_five hp2 hr3 hd₁ hd₂ (fun z hz => by
    obtain ⟨a, b, hab⟩ := hcg (π z) (hmap 1 ▸ mem_map_of_mem π hz)
    exact ⟨a, b, hmem2 _ (by simpa only [map_mul, map_inv, map_zpow] using hab)⟩)
  rw [h5] at key
  exact hx1 (mem_bot.mp (key hx))

/-- **Theorem 6.10, `|ker π| = p`.** The same with `ker π` central of order `p`. -/
theorem metabelian_of_central_ext_card {Q P : Type*} [Group Q] [Group P] {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) {π : Q →* P} (hπ : Function.Surjective π) (hc : π.ker ≤ center Q)
    (hcard : Nat.card π.ker = p)
    (h4 : (⊤ : Subgroup P).lowerCentralSeries 3 = ⊥)
    (h2 : ((⊤ : Subgroup P).lowerCentralSeries 2).relIndex ((⊤ : Subgroup P).lowerCentralSeries 1) = p ^ 2)
    (h3 : Nat.card ((⊤ : Subgroup P).lowerCentralSeries 2) = p) :
    derivedSeries Q 2 = ⊥ := by
  refine metabelian_of_central_ext hp2 hπ hc (fun x hx hx1 y hy => ?_) h4 h2 h3
  have htop : zpowers (⟨x, hx⟩ : π.ker) = ⊤ :=
    zpowers_eq_top_of_prime_card hcard (fun h => hx1 (congrArg Subtype.val h))
  obtain ⟨k, hk⟩ := mem_zpowers_iff.mp (htop ▸ mem_top (⟨y, hy⟩ : π.ker))
  exact mem_zpowers_iff.mpr ⟨k, by simpa using congrArg Subtype.val hk⟩

/-- **Theorem 6.10 for the immediate descendants of step size `1`.** Let `p` be an odd prime and
`Z` a central subgroup of order `p` of a group `Q` such that `P = Q/Z` has `γ₄(P) = 1`,
`|γ₂(P)/γ₃(P)| = p²` and `|γ₃(P)| = p`. Then `Q'' = 1`. -/
theorem metabelian_of_central_quotient {Q : Type*} [Group Q] {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    (Z : Subgroup Q) [Z.Normal] (hZ : Z ≤ center Q) (hcard : Nat.card Z = p)
    (h4 : (⊤ : Subgroup (Q ⧸ Z)).lowerCentralSeries 3 = ⊥)
    (h2 : ((⊤ : Subgroup (Q ⧸ Z)).lowerCentralSeries 2).relIndex ((⊤ : Subgroup (Q ⧸ Z)).lowerCentralSeries 1) = p ^ 2)
    (h3 : Nat.card ((⊤ : Subgroup (Q ⧸ Z)).lowerCentralSeries 2) = p) :
    derivedSeries Q 2 = ⊥ :=
  metabelian_of_central_ext_card hp2 (QuotientGroup.mk'_surjective Z)
    (by rwa [QuotientGroup.ker_mk']) (by rwa [QuotientGroup.ker_mk']) h4 h2 h3

/-- **Theorem 6.10.** Let `p` be an odd prime and `M` a central subgroup of exponent `p` of a
group `Q` such that `P = Q/M` has `γ₄(P) = 1`, `|γ₂(P)/γ₃(P)| = p²` and `|γ₃(P)| = p`. Then
`Q'' = 1`. For the `p`-covering group `Q = P*` and its multiplier `M` this is `P*'' = 1`. -/
theorem metabelian_of_central_elementary {Q : Type*} [Group Q] {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    (M : Subgroup Q) [M.Normal] (hM : M ≤ center Q) (hexp : ∀ m ∈ M, m ^ p = 1)
    (h4 : (⊤ : Subgroup (Q ⧸ M)).lowerCentralSeries 3 = ⊥)
    (h2 : ((⊤ : Subgroup (Q ⧸ M)).lowerCentralSeries 2).relIndex ((⊤ : Subgroup (Q ⧸ M)).lowerCentralSeries 1) = p ^ 2)
    (h3 : Nat.card ((⊤ : Subgroup (Q ⧸ M)).lowerCentralSeries 2) = p) :
    derivedSeries Q 2 = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot]
  by_contra hx1
  -- `Q'' ≤ M`
  have hdM : derivedSeries Q 2 ≤ M := by
    have := (map_derivedSeries_le_derivedSeries (QuotientGroup.mk' M) 2).trans
      (show derivedSeries (Q ⧸ M) 2 ≤ ⊥ from h4 ▸ derivedSeries_two_le_lcs_three)
    rwa [le_bot_iff, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
  -- a functional `F : M → 𝔽_p` with `F x ≠ 0`, and its kernel `U`, of index `p` in `M`
  obtain ⟨F, hF, hFx⟩ := exists_F M (fun a _ b hb => mem_center_iff.mp (hM hb) a) hexp (hdM hx) hx1
  let U : Subgroup Q :=
    { carrier := {a | a ∈ M ∧ F a = 0}
      mul_mem' := fun {a b} ha hb => ⟨mul_mem ha.1 hb.1, by rw [hF _ ha.1 _ hb.1, ha.2, hb.2, add_zero]⟩
      one_mem' := ⟨one_mem M, addMap_one hF⟩
      inv_mem' := fun {a} ha => ⟨inv_mem ha.1, by rw [addMap_inv hF ha.1, ha.2, neg_zero]⟩ }
  have hUM : U ≤ M := fun a ha => ha.1
  have : U.Normal := ⟨fun a ha g => by rw [mem_center_iff.mp (hM ha.1) g, mul_inv_cancel_right]; exact ha⟩
  -- `π : Q/U → Q/M`, with kernel `M/U` central of order `p`
  let π : Q ⧸ U →* Q ⧸ M := QuotientGroup.map U M (MonoidHom.id Q) (fun a ha => hUM ha)
  have hπmk : ∀ g : Q, π (g : Q ⧸ U) = (g : Q ⧸ M) := fun _ => rfl
  have hπs : Function.Surjective π := fun q => by
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    exact ⟨g, hπmk g⟩
  have hker : ∀ g : Q, (g : Q ⧸ U) ∈ π.ker ↔ g ∈ M := fun g => by
    rw [MonoidHom.mem_ker, hπmk, QuotientGroup.eq_one_iff]
  have key : derivedSeries (Q ⧸ U) 2 = ⊥ := by
    refine metabelian_of_central_ext hp2 hπs ?_ ?_ h4 h2 h3
    · intro y hy
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
      rw [hker] at hy
      rw [mem_center_iff]
      intro q
      obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective q
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, mem_center_iff.mp (hM hy) h]
    · intro y hy hy1 y' hy'
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
      obtain ⟨g', rfl⟩ := QuotientGroup.mk_surjective y'
      rw [hker] at hy hy'
      have hFg : F g ≠ 0 := fun h0 => hy1 ((QuotientGroup.eq_one_iff g).mpr ⟨hy, h0⟩)
      set k : ℕ := (F g' / F g).val
      have hk : F (g ^ k) = F g' := by
        rw [addMap_pow hF hy k, ZMod.natCast_zmod_val, div_mul_cancel₀ _ hFg]
      have hU : (g ^ k)⁻¹ * g' ∈ U :=
        ⟨mul_mem (inv_mem (pow_mem hy k)) hy', by
          rw [hF _ (inv_mem (pow_mem hy k)) _ hy', addMap_inv hF (pow_mem hy k), hk, neg_add_cancel]⟩
      refine mem_zpowers_iff.mpr ⟨k, ?_⟩
      rw [zpow_natCast, ← QuotientGroup.mk_pow, QuotientGroup.eq]
      exact hU
  -- `Q'' ≤ U`, so `F x = 0`
  have hdU : derivedSeries Q 2 ≤ U := by
    have := (map_derivedSeries_le_derivedSeries (QuotientGroup.mk' U) 2).trans key.le
    rwa [le_bot_iff, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
  exact hFx (hdU hx).2

end GroupDimension
