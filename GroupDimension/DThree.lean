module

public import GroupDimension.TaharaProof.TFrame
public import GroupDimension.FiniteReduction
public import GroupDimension.PCover

@[expose] public section

/-!
# `D₃(G) = γ₃(G)` for every group (Higman–Rees–Passi)

`dThreeEqGammaThree : DThreeEqGammaThree` proves the statement that `Statements.lean` records,
and which was an explicit hypothesis of Proposition 2.1, Lemma 5.2, Proposition 5.7 and
`prop_1024`.

**Finite groups.** A finite group of class `≤ 2` has a frame: uniqueness bases of `γ₁/γ₂` and
`γ₂/γ₃` (`exists_layerNF`, from the structure of finite abelian groups) glued by `TailFrame.glue`.
The Tahara part of the development proves `D₃ ⊆ γ₃` for every finite group with a frame
(`Frame.D_three_le`, [Tah81, Thm 4.1]), so `D₃ = 1` (`D_three_eq_bot_of_finite`).

**All groups.** It suffices that `D₃(H) = 1` for `H = G/γ₃(G)`, of class `≤ 2`. An element of
`D₃(H)` lies in `D₃(K)` for a finitely generated `K ≤ H` (`exists_closure_finset_mem_D`), and
`D₃(K) ⊆ D₂(K) = γ₂(K)`. A finitely generated group `K` of class `≤ 2` is residually finite on
`γ₂(K)` (`exists_finite_quotient_ne_one`): for `c ∈ γ₂(K)`, `c ≠ 1`,
* `γ₂(K)` is a finitely generated abelian group (generated by the commutators of generators),
  so `c` is not an `m₁`-th power in `γ₂(K)` for some `m₁` (structure theorem); dividing by the
  central subgroup `L` of `m₁`-th powers of `γ₂(K)` makes `γ₂` finite, of order `e`;
* with `t` killing the torsion of the abelianization, `x ↦ x^m` for `m = 2 e² t` is a
  homomorphism onto a central subgroup `S` with `S ∩ γ₂ = 1`, and `K/LS` is finite.
So `c` survives in a finite group of class `≤ 2`, whose `D₃` is trivial.
-/

namespace GroupDimension

open Subgroup
open scoped commutatorElement

/-! ## Finitely generated abelian groups -/

section FGAbelian

open DirectSum in
/-- In `ℤⁿ × ⨁ ℤ/p_i^{e_i}`, `t = ∏ p_i^{e_i}` kills the torsion part. -/
private theorem smul_prod_eq_zero {ι : Type} [Fintype ι] {p : ι → ℕ} {e : ι → ℕ}
    (w : ⨁ i : ι, ZMod (p i ^ e i)) : (∏ i, p i ^ e i) • w = 0 := by
  classical
  ext i
  rw [DFinsupp.smul_apply, DFinsupp.zero_apply, nsmul_eq_mul]
  have : ((∏ j, p j ^ e j : ℕ) : ZMod (p i ^ e i)) = 0 :=
    (CharP.cast_eq_zero_iff (ZMod (p i ^ e i)) (p i ^ e i) _).mpr
      (Finset.dvd_prod_of_mem _ (Finset.mem_univ i))
  rw [this, zero_mul]

private theorem finsupp_eq_zero_of_nsmul {n k : ℕ} (hk : 1 ≤ k) {f : Fin n →₀ ℤ} (h : k • f = 0) :
    f = 0 := by
  ext j
  have := congrArg (fun g => g j) h
  simp only [Finsupp.smul_apply, Finsupp.coe_zero, Pi.zero_apply, nsmul_eq_mul] at this
  rcases mul_eq_zero.mp this with h0 | h0
  · exact absurd (by exact_mod_cast h0 : k = 0) (by omega)
  · simpa using h0

variable {A : Type*} [AddCommGroup A] [AddGroup.FG A]

/-- Some `t ≥ 1` kills every element of finite order of a finitely generated abelian group. -/
theorem AddCommGroup.exists_nsmul_torsion :
    ∃ t ≥ 1, ∀ a : A, IsOfFinAddOrder a → t • a = 0 := by
  obtain ⟨n, ι, _, p, hp, e, ⟨E⟩⟩ := AddCommGroup.equiv_free_prod_directSum_zmod A
  refine ⟨∏ i, p i ^ e i, Nat.one_le_iff_ne_zero.mpr
    (Finset.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (hp i).ne_zero), fun a ha => ?_⟩
  obtain ⟨k, hk, hka⟩ := (isOfFinAddOrder_iff_nsmul_eq_zero).mp ha
  have h1 : (E a).1 = 0 := finsupp_eq_zero_of_nsmul hk (by
    have := congrArg (fun x => (E x).1) hka
    simpa only [map_nsmul, Prod.smul_fst, map_zero, Prod.fst_zero] using this)
  apply E.injective
  rw [map_nsmul, map_zero]
  ext1
  · rw [Prod.smul_fst, h1, smul_zero, Prod.fst_zero]
  · rw [Prod.smul_snd, smul_prod_eq_zero, Prod.snd_zero]

/-- A nonzero element of a finitely generated abelian group is not an `m`-multiple, for some
`m ≥ 1`. -/
theorem AddCommGroup.exists_not_nsmul {a : A} (ha : a ≠ 0) :
    ∃ m ≥ 1, ∀ b : A, m • b ≠ a := by
  obtain ⟨n, ι, _, p, hp, e, ⟨E⟩⟩ := AddCommGroup.equiv_free_prod_directSum_zmod A
  by_cases h1 : (E a).1 = 0
  · -- `a` is torsion: `t = ∏ p_i^{e_i}` multiples have zero torsion part
    refine ⟨∏ i, p i ^ e i, Nat.one_le_iff_ne_zero.mpr
      (Finset.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (hp i).ne_zero), fun b hb => ha ?_⟩
    apply E.injective
    rw [map_zero]
    ext1
    · rw [h1, Prod.fst_zero]
    · rw [← hb, map_nsmul, Prod.smul_snd, smul_prod_eq_zero, Prod.snd_zero]
  · obtain ⟨j, hj⟩ : ∃ j, (E a).1 j ≠ 0 := by
      by_contra h
      push Not at h
      exact h1 (Finsupp.ext h)
    refine ⟨((E a).1 j).natAbs + 1, by omega, fun b hb => ?_⟩
    have := congrArg (fun x => (E x).1 j) hb
    simp only [map_nsmul, Prod.smul_fst, Finsupp.smul_apply, nsmul_eq_mul] at this
    have hdvd := Int.natAbs_le_of_dvd_ne_zero (Dvd.intro _ this) hj
    rw [Int.natAbs_natCast] at hdvd
    omega

/-- A finitely generated abelian group of finite exponent is finite. -/
theorem AddCommGroup.finite_of_nsmul {m : ℕ} (hm : 1 ≤ m) (h : ∀ a : A, m • a = 0) : Finite A := by
  have : Module.Finite ℤ A := Module.Finite.iff_addGroup_fg.mpr inferInstance
  refine Module.finite_of_fg_torsion A (isAddTorsion_iff_isTorsion_int.mp fun a => ?_)
  exact (isOfFinAddOrder_iff_nsmul_eq_zero).mpr ⟨m, hm, h a⟩

end FGAbelian

section FGComm

variable {A : Type*} [CommGroup A] [Group.FG A]

theorem CommGroup.exists_pow_torsion : ∃ t ≥ 1, ∀ a : A, IsOfFinOrder a → a ^ t = 1 := by
  have : AddGroup.FG (Additive A) := GroupFG.iff_add_fg.mp inferInstance
  obtain ⟨t, ht, h⟩ := AddCommGroup.exists_nsmul_torsion (A := Additive A)
  exact ⟨t, ht, fun a ha => by
    have := h (Additive.ofMul a) (isOfFinAddOrder_ofMul_iff.mpr ha)
    rwa [← ofMul_pow, ← ofMul_one, Additive.ofMul.injective.eq_iff] at this⟩

theorem CommGroup.exists_not_pow {a : A} (ha : a ≠ 1) : ∃ m ≥ 1, ∀ b : A, b ^ m ≠ a := by
  have : AddGroup.FG (Additive A) := GroupFG.iff_add_fg.mp inferInstance
  obtain ⟨m, hm, h⟩ := AddCommGroup.exists_not_nsmul (A := Additive A)
    (a := Additive.ofMul a) (by rwa [ne_eq, ← ofMul_one, Additive.ofMul.injective.eq_iff])
  exact ⟨m, hm, fun b hb => h (Additive.ofMul b) (by rw [← ofMul_pow, hb])⟩

theorem CommGroup.finite_of_pow {m : ℕ} (hm : 1 ≤ m) (h : ∀ a : A, a ^ m = 1) : Finite A := by
  have : AddGroup.FG (Additive A) := GroupFG.iff_add_fg.mp inferInstance
  have := AddCommGroup.finite_of_nsmul (A := Additive A) hm fun a => by
    rw [← ofMul_toMul a, ← ofMul_pow, h, ofMul_one]
  exact Finite.of_equiv _ Additive.toMul

end FGComm

/-! ## Finite groups -/

section Finite

variable {G : Type*} [Group G]

open TaharaProof ExpThree Tahara ClassFour in
theorem exists_layerNF [Finite G] (k : ℕ) :
    ∃ (v : ℕ) (y : Fin v → G) (o : Fin v → ℕ), LayerNF k y o ∧ ∀ q, 1 < o q := by
  classical
  haveI : Finite (Additive (Layer G k)) := by
    unfold Layer; infer_instance
  obtain ⟨κ, _, n, hn, ⟨e⟩⟩ := AddCommGroup.equiv_directSum_zmod_of_finite' (Additive (Layer G k))
  let E : Additive (Layer G k) ≃+ ((i : κ) → ZMod (n i)) :=
    e.trans (DirectSum.linearEquivFunOnFintype ℤ κ fun i => ZMod (n i)).toAddEquiv
  obtain ⟨σ, -⟩ : ∃ σ : Fin (Fintype.card κ) ≃ κ, True := ⟨(Fintype.equivFin κ).symm, trivial⟩
  have hy : ∀ q : Fin (Fintype.card κ), ∃ g ∈ (⊤ : Subgroup G).lowerCentralSeries k,
      cl G k g = E.symm (Pi.single (σ q) 1) := fun q => cl_surj k _
  choose y hy1 hy2 using hy
  have hcl : ∀ a : Fin (Fintype.card κ) → ℤ,
      E (cl G k (oprod y a)) = fun i => ((a (σ.symm i) : ℤ) : ZMod (n i)) := by
    intro a
    rw [cl_oprod hy1, map_sum]
    funext i
    obtain ⟨q0, rfl⟩ := σ.surjective i
    simp only [map_zsmul, hy2, AddEquiv.apply_symm_apply, Finset.sum_apply, Pi.smul_apply,
      Equiv.symm_apply_apply]
    rw [Finset.sum_eq_single q0]
    · simp
    · intro q _ hq
      have : σ q ≠ σ q0 := fun h => hq (σ.injective h)
      simp [Pi.single_eq_of_ne' this]
    · simp
  refine ⟨Fintype.card κ, y, fun q => n (σ q), ⟨hy1, fun q => lt_trans zero_lt_one (hn _), ?_, ?_⟩,
    fun q => hn _⟩
  · intro a
    rw [← cl_eq_zero_iff (ExpThree.oprod_mem hy1 a), ← E.map_eq_zero_iff, hcl]
    constructor
    · intro h q
      have := congrFun h (σ q)
      simp only [Equiv.symm_apply_apply, Pi.zero_apply] at this
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    · intro h
      funext i
      simp only [Pi.zero_apply]
      have := h (σ.symm i)
      rw [Equiv.apply_symm_apply] at this
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr this
  · intro g hg
    refine ⟨fun q => ((E (cl G k g) (σ q)).val : ℤ), ?_⟩
    have hm := ExpThree.oprod_mem hy1 (fun q => ((E (cl G k g) (σ q)).val : ℤ))
    rw [← cl_eq_zero_iff (mul_mem (inv_mem hm) hg), cl_mul (inv_mem hm) hg, cl_inv hm,
      neg_add_eq_zero]
    apply E.injective
    rw [hcl]
    funext i
    obtain ⟨q, rfl⟩ := σ.surjective i
    rw [Equiv.symm_apply_apply]
    haveI : NeZero (n (σ q)) := ⟨(lt_trans zero_lt_one (hn _)).ne'⟩
    rw [Int.cast_natCast, ZMod.natCast_zmod_val]

open TaharaProof in
/-- A finite group of class `≤ 2` has `D₃ = 1`: it has a frame, and `D₃ ⊆ γ₃ = 1`
(`Frame.D_three_le`). -/
theorem D_three_eq_bot_of_class_two [Finite G] (h3 : (⊤ : Subgroup G).lowerCentralSeries 2 = ⊥) :
    D 3 G = ⊥ := by
  classical
  letI := Fintype.ofFinite G
  obtain ⟨n0, y0, o0, hy0, -⟩ := exists_layerNF (G := G) 0
  obtain ⟨n1, y1, o1, hy1, -⟩ := exists_layerNF (G := G) 1
  let F : Frame G (Fin n0 ⊕ₗ (Fin n1 ⊕ₗ Fin 0)) :=
    (TailFrame.glue (k := 0) hy0 <| TailFrame.glue (k := 1) hy1 <| TailFrame.empty 2 h3).toFrame
  rw [eq_bot_iff, ← h3]
  exact F.D_three_le

/-- **`D₃(G) = γ₃(G)` for finite groups.** -/
theorem D_three_eq_of_finite [Finite G] : D 3 G = (⊤ : Subgroup G).lowerCentralSeries 2 := by
  refine le_antisymm (D_le_of_D_quotient_eq_bot _ 3 (D_three_eq_bot_of_class_two
    (lowerCentralSeries_quotient_eq_bot 2))) ?_
  simpa using lowerCentralSeries_le_D G 2

end Finite

/-! ## Groups of class `≤ 2` -/

section ClassTwo

universe u

variable {K : Type u} [Group K] (h3 : (⊤ : Subgroup K).lowerCentralSeries 2 = ⊥)
include h3

theorem mem_center_of_mem_lcs_one {c : K} (hc : c ∈ (⊤ : Subgroup K).lowerCentralSeries 1) :
    c ∈ center K := by
  rw [mem_center_iff]
  intro g
  have h := commutator_mem_lcs (G := K) (i := 0) (j := 1) (n := 2) (by norm_num) (mem_lcs_zero g) hc
  rw [h3] at h
  exact commutatorElement_eq_one_iff_mul_comm.mp h

theorem comm_mem_center (x y : K) : ⁅x, y⁆ ∈ center K :=
  mem_center_of_mem_lcs_one h3 (commutator_mem_lcs_one x y)

theorem comm_mul_left₂ (a b c : K) : ⁅a * b, c⁆ = ⁅a, c⁆ * ⁅b, c⁆ := by
  rw [comm_mul_left, mem_center_iff.mp (comm_mem_center h3 b c) a, mul_inv_cancel_right]
  exact mem_center_iff.mp (comm_mem_center h3 a c) _

theorem comm_mul_right₂ (a b c : K) : ⁅a, b * c⁆ = ⁅a, b⁆ * ⁅a, c⁆ := by
  rw [comm_mul_right, mem_center_iff.mp (comm_mem_center h3 a c) b, mul_inv_cancel_right]

theorem comm_inv_left₂ (a c : K) : ⁅a⁻¹, c⁆ = ⁅a, c⁆⁻¹ := by
  refine eq_inv_of_mul_eq_one_left ?_
  rw [← comm_mul_left₂ h3, inv_mul_cancel, commutatorElement_one_left]

theorem comm_inv_right₂ (a c : K) : ⁅a, c⁻¹⁆ = ⁅a, c⁆⁻¹ := by
  refine eq_inv_of_mul_eq_one_left ?_
  rw [← comm_mul_right₂ h3, inv_mul_cancel, commutatorElement_one_right]

/-- `γ₂` is generated by the commutators of generators. -/
theorem lcs_one_le_closure {S : Set K} (hS : closure S = ⊤) :
    (⊤ : Subgroup K).lowerCentralSeries 1 ≤ closure (Set.image2 (fun s t => ⁅s, t⁆) S S) := by
  set T := closure (Set.image2 (fun s t => ⁅s, t⁆) S S)
  have h1 : ∀ s ∈ S, ∀ x : K, ⁅x, s⁆ ∈ T := by
    intro s hs x
    have hx : x ∈ closure S := hS ▸ mem_top x
    induction hx using Subgroup.closure_induction with
    | mem y hy => exact subset_closure ⟨y, hy, s, hs, rfl⟩
    | one => rw [commutatorElement_one_left]; exact one_mem _
    | mul y z _ _ hy hz => rw [comm_mul_left₂ h3]; exact mul_mem hy hz
    | inv y _ hy => rw [comm_inv_left₂ h3]; exact inv_mem hy
  have h2 : ∀ x y : K, ⁅x, y⁆ ∈ T := by
    intro x y
    have hy : y ∈ closure S := hS ▸ mem_top y
    induction hy using Subgroup.closure_induction with
    | mem y hy => exact h1 y hy x
    | one => rw [commutatorElement_one_right]; exact one_mem _
    | mul y z _ _ hy hz => rw [comm_mul_right₂ h3]; exact mul_mem hy hz
    | inv y _ hy => rw [comm_inv_right₂ h3]; exact inv_mem hy
  show ⁅(⊤ : Subgroup K), ⊤⁆ ≤ T
  rw [commutator_le]
  intro x _ y _
  exact h2 x y

/-- `γ₂` of a finitely generated group of class `≤ 2` is finitely generated. -/
theorem fg_lcs_one [hK : Group.FG K] : Group.FG ((⊤ : Subgroup K).lowerCentralSeries 1) := by
  obtain ⟨S, hS, hSf⟩ := Group.fg_iff.mp hK
  have hT : (Set.image2 (fun s t => ⁅s, t⁆) S S).Finite := hSf.image2 _ hSf
  have heq : (⊤ : Subgroup K).lowerCentralSeries 1 = closure (Set.image2 (fun s t => ⁅s, t⁆) S S) :=
    le_antisymm (lcs_one_le_closure h3 hS)
      ((closure_le _).mpr (by rintro _ ⟨s, -, t, -, rfl⟩; exact commutator_mem_lcs_one s t))
  have hfg : ((⊤ : Subgroup K).lowerCentralSeries 1).FG := by
    rw [heq]; exact (Subgroup.fg_iff _).mpr ⟨_, rfl, hT⟩
  exact (Group.fg_iff_subgroup_fg _).mpr hfg

omit h3 in
/-- `y^n x = d^n x y^n` when `y x = d x y` with `d` central. -/
theorem pow_mul_of_central {d x y : K} (hd : ∀ g, Commute d g) (hyx : y * x = d * x * y) :
    ∀ n : ℕ, y ^ n * x = d ^ n * x * y ^ n
  | 0 => by simp
  | n + 1 => by
    calc y ^ (n + 1) * x = y ^ n * (y * x) := by rw [pow_succ, mul_assoc]
      _ = y ^ n * d * x * y := by rw [hyx]; simp only [mul_assoc]
      _ = d * (y ^ n * x) * y := by rw [← (hd (y ^ n)).eq]; simp only [mul_assoc]
      _ = d * (d ^ n * x * y ^ n) * y := by rw [pow_mul_of_central hd hyx n]
      _ = d ^ (n + 1) * x * y ^ (n + 1) := by rw [pow_succ', pow_succ]; simp only [mul_assoc]

omit h3 in
/-- `(xy)^n = x^n y^n d^{n(n-1)/2}` when `y x = d x y` with `d` central. -/
theorem mul_pow_of_central {d x y : K} (hd : ∀ g, Commute d g) (hyx : y * x = d * x * y) :
    ∀ n : ℕ, (x * y) ^ n = x ^ n * y ^ n * d ^ (n.choose 2)
  | 0 => by simp
  | n + 1 => by
    have hc : (n + 1).choose 2 = n.choose 2 + n := by
      rw [Nat.choose_succ_succ', Nat.choose_one_right, add_comm]
    calc (x * y) ^ (n + 1) = (x * y) ^ n * (x * y) := pow_succ _ _
      _ = x ^ n * y ^ n * d ^ n.choose 2 * (x * y) := by rw [mul_pow_of_central hd hyx n]
      _ = x ^ n * (y ^ n * x) * y * d ^ n.choose 2 := by
        rw [mul_assoc (x ^ n * y ^ n), ((hd _).pow_left _).eq]; simp only [mul_assoc]
      _ = x ^ n * d ^ n * x * y ^ n * y * d ^ n.choose 2 := by
        rw [pow_mul_of_central hd hyx n]; simp only [mul_assoc]
      _ = x ^ (n + 1) * y ^ (n + 1) * d ^ (n + 1).choose 2 := by
        have hcomm : ∀ (a b : K) (k : ℕ), a * d ^ k * b = a * b * d ^ k := fun a b k => by
          rw [mul_assoc, ((hd b).pow_left k).eq, ← mul_assoc]
        rw [hcomm (x ^ n) x n, hcomm (x ^ n * x) (y ^ n) n, hcomm (x ^ n * x * y ^ n) y n,
          mul_assoc _ (d ^ n), ← pow_add, hc, add_comm (n.choose 2) n, pow_succ x n, pow_succ y n,
          mul_assoc (x ^ n * x) (y ^ n) y]

/-- `x^m` is central and `x ↦ x^m` is multiplicative when `γ₂` has exponent dividing `e`, `e ∣ m`
and `e ∣ m(m-1)/2`. -/
theorem pow_central {e m : ℕ} (he : ∀ d ∈ (⊤ : Subgroup K).lowerCentralSeries 1, d ^ e = 1)
    (hm : e ∣ m) (x : K) : x ^ m ∈ center K := by
  rw [mem_center_iff]
  intro g
  have hd : ∀ h, Commute ⁅x, g⁆ h := fun h => (mem_center_iff.mp (comm_mem_center h3 x g) h).symm
  have hxg : x * g = ⁅x, g⁆ * g * x := by simp only [commutatorElement_def]; group
  have := pow_mul_of_central hd hxg m
  obtain ⟨k, rfl⟩ := hm
  rw [pow_mul ⁅x, g⁆, he _ (commutator_mem_lcs_one x g), one_pow, one_mul] at this
  exact this.symm

/-- The power map `x ↦ x^m` as a homomorphism. -/
noncomputable def powHom {e m : ℕ} (he : ∀ d ∈ (⊤ : Subgroup K).lowerCentralSeries 1, d ^ e = 1)
    (hm : e ∣ m.choose 2) : K →* K where
  toFun x := x ^ m
  map_one' := one_pow m
  map_mul' x y := by
    have hd : ∀ g, Commute ⁅y, x⁆ g := fun g => (mem_center_iff.mp (comm_mem_center h3 y x) g).symm
    have hyx : y * x = ⁅y, x⁆ * x * y := by simp only [commutatorElement_def]; group
    rw [mul_pow_of_central hd hyx m]
    obtain ⟨k, hk⟩ := hm
    rw [hk, pow_mul, he _ (commutator_mem_lcs_one y x), one_pow, mul_one]

/-- **Separation.** In a finitely generated group of class `≤ 2`, every `c ≠ 1` of `γ₂` survives
in a finite quotient. -/
theorem exists_finite_quotient_ne_one [Group.FG K] {c : K}
    (hc : c ∈ (⊤ : Subgroup K).lowerCentralSeries 1) (hc1 : c ≠ 1) :
    ∃ (Q : Type u) (_ : Group Q) (_ : Finite Q) (f : K →* Q), Function.Surjective f ∧ f c ≠ 1 := by
  classical
  set C := (⊤ : Subgroup K).lowerCentralSeries 1 with hCdef
  -- step 1: `c` is not an `m₁`-th power in the finitely generated abelian group `γ₂`
  letI : CommGroup C := ClassFour.commGroupOfComm C fun a _ b hb =>
    mem_center_iff.mp (mem_center_of_mem_lcs_one h3 hb) a
  haveI : Group.FG C := fg_lcs_one h3
  obtain ⟨m₁, hm₁, hsep⟩ := CommGroup.exists_not_pow (A := C) (a := ⟨c, hc⟩)
    (fun h => hc1 (congrArg Subtype.val h))
  let L : Subgroup K := ((powMonoidHom m₁ : C →* C).range).map C.subtype
  have hLC : L ≤ C := by rintro _ ⟨b, -, rfl⟩; exact b.2
  have hcL : c ∉ L := by
    rintro ⟨b, ⟨a, rfl⟩, hb⟩
    exact hsep a (Subtype.ext hb)
  have : L.Normal := ⟨fun a ha g => by
    rw [mem_center_iff.mp (mem_center_of_mem_lcs_one h3 (hLC ha)) g, mul_inv_cancel_right]; exact ha⟩
  -- step 2: `K₁ = K/L` has finite `γ₂`
  set π₁ := QuotientGroup.mk' L
  have hπ₁ : Function.Surjective π₁ := QuotientGroup.mk'_surjective L
  have h3₁ : (⊤ : Subgroup (K ⧸ L)).lowerCentralSeries 2 = ⊥ := by
    rw [← lcs_map_of_surjective hπ₁ 2, h3, Subgroup.map_bot]
  set C₁ := (⊤ : Subgroup (K ⧸ L)).lowerCentralSeries 1 with hC₁def
  have hpre : ∀ y ∈ C₁, ∃ b ∈ C, π₁ b = y := fun y hy => by
    rw [hC₁def, ← lcs_map_of_surjective hπ₁ 1] at hy; exact hy
  letI : CommGroup C₁ := ClassFour.commGroupOfComm C₁ fun a _ b hb =>
    mem_center_iff.mp (mem_center_of_mem_lcs_one h3₁ hb) a
  haveI : Group.FG C₁ := fg_lcs_one h3₁
  haveI hC₁fin : Finite C₁ := CommGroup.finite_of_pow (A := C₁) hm₁ fun y => by
    obtain ⟨b, hb, hby⟩ := hpre y y.2
    apply Subtype.ext
    rw [Subgroup.coe_pow, ← hby, ← map_pow, Subgroup.coe_one, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    exact ⟨(⟨b, hb⟩ : C) ^ m₁, ⟨⟨b, hb⟩, rfl⟩, rfl⟩
  set e := Nat.card C₁
  have he0 : 0 < e := Nat.card_pos
  have he : ∀ d ∈ C₁, d ^ e = 1 := fun d hd => by
    have : (⟨d, hd⟩ : C₁) ^ Nat.card C₁ = 1 := pow_card_eq_one'
    exact congrArg Subtype.val this
  -- step 3: the power map with `m = 2 e² t`
  have abfg : ∀ (X : Type u) [Group X] [Group.FG X], Group.FG (Abelianization X) := fun X _ _ =>
    Group.fg_of_surjective (f := Abelianization.of) fun q => by
      obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective q; exact ⟨a, rfl⟩
  haveI := abfg (K ⧸ L)
  obtain ⟨t, ht, htor⟩ := CommGroup.exists_pow_torsion (A := Abelianization (K ⧸ L))
  set m := 2 * e * e * t with hm
  have hm1 : 1 ≤ m := by
    rw [hm]; exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos two_pos he0) he0) ht
  have hchoose : e ∣ m.choose 2 := by
    rw [Nat.choose_two_right, show m = 2 * (e * e * t) by rw [hm]; ring, mul_assoc,
      Nat.mul_div_cancel_left _ two_pos]
    exact ((dvd_mul_right e e).mul_right t).mul_right _
  let P := powHom h3₁ he hchoose
  have hP : ∀ x, P x = x ^ m := fun _ => rfl
  let S : Subgroup (K ⧸ L) := P.range
  have hScent : S ≤ center (K ⧸ L) := by
    rintro _ ⟨x, rfl⟩
    rw [hP]
    exact pow_central h3₁ he ⟨2 * e * t, by rw [hm]; ring⟩ x
  have : S.Normal := ⟨fun a ha g => by
    rw [mem_center_iff.mp (hScent ha) g, mul_inv_cancel_right]; exact ha⟩
  -- `x^m ∈ γ₂ ⇒ x^m = 1`
  have hS2 : ∀ x : K ⧸ L, x ^ m ∈ C₁ → x ^ m = 1 := by
    intro x hx
    have h1 : Abelianization.of x ^ m = 1 := by
      rw [← map_pow, ← MonoidHom.mem_ker, Abelianization.ker_of]
      exact hx
    have h2 : Abelianization.of x ^ t = 1 :=
      htor _ ((isOfFinOrder_iff_pow_eq_one).mpr ⟨m, by omega, h1⟩)
    have h3' : x ^ t ∈ C₁ := by
      rw [← map_pow, ← MonoidHom.mem_ker, Abelianization.ker_of] at h2
      exact h2
    rw [show m = t * e * (2 * e) by rw [hm]; ring, pow_mul, pow_mul x t e, he _ h3', one_pow]
  -- `c₁ ∉ S`
  have hc₁ : π₁ c ∈ C₁ := by rw [hC₁def, ← lcs_map_of_surjective hπ₁ 1]; exact mem_map_of_mem _ hc
  have hc₁S : π₁ c ∉ S := by
    rintro ⟨x, hx⟩
    rw [hP] at hx
    have := hS2 x (hx ▸ hc₁)
    rw [this] at hx
    exact hcL ((QuotientGroup.eq_one_iff c).mp hx.symm)
  -- step 4: `K₂ = K₁/S` is finite
  set π₂ := QuotientGroup.mk' S
  have hπ₂ : Function.Surjective π₂ := QuotientGroup.mk'_surjective S
  have hfin2 : Finite ((⊤ : Subgroup ((K ⧸ L) ⧸ S)).lowerCentralSeries 1) := by
    rw [← lcs_map_of_surjective hπ₂ 1]
    have : ((C₁.map π₂ : Subgroup _) : Set ((K ⧸ L) ⧸ S)).Finite := by
      rw [Subgroup.coe_map]; exact (Set.toFinite (C₁ : Set (K ⧸ L))).image _
    exact this.to_subtype
  haveI := abfg ((K ⧸ L) ⧸ S)
  have hfinab : Finite (Abelianization ((K ⧸ L) ⧸ S)) := by
    refine CommGroup.finite_of_pow (A := Abelianization ((K ⧸ L) ⧸ S)) hm1 fun q => ?_
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨x, rfl⟩ := hπ₂ y
    show Abelianization.of (π₂ x) ^ m = 1
    have h1 : π₂ (P x) = 1 := (QuotientGroup.eq_one_iff (P x)).mpr (MonoidHom.mem_range.mpr ⟨x, rfl⟩)
    rw [← map_pow, ← map_pow, ← hP, h1, map_one]
  have hfin : Finite ((K ⧸ L) ⧸ S) := by
    have hcomm : commutator ((K ⧸ L) ⧸ S) = (⊤ : Subgroup ((K ⧸ L) ⧸ S)).lowerCentralSeries 1 := rfl
    have h1 : 0 < Nat.card (commutator ((K ⧸ L) ⧸ S)) := by
      rw [hcomm]; exact Nat.card_pos
    have h2 : 0 < (commutator ((K ⧸ L) ⧸ S)).index := Nat.card_pos (α := Abelianization ((K ⧸ L) ⧸ S))
    refine Nat.finite_of_card_ne_zero ?_
    rw [← (commutator ((K ⧸ L) ⧸ S)).card_mul_index]
    positivity
  refine ⟨(K ⧸ L) ⧸ S, inferInstance, hfin, π₂.comp π₁, hπ₂.comp hπ₁, fun h => hc₁S ?_⟩
  exact (QuotientGroup.eq_one_iff _).mp h

end ClassTwo

/-! ## All groups -/

/-- `D₃ = 1` for every group of class `≤ 2`. -/
theorem D_three_eq_bot_of_class_two' {H : Type*} [Group H]
    (h3 : (⊤ : Subgroup H).lowerCentralSeries 2 = ⊥) : D 3 H = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot]
  by_contra hx1
  obtain ⟨s, hs, hD⟩ := exists_closure_finset_mem_D hx
  haveI : Group.FG (closure (s : Set H)) := (Group.fg_iff_subgroup_fg _).mpr ((Subgroup.fg_iff _).mpr ⟨_, rfl, s.finite_toSet⟩)
  have hK3 : (⊤ : Subgroup (closure (s : Set H))).lowerCentralSeries 2 = ⊥ :=
    (Subgroup.map_eq_bot_iff_of_injective _ (closure (s : Set H)).subtype_injective).mp
      (le_bot_iff.mp (h3 ▸ ((Subgroup.map_lowerCentralSeries ⊤ (closure (s : Set H)).subtype 2).le.trans
        (Subgroup.lowerCentralSeries_mono 2 le_top))))
  have hc : (⟨x, hs⟩ : closure (s : Set H)) ∈ (⊤ : Subgroup (closure (s : Set H))).lowerCentralSeries 1 := by
    rw [← D_two]; exact D_antitone (by norm_num : 2 ≤ 3) hD
  obtain ⟨Q, _, _, f, hf, hfc⟩ := exists_finite_quotient_ne_one hK3 hc
    (fun h => hx1 (congrArg Subtype.val h))
  have hQ3 : (⊤ : Subgroup Q).lowerCentralSeries 2 = ⊥ := by
    rw [← lcs_map_of_surjective hf 2, hK3, Subgroup.map_bot]
  have := map_mem_D f hD
  rw [D_three_eq_bot_of_class_two hQ3, mem_bot] at this
  exact hfc this

/-- **`D₃(G) = γ₃(G)` for every group** (Higman–Rees–Passi), the statement `DThreeEqGammaThree`
of `Statements.lean`. -/
theorem dThreeEqGammaThree : DThreeEqGammaThree := by
  intro G _
  refine le_antisymm (D_le_of_D_quotient_eq_bot _ 3
    (D_three_eq_bot_of_class_two' (lowerCentralSeries_quotient_eq_bot 2))) ?_
  simpa using lowerCentralSeries_le_D G 2

end GroupDimension
