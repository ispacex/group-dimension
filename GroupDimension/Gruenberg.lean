module

public import GroupDimension.DThree
public import Mathlib.GroupTheory.ResiduallyFinite

@[expose] public section

/-!
# Gruenberg's theorem for `p = 2` (the hypothesis `GruenbergResidualTwo`)

`GruenbergResidualTwo` (`Statements.lean`) is the form of Gruenberg's theorem [Gru57] used in
Proposition 2.1 of the paper: in a finitely generated nilpotent group, an element none of whose
odd powers is trivial survives in some finite `2`-group quotient. It is proved here
(`gruenbergResidualTwo`), so Proposition 2.1 holds with Passi's theorem as its only hypothesis
(`DThreeCorollaries.lean`).

The proof is self-contained (Mathlib has little on finitely generated nilpotent groups). As in
`Statements.lean`, `γ_{k+1}` is `(⊤ : Subgroup G).lowerCentralSeries k`.

* **`γ_{k+2}` is finitely generated** (`fg_lowerCentralSeries`) when `G` is finitely generated
  and `γ_{k+3}(G) = 1`. If `S ⊆ γ_{k+1}` generates `γ_{k+1}` modulo `γ_{k+2}` and `X` generates
  `G`, then `γ_{k+2}` is generated by the commutators `⁅s, x⁆`, `s ∈ S`, `x ∈ X`: these commutators are
  central, so `⁅·, ·⁆ : γ_{k+1} × G → γ_{k+2}` is multiplicative in each argument.
* **Residual finiteness** (`residuallyFinite`), by induction on the class. For `γ_{k+3} = 1` and
  `g ≠ 1`, put `A = γ_{k+2}` (central, finitely generated abelian) and choose `B ≤ A` of finite
  index in `A` with `g ∉ B` (`B = A^m` by `CommGroup.exists_not_pow`; `B = A` if `g ∉ A`). The
  subgroup `U = {u | ⁅s, u⁆ ∈ B for s ∈ S}` has finite index, and `γ_{k+2}(U) ⊆ B`, so `U/B` has smaller
  class and the induction hypothesis applies to it.
* **Gruenberg**, by induction on the class again. If the image of `g` modulo the central
  `γ_{k+1}(G)` (with `γ_{k+2}(G) = 1`) has no trivial odd power, the induction hypothesis applies.
  Otherwise some odd power `h = g^m` is central with no trivial odd power; then `h ∉ ⟨h²⟩`, and
  residual finiteness of `G/⟨h²⟩` gives a finite nilpotent quotient in which `h` has order `2`.
  Its projection to the Sylow `2`-subgroup (`exists_sylow_two_proj`) keeps `h`, hence `g`.
-/

namespace GroupDimension

namespace Gruenberg

open Subgroup
open scoped commutatorElement

universe u

section Commutators

variable {G : Type*} [Group G]

theorem commutatorElement_mul_left {a b u : G} (h : ⁅b, u⁆ ∈ center G) :
    ⁅a * b, u⁆ = ⁅b, u⁆ * ⁅a, u⁆ := by
  calc ⁅a * b, u⁆ = (a * ⁅b, u⁆ * a⁻¹) * ⁅a, u⁆ := by simp only [commutatorElement_def]; group
    _ = ⁅b, u⁆ * ⁅a, u⁆ := by rw [mem_center_iff.mp h a, mul_inv_cancel_right]

theorem commutatorElement_mul_right {s y z : G} (h : ⁅s, z⁆ ∈ center G) :
    ⁅s, y * z⁆ = ⁅s, y⁆ * ⁅s, z⁆ := by
  calc ⁅s, y * z⁆ = ⁅s, y⁆ * (y * ⁅s, z⁆ * y⁻¹) := by simp only [commutatorElement_def]; group
    _ = ⁅s, y⁆ * ⁅s, z⁆ := by rw [mem_center_iff.mp h y, mul_inv_cancel_right]

variable {k : ℕ}

/-- With `γ_{k+3} = 1`, the term `γ_{k+2}` is central. -/
theorem lowerCentralSeries_le_center (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥) :
    (⊤ : Subgroup G).lowerCentralSeries (k + 1) ≤ center G :=
  commutator_top_right_eq_bot_iff_le_center.mp (by rw [← lowerCentralSeries_succ]; exact hk)

theorem commutatorElement_mem_lowerCentralSeries {a : G}
    (ha : a ∈ (⊤ : Subgroup G).lowerCentralSeries k) (y : G) :
    ⁅a, y⁆ ∈ (⊤ : Subgroup G).lowerCentralSeries (k + 1) := by
  rw [lowerCentralSeries_succ]
  exact commutator_mem_commutator ha (mem_top y)

/-- With `γ_{k+3} = 1` and `s ∈ γ_{k+1}`, `y ↦ ⁅s, y⁆` is a homomorphism into `γ_{k+2}`. -/
def commHom (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥) {s : G}
    (hs : s ∈ (⊤ : Subgroup G).lowerCentralSeries k) :
    G →* (⊤ : Subgroup G).lowerCentralSeries (k + 1) where
  toFun y := ⟨⁅s, y⁆, commutatorElement_mem_lowerCentralSeries hs y⟩
  map_one' := by ext; simp
  map_mul' y z := by
    ext
    exact commutatorElement_mul_right
      (lowerCentralSeries_le_center hk (commutatorElement_mem_lowerCentralSeries hs z))

@[simp]
theorem coe_commHom (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥) {s : G}
    (hs : s ∈ (⊤ : Subgroup G).lowerCentralSeries k) (y : G) :
    (commHom hk hs y : G) = ⁅s, y⁆ := rfl

/-- If `S ⊆ γ_{k+1}` generates `γ_{k+1}` modulo `γ_{k+2}`, `γ_{k+3} = 1` and `⁅s, u⁆ ∈ B` for
`s ∈ S`, then `⁅a, u⁆ ∈ B` for all `a ∈ γ_{k+1}`. -/
theorem commutatorElement_mem_of_gen (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥)
    {S : Set G} (hS : S ⊆ (⊤ : Subgroup G).lowerCentralSeries k)
    (hgen : (⊤ : Subgroup G).lowerCentralSeries k ≤
      closure S ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1))
    (B : Subgroup G) {u : G} (hu : ∀ s ∈ S, ⁅s, u⁆ ∈ B) {a : G}
    (ha : a ∈ (⊤ : Subgroup G).lowerCentralSeries k) : ⁅a, u⁆ ∈ B := by
  have hcen : ∀ b ∈ (⊤ : Subgroup G).lowerCentralSeries k, ⁅b, u⁆ ∈ center G := fun b hb =>
    lowerCentralSeries_le_center hk (commutatorElement_mem_lowerCentralSeries hb u)
  let T : Subgroup G :=
    { carrier := {a | a ∈ (⊤ : Subgroup G).lowerCentralSeries k ∧ ⁅a, u⁆ ∈ B}
      mul_mem' := fun {a b} ha hb => ⟨mul_mem ha.1 hb.1, by
        rw [commutatorElement_mul_left (hcen b hb.1)]; exact mul_mem hb.2 ha.2⟩
      one_mem' := ⟨one_mem _, by rw [commutatorElement_one_left]; exact one_mem _⟩
      inv_mem' := fun {a} ha => ⟨inv_mem ha.1, by
        have h := commutatorElement_mul_left (a := a⁻¹) (hcen a ha.1)
        rw [inv_mul_cancel, commutatorElement_one_left] at h
        rw [eq_inv_of_mul_eq_one_right h.symm]
        exact inv_mem ha.2⟩ }
  have hle : closure S ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1) ≤ T := by
    refine sup_le ((closure_le _).mpr fun s hs => ⟨hS hs, hu s hs⟩) fun z hz => ?_
    refine ⟨lowerCentralSeries_antitone _ (Nat.le_succ k) hz, ?_⟩
    have hz' := mem_center_iff.mp (lowerCentralSeries_le_center hk hz) u
    rw [commutatorElement_eq_one_iff_mul_comm.mpr hz'.symm]
    exact one_mem _
  exact (hle (hgen ha)).2

/-- The commutators `⁅s, x⁆`, `s ∈ S`, `x ∈ X`, generate `γ_{k+2}`. -/
theorem lowerCentralSeries_succ_eq_closure (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥)
    {S : Set G} (hS : S ⊆ (⊤ : Subgroup G).lowerCentralSeries k)
    (hgen : (⊤ : Subgroup G).lowerCentralSeries k ≤
      closure S ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1))
    {X : Set G} (hX : closure X = ⊤) :
    (⊤ : Subgroup G).lowerCentralSeries (k + 1) = closure (Set.image2 (⁅·, ·⁆) S X) := by
  refine le_antisymm ?_ ((closure_le _).mpr ?_)
  · rw [lowerCentralSeries_succ, commutator_le]
    intro a ha y _
    refine commutatorElement_mem_of_gen hk hS hgen _ (fun s hs => ?_) ha
    have hX' : closure X ≤ (closure (Set.image2 (⁅·, ·⁆) S X)).comap
        ((lowerCentralSeries ⊤ (k + 1)).subtype.comp (commHom hk (hS hs))) :=
      (closure_le _).mpr fun x hx => subset_closure (Set.mem_image2_of_mem hs hx)
    rw [hX] at hX'
    exact hX' (mem_top y)
  · rintro _ ⟨s, hs, x, -, rfl⟩
    exact commutatorElement_mem_lowerCentralSeries (hS hs) x

end Commutators

section FG

variable {G : Type*} [Group G] {k : ℕ}

/-- If `γ_{k+1}(G/γ_{k+2})` is finitely generated, a finite `S ⊆ γ_{k+1}(G)` generates `γ_{k+1}`
modulo `γ_{k+2}`. -/
theorem exists_finite_gen
    (h : ((⊤ : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries (k + 1))).lowerCentralSeries k).FG) :
    ∃ S : Set G, S.Finite ∧ S ⊆ (⊤ : Subgroup G).lowerCentralSeries k ∧
      (⊤ : Subgroup G).lowerCentralSeries k ≤
        closure S ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1) := by
  let π := QuotientGroup.mk' ((⊤ : Subgroup G).lowerCentralSeries (k + 1))
  have hmap : ((⊤ : Subgroup G).lowerCentralSeries k).map π =
      (⊤ : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries (k + 1))).lowerCentralSeries k :=
    lcs_map_of_surjective (QuotientGroup.mk'_surjective _) k
  obtain ⟨T, hT, hTf⟩ := (Subgroup.fg_iff _).mp h
  have hTsub : T ⊆ π '' ((⊤ : Subgroup G).lowerCentralSeries k) := by
    rw [← coe_map, hmap, ← hT]; exact subset_closure
  obtain ⟨S, hSsub, hSf, hST⟩ :=
    Set.exists_subset_image_finite_and.mp ⟨T, hTsub, hTf, rfl⟩
  refine ⟨S, hSf, hSsub, ?_⟩
  calc (⊤ : Subgroup G).lowerCentralSeries k
      ≤ (((⊤ : Subgroup G).lowerCentralSeries k).map π).comap π := le_comap_map _ _
    _ = ((closure S).map π).comap π := by rw [hmap, ← hT, hST, MonoidHom.map_closure]
    _ = closure S ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1) := by
      rw [comap_map_eq, QuotientGroup.ker_mk']

/-- In a finitely generated group with `γ_{k+2} = 1`, the term `γ_{k+1}` is finitely generated. -/
theorem fg_lowerCentralSeries :
    ∀ (k : ℕ) (G : Type u) [Group G] [Group.FG G],
      (⊤ : Subgroup G).lowerCentralSeries (k + 1) = ⊥ → ((⊤ : Subgroup G).lowerCentralSeries k).FG
  | 0, G, _, hG, _ => Group.fg_def.mp hG
  | k + 1, G, _, _, hk => by
    have hQ := fg_lowerCentralSeries k (G ⧸ (⊤ : Subgroup G).lowerCentralSeries (k + 1))
      (lowerCentralSeries_quotient_eq_bot (k + 1))
    obtain ⟨S, hSf, hS, hgen⟩ := exists_finite_gen hQ
    obtain ⟨X, hX, hXf⟩ := (Subgroup.fg_iff _).mp (Group.fg_def.mp ‹Group.FG G›)
    rw [Subgroup.fg_iff]
    exact ⟨_, (lowerCentralSeries_succ_eq_closure hk hS hgen hX).symm, hSf.image2 _ hXf⟩

end FG

section Abelian

/-- A finitely generated abelian group is residually finite. -/
theorem exists_finiteIndex_notMem_of_comm {H : Type*} [Group H] [Group.FG H]
    (hc : ∀ a b : H, a * b = b * a) {h : H} (hh : h ≠ 1) :
    ∃ K : Subgroup H, K.FiniteIndex ∧ h ∉ K := by
  let _ : CommGroup H := { ‹Group H› with mul_comm := hc }
  obtain ⟨m, hm1, hm⟩ := CommGroup.exists_not_pow (A := H) hh
  refine ⟨(powMonoidHom m : H →* H).range, ?_, ?_⟩
  · have : Finite (H ⧸ (powMonoidHom m : H →* H).range) :=
      CommGroup.finite_of_pow hm1 fun q => by
        induction q using QuotientGroup.induction_on with
        | H a =>
          rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
          exact ⟨a, rfl⟩
    exact finiteIndex_of_finite_quotient
  · rintro ⟨y, rfl⟩
    exact hm y rfl

end Abelian

section ResiduallyFinite

/-- The induction step for residual finiteness: from groups with `γ_{k+2} = 1` to groups with
`γ_{k+3} = 1`. -/
theorem residuallyFinite_step {k : ℕ}
    (ih : ∀ (Q : Type u) [Group Q] [Group.FG Q],
      (⊤ : Subgroup Q).lowerCentralSeries (k + 1) = ⊥ → Group.ResiduallyFinite Q)
    (G : Type u) [Group G] [Group.FG G] (hk : (⊤ : Subgroup G).lowerCentralSeries (k + 2) = ⊥) :
    Group.ResiduallyFinite G := by
  rw [Group.residuallyFinite_iff_exists_finiteIndex]
  intro g hg
  set A := (⊤ : Subgroup G).lowerCentralSeries (k + 1)
  have hAc := lowerCentralSeries_le_center hk
  -- `B ≤ A` of finite index in `A`, with `g ∉ B`
  obtain ⟨K, hK, hgK⟩ : ∃ K : Subgroup A, K.FiniteIndex ∧ ∀ hgA : g ∈ A, (⟨g, hgA⟩ : A) ∉ K := by
    by_cases hgA : g ∈ A
    · have : Group.FG A := fg_lowerCentralSeries (k + 1) G hk
      obtain ⟨K, hK, hgK⟩ := exists_finiteIndex_notMem_of_comm
        (fun a b => Subtype.ext (mem_center_iff.mp (hAc a.2) b).symm)
        (h := ⟨g, hgA⟩) (fun h1 => hg (congrArg Subtype.val h1))
      exact ⟨K, hK, fun _ => hgK⟩
    · exact ⟨⊤, inferInstance, fun h => (hgA h).elim⟩
  set B := K.map A.subtype
  have hBA : B ≤ A := map_subtype_le K
  have hBn : B.Normal := normal_of_le_center (hBA.trans hAc)
  have hgB : g ∉ B := by
    rintro ⟨x, hx, rfl⟩
    exact hgK x.2 hx
  -- generators of `γ_{k+1}` modulo `γ_{k+2}`
  obtain ⟨S, hSf, hS, hgen⟩ := exists_finite_gen (fg_lowerCentralSeries k
    (G ⧸ (⊤ : Subgroup G).lowerCentralSeries (k + 1)) (lowerCentralSeries_quotient_eq_bot (k + 1)))
  have : Finite S := hSf.to_subtype
  set U : Subgroup G := ⨅ s : S, K.comap (commHom hk (hS s.2))
  have hU : U.FiniteIndex := finiteIndex_iInf fun _ => inferInstance
  have hmemU : ∀ u ∈ U, ∀ s ∈ S, ⁅s, u⁆ ∈ B := fun u hu s hs =>
    ⟨_, (mem_iInf.mp hu ⟨s, hs⟩ : commHom hk (hS hs) u ∈ K), rfl⟩
  by_cases hgU : g ∉ U
  · exact ⟨U, hU, hgU⟩
  push Not at hgU
  -- `U / B` has `γ_{k+2} = 1`
  have : (B.subgroupOf U).Normal := hBn.subgroupOf U
  have hUB : (⊤ : Subgroup U).lowerCentralSeries (k + 1) ≤ B.subgroupOf U := by
    rw [lowerCentralSeries_succ, commutator_le]
    intro a ha u _
    have ha' : (a : G) ∈ (⊤ : Subgroup G).lowerCentralSeries k := by
      have : ((⊤ : Subgroup U).lowerCentralSeries k).map U.subtype ≤
          (⊤ : Subgroup G).lowerCentralSeries k := by
        rw [map_lowerCentralSeries]; exact lowerCentralSeries_mono k le_top
      exact this ⟨a, ha, rfl⟩
    rw [mem_subgroupOf]
    have hc := map_commutatorElement U.subtype a u
    simp only [coe_subtype] at hc
    rw [hc]
    exact commutatorElement_mem_of_gen hk hS hgen B (hmemU u u.2) ha'
  have hQ : (⊤ : Subgroup (U ⧸ B.subgroupOf U)).lowerCentralSeries (k + 1) = ⊥ := by
    refine le_bot_iff.mp ((lowerCentralSeries_le_map_of_surjective _
      (QuotientGroup.mk'_surjective _) (k + 1)).trans ?_)
    rw [map_le_iff_le_comap, MonoidHom.comap_bot, QuotientGroup.ker_mk']
    exact hUB
  have hq : (QuotientGroup.mk' (B.subgroupOf U) ⟨g, hgU⟩) ≠ 1 := by
    rw [QuotientGroup.mk'_apply, Ne, QuotientGroup.eq_one_iff, mem_subgroupOf]
    exact hgB
  have := ih _ hQ
  obtain ⟨V, hV, hqV⟩ := Group.residuallyFinite_iff_exists_finiteIndex.mp ‹_› _ hq
  set W := (V.comap (QuotientGroup.mk' (B.subgroupOf U))).map U.subtype
  have hV' : (V.comap (QuotientGroup.mk' (B.subgroupOf U))).FiniteIndex := inferInstance
  have hW : W.FiniteIndex := by
    constructor
    rw [index_map_subtype]
    exact mul_ne_zero hV'.index_ne_zero hU.index_ne_zero
  refine ⟨W, hW, ?_⟩
  rintro ⟨x, hx, hxg⟩
  obtain rfl : x = ⟨g, hgU⟩ := Subtype.ext hxg
  exact hqV hx

/-- **Finitely generated nilpotent groups are residually finite.** -/
theorem residuallyFinite_of_lowerCentralSeries :
    ∀ (k : ℕ) (G : Type u) [Group G] [Group.FG G],
      (⊤ : Subgroup G).lowerCentralSeries k = ⊥ → Group.ResiduallyFinite G
  | 0, G, _, _, h => by
    rw [Group.residuallyFinite_iff_exists_finiteIndex]
    intro g hg
    exact (hg ((Subgroup.mem_bot).mp (h ▸ mem_top g))).elim
  | 1, G, _, _, h => by
    rw [Group.residuallyFinite_iff_exists_finiteIndex]
    intro g hg
    have h' := h
    rw [lowerCentralSeries_succ, lowerCentralSeries_zero] at h'
    have hc : ⊤ ≤ center G := commutator_top_right_eq_bot_iff_le_center.mp h'
    exact exists_finiteIndex_notMem_of_comm (fun a b => (mem_center_iff.mp (hc (mem_top b)) a)) hg
  | k + 2, G, _, _, h => residuallyFinite_step (residuallyFinite_of_lowerCentralSeries (k + 1)) G h

/-- Finitely generated nilpotent groups are residually finite. -/
theorem residuallyFinite {G : Type u} [Group G] [Group.FG G] (hG : Group.IsNilpotent G) :
    Group.ResiduallyFinite G := by
  obtain ⟨k, hk⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp hG
  exact residuallyFinite_of_lowerCentralSeries k G hk

end ResiduallyFinite

section Gruenberg

theorem lowerCentralSeries_eq_bot_of_surjective {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Surjective f) {k : ℕ} (h : (⊤ : Subgroup G).lowerCentralSeries k = ⊥) :
    (⊤ : Subgroup H).lowerCentralSeries k = ⊥ := by
  rw [← lcs_map_of_surjective hf k, h, Subgroup.map_bot]

/-- The central case: a central `h` with no trivial odd power survives in a finite `2`-group. -/
theorem exists_hom_two_group_of_central {k : ℕ} {G : Type u} [Group G] [Group.FG G]
    (hk : (⊤ : Subgroup G).lowerCentralSeries k = ⊥) {h : G} (hc : h ∈ center G)
    (hodd : ∀ m : ℕ, Odd m → h ^ m ≠ 1) :
    ∃ (P : Type u) (_ : Group P) (_ : Finite P), IsPGroup 2 P ∧ ∃ f : G →* P, f h ≠ 1 := by
  set C := zpowers (h ^ 2)
  have : C.Normal := normal_of_le_center (zpowers_le.mpr (pow_mem hc 2))
  have hQ : (⊤ : Subgroup (G ⧸ C)).lowerCentralSeries k = ⊥ :=
    lowerCentralSeries_eq_bot_of_surjective _ (QuotientGroup.mk'_surjective C) hk
  have := residuallyFinite_of_lowerCentralSeries k (G ⧸ C) hQ
  have hh : (h : G ⧸ C) ≠ 1 := by
    rw [Ne, QuotientGroup.eq_one_iff]
    rintro ⟨z, hz⟩
    have hz' : (h ^ 2) ^ z = h := hz
    have h1 : h ^ (2 * z - 1) = 1 := by
      rw [zpow_sub_one, zpow_mul, zpow_ofNat, hz', mul_inv_cancel]
    exact hodd _ (Int.natAbs_odd.mpr ⟨z - 1, by ring⟩) (pow_natAbs_eq_one.mpr h1)
  obtain ⟨M, hM, hhM⟩ := Group.residuallyFinite_iff_exists_finiteIndex.mp ‹_› _ hh
  set F := (G ⧸ C) ⧸ M.normalCore
  let π : G →* F := (QuotientGroup.mk' M.normalCore).comp (QuotientGroup.mk' C)
  have hπ : Function.Surjective π :=
    (QuotientGroup.mk'_surjective _).comp (QuotientGroup.mk'_surjective _)
  have hF : Group.IsNilpotent F :=
    Subgroup.nilpotent_iff_lowerCentralSeries.mpr ⟨k, lowerCentralSeries_eq_bot_of_surjective π hπ hk⟩
  have hx2 : π h ^ 2 = 1 := by
    rw [← map_pow]
    simp only [π, MonoidHom.comp_apply, QuotientGroup.mk'_apply]
    rw [(QuotientGroup.eq_one_iff _).mpr (mem_zpowers (h ^ 2)), QuotientGroup.mk_one]
  have hx1 : π h ≠ 1 := by
    intro h'
    exact hhM (M.normalCore_le ((QuotientGroup.eq_one_iff (N := M.normalCore) (h : G ⧸ C)).mp h'))
  obtain ⟨P, σ, hσ⟩ := exists_sylow_two_proj hF hx2 hx1
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact ⟨P, inferInstance, inferInstance, P.isPGroup', σ.comp π, hσ⟩

/-- Gruenberg's theorem in homomorphism form, by induction on `k` with `γ_{k+1}(G) = 1`: an
element with no trivial odd power has nontrivial image in some finite `2`-group. -/
theorem exists_hom_two_group :
    ∀ (k : ℕ) (G : Type u) [Group G] [Group.FG G], (⊤ : Subgroup G).lowerCentralSeries k = ⊥ →
      ∀ g : G, (∀ m : ℕ, Odd m → g ^ m ≠ 1) →
        ∃ (P : Type u) (_ : Group P) (_ : Finite P), IsPGroup 2 P ∧ ∃ f : G →* P, f g ≠ 1
  | 0, G, _, _, h, g, hg => (hg 1 odd_one (by
      rw [pow_one]; exact (Subgroup.mem_bot).mp (h ▸ mem_top g))).elim
  | k + 1, G, _, _, hk, g, hg => by
    set A := (⊤ : Subgroup G).lowerCentralSeries k
    by_cases hodd : ∀ m : ℕ, Odd m → (g : G ⧸ A) ^ m ≠ 1
    · obtain ⟨P, _, _, hP, f, hf⟩ :=
        exists_hom_two_group k (G ⧸ A) (lowerCentralSeries_quotient_eq_bot k) g hodd
      exact ⟨P, inferInstance, inferInstance, hP, f.comp (QuotientGroup.mk' A), hf⟩
    · push Not at hodd
      obtain ⟨m, hm, hgm⟩ := hodd
      have hAc : A ≤ center G :=
        commutator_top_right_eq_bot_iff_le_center.mp (by rw [← lowerCentralSeries_succ]; exact hk)
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff] at hgm
      obtain ⟨P, _, _, hP, f, hf⟩ := exists_hom_two_group_of_central hk (hAc hgm)
        (fun j hj => by rw [← pow_mul]; exact hg _ (hm.mul hj))
      refine ⟨P, inferInstance, inferInstance, hP, f, fun h1 => hf ?_⟩
      rw [map_pow, h1, one_pow]

end Gruenberg

end Gruenberg

/-- **Gruenberg's theorem** [Gru57], in the form of Proposition 2.1 of the paper: in a finitely
generated nilpotent group, an element none of whose odd powers is trivial survives in some
finite `2`-group quotient. -/
theorem gruenbergResidualTwo : GruenbergResidualTwo := by
  intro G _ hfg hnil g hg
  obtain ⟨k, hk⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp hnil
  obtain ⟨P, _, _, hP, f, hf⟩ := Gruenberg.exists_hom_two_group k G hk g hg
  let e := QuotientGroup.quotientKerEquivRange f
  exact ⟨f.ker, inferInstance, Finite.of_equiv _ e.symm.toEquiv,
    (hP.to_subgroup f.range).of_equiv e.symm, by rwa [MonoidHom.mem_ker]⟩

end GroupDimension
