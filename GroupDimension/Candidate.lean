import Mathlib

/-!
# Candidates of order `2¹¹` with `Q/P₃ ≅ ℤ/4 × (ℤ/2)⁷` (Lemma 5.6)

Notation of §5 of the paper.

* `powSubgroup H m` is `H^m`, the subgroup generated by the `m`-th powers of elements of `H`.
* `expCentral p n G` is the lower exponent-`p` central series in the paper's numbering:
  `P₁ = G`, `P_{i+1} = [P_i, G] P_i^p` (and `P₀ = G`, as for `D`). For `p = 2` the `2`-class of
  `G` is the least `c` with `P_{c+1} = 1`.
* `jennings p n G` is `M_n(G) = ∏_{i p^j ≥ n} γ_i^{p^j}` (`i ≥ 1`, `j ≥ 0`), with `γ_i` Mathlib's
  `lowerCentralSeries G (i - 1)`. The paper defines `M_n(Q) = Q ∩ (1 + Δ_{𝔽₂}(Q)^n)` and quotes
  this product formula as a theorem (Jennings [Jen41], Lazard [Laz54]); here the formula is the
  definition, and Jennings' theorem is **not** formalized.
* `IsCandidate Q n`: `Q` is a `2`-group of class `3` with cyclic centre whose involution `n` lies
  in `γ₃(Q) ∩ M₅(Q)`, of `2`-class `c ≥ 4` with `P_c(Q) = ⟨n⟩` (the paragraph before
  Lemma 5.6).

**Lemma 5.6** (`not_isCandidate_of_quotient_z4`): there is no candidate `Q` of order `2¹¹` with
`Q/P₃(Q) ≅ ℤ/4 × (ℤ/2)⁷`.

The proof follows the paper, with step (6) shortened: once `γ₂ = ⟨x⁴⟩`, the commutator
`c = ⁅x, g⁆ ∈ γ₂` commutes with `x`, so `x^k g x^{-k} = c^k g` and `x⁴` is central because
`c⁴ = 1`. The quotient `Q/P₃` enters only through its order `2⁹`, its commutativity and its
exponent `4`.
-/

namespace GroupDimension

open Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G]

/-! ## `H^m`, the lower exponent-`p` central series, the Jennings subgroups -/

/-- `H^m`: the subgroup generated by the `m`-th powers of the elements of `H`. -/
def powSubgroup (H : Subgroup G) (m : ℕ) : Subgroup G :=
  closure {g | ∃ h ∈ H, h ^ m = g}

theorem pow_mem_powSubgroup {H : Subgroup G} {h : G} (hh : h ∈ H) (m : ℕ) :
    h ^ m ∈ powSubgroup H m :=
  subset_closure ⟨h, hh, rfl⟩

theorem powSubgroup_le (H : Subgroup G) (m : ℕ) : powSubgroup H m ≤ H :=
  (closure_le H).mpr fun _ ⟨_, hh, hg⟩ => hg ▸ pow_mem hh m

theorem powSubgroup_normal (H : Subgroup G) [H.Normal] (m : ℕ) : (powSubgroup H m).Normal := by
  refine ⟨fun a ha g => ?_⟩
  have hle : (powSubgroup H m).map (MulAut.conj g).toMonoidHom ≤ powSubgroup H m := by
    rw [powSubgroup, MonoidHom.map_closure]
    refine (closure_le _).mpr ?_
    rintro _ ⟨_, ⟨h, hh, rfl⟩, rfl⟩
    exact subset_closure ⟨g * h * g⁻¹, ‹H.Normal›.conj_mem h hh g, by simp [conj_pow]⟩
  simpa using hle (mem_map_of_mem _ ha)

/-- The lower exponent-`p` central series shifted by one: `expCentralAux p G k = P_{k+1}(G)`. -/
def expCentralAux (p : ℕ) (G : Type*) [Group G] : ℕ → Subgroup G
  | 0 => ⊤
  | k + 1 => ⁅expCentralAux p G k, ⊤⁆ ⊔ powSubgroup (expCentralAux p G k) p

/-- The lower exponent-`p` central series in the paper's numbering: `P₁(G) = G`,
`P_{i+1}(G) = [P_i(G), G] P_i(G)^p`; also `P₀(G) = G`. -/
def expCentral (p : ℕ) (G : Type*) [Group G] (n : ℕ) : Subgroup G :=
  expCentralAux p G (n - 1)

/-- The Jennings subgroups `M_n(G) = ∏_{i p^j ≥ n} γ_i(G)^{p^j}` over `i ≥ 1`, `j ≥ 0`; the
index `i` below is Mathlib's, `lowerCentralSeries G i = γ_{i+1}(G)`. -/
def jennings (p : ℕ) (G : Type*) [Group G] (n : ℕ) : Subgroup G :=
  ⨆ (i : ℕ) (j : ℕ) (_ : n ≤ (i + 1) * p ^ j), powSubgroup (lowerCentralSeries G i) (p ^ j)

variable {p : ℕ}

theorem expCentralAux_normal : ∀ k, (expCentralAux p G k).Normal
  | 0 => by rw [expCentralAux.eq_1]; infer_instance
  | k + 1 => by
    haveI := expCentralAux_normal k
    haveI := powSubgroup_normal (expCentralAux p G k) p
    rw [expCentralAux.eq_2]
    infer_instance

instance expCentral_normal (n : ℕ) : (expCentral p G n).Normal :=
  expCentralAux_normal _

theorem expCentralAux_antitone : Antitone (expCentralAux p G) := by
  refine antitone_nat_of_succ_le fun k => ?_
  haveI := expCentralAux_normal (p := p) (G := G) k
  exact sup_le (commutator_le_left _ _) (powSubgroup_le _ _)

theorem expCentral_antitone {m k : ℕ} (h : m ≤ k) : expCentral p G k ≤ expCentral p G m :=
  expCentralAux_antitone (by omega)

theorem expCentral_one : expCentral p G 1 = ⊤ := rfl

theorem expCentral_succ {n : ℕ} (hn : 1 ≤ n) :
    expCentral p G (n + 1) = ⁅expCentral p G n, ⊤⁆ ⊔ powSubgroup (expCentral p G n) p := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  simp only [expCentral, Nat.add_sub_cancel]
  rw [expCentralAux.eq_2]

theorem pow_mem_expCentral_succ {n : ℕ} (hn : 1 ≤ n) {x : G} (hx : x ∈ expCentral p G n) :
    x ^ p ∈ expCentral p G (n + 1) := by
  rw [expCentral_succ hn]
  exact mem_sup_right (pow_mem_powSubgroup hx p)

/-! ## Candidates -/

/-- A *candidate* (§5 of the paper, before Lemma 5.6), with its involution `n`: a `2`-group of
class `3` with cyclic centre, whose central involution `n` lies in `γ₃ ∩ M₅`, and of `2`-class
`c ≥ 4` with `P_c = ⟨n⟩`. -/
structure IsCandidate (G : Type*) [Group G] (n : G) : Prop where
  isPGroup : IsPGroup 2 G
  gamma_four_eq_bot : lowerCentralSeries G 3 = ⊥
  gamma_three_ne_bot : lowerCentralSeries G 2 ≠ ⊥
  isCyclic_center : IsCyclic (center G)
  mem_center : n ∈ center G
  orderOf_eq_two : orderOf n = 2
  mem_gamma_three : n ∈ lowerCentralSeries G 2
  mem_jennings : n ∈ jennings 2 G 5
  twoClass : ∃ c ≥ 4, expCentral 2 G (c + 1) = ⊥ ∧ expCentral 2 G c = zpowers n

theorem pow_card_eq_one_of_mem {H : Subgroup G} [Finite H] {h : G} (hh : h ∈ H) :
    h ^ Nat.card H = 1 := by
  have h1 : (⟨h, hh⟩ : H) ^ Nat.card H = 1 := pow_card_eq_one'
  exact congrArg Subtype.val h1

theorem pow_eq_one_of_dvd {g : G} {a b : ℕ} (hg : g ^ a = 1) (hab : a ∣ b) : g ^ b = 1 := by
  obtain ⟨t, rfl⟩ := hab
  rw [pow_mul, hg, one_pow]

/-- The quotient `ℤ/4 × (ℤ/2)⁷` of the lemma, written multiplicatively. -/
abbrev Z4Z2pow7 := Multiplicative (ZMod 4 × (Fin 7 → ZMod 2))

theorem card_Z4Z2pow7 : Nat.card Z4Z2pow7 = 2 ^ 9 := by
  simp [Nat.card_eq_fintype_card, Fintype.card_multiplicative]

theorem pow_four_Z4Z2pow7 (v : Z4Z2pow7) : v ^ 4 = 1 := by
  have h4 : ∀ a : ZMod 4, 4 • a = 0 := by decide
  have h2 : ∀ a : ZMod 2, 4 • a = 0 := by decide
  rw [← ofAdd_toAdd v, ← ofAdd_nsmul, ofAdd_eq_one]
  exact Prod.ext (h4 _) (funext fun i => h2 _)

/-- **Lemma 5.6 of the paper.** There is no candidate `Q` of order `2¹¹` with
`Q/P₃(Q) ≅ ℤ/4 × (ℤ/2)⁷`. -/
theorem not_isCandidate_of_quotient_z4 {Q : Type*} [Group Q] (hcard : Nat.card Q = 2 ^ 11)
    (e : Q ⧸ expCentral 2 Q 3 ≃* Z4Z2pow7) (n : Q) : ¬ IsCandidate Q n := by
  intro hQ
  haveI : Finite Q := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  obtain ⟨c, hc4, hc1, hcn⟩ := hQ.twoClass
  have hn1 : n ≠ 1 := by
    intro h
    have := hQ.orderOf_eq_two
    rw [h, orderOf_one] at this
    omega
  have hcardn : Nat.card (zpowers n) = 2 := by rw [Nat.card_zpowers, hQ.orderOf_eq_two]
  -- `|P₃| = 4`
  have hP3 : Nat.card (expCentral 2 Q 3) = 4 := by
    have h := (expCentral 2 Q 3).card_mul_index
    rw [index_eq_card, Nat.card_congr e.toEquiv, card_Z4Z2pow7, hcard] at h
    omega
  -- `Q/P₃` is abelian of exponent `4`
  have hmk : ∀ y : Q, e (QuotientGroup.mk' _ y) = 1 → y ∈ expCentral 2 Q 3 := fun y hy =>
    (QuotientGroup.eq_one_iff y).mp (e.injective (hy.trans e.map_one.symm))
  have hx4 : ∀ x : Q, x ^ 4 ∈ expCentral 2 Q 3 := fun x =>
    hmk _ (by rw [map_pow, map_pow, pow_four_Z4Z2pow7])
  -- `P₄ = ⟨n⟩`: `P₃ ⊋ P₄ ⊇ P_c = ⟨n⟩`
  have hP4ne : expCentral 2 Q 4 ≠ expCentral 2 Q 3 := by
    intro h
    have hst : ∀ k, 3 ≤ k → expCentral 2 Q k = expCentral 2 Q 3 := by
      intro k hk
      induction k, hk using Nat.le_induction with
      | base => rfl
      | succ k hk ih =>
        rw [expCentral_succ (by omega), ih, ← expCentral_succ (by norm_num)]
        exact h
    have h0 := hst (c + 1) (by omega)
    rw [hc1] at h0
    have := congrArg (fun H : Subgroup Q => Nat.card H) h0
    simp [hP3] at this
  have hP4le : expCentral 2 Q 4 ≤ expCentral 2 Q 3 := expCentral_antitone (by norm_num)
  have hn4 : n ∈ expCentral 2 Q 4 := expCentral_antitone hc4 (hcn ▸ mem_zpowers n)
  have hP4 : expCentral 2 Q 4 = zpowers n := by
    have hdvd := card_dvd_of_le hP4le
    rw [hP3] at hdvd
    have hne4 : Nat.card (expCentral 2 Q 4) ≠ 4 := fun h =>
      hP4ne (eq_of_le_of_card_ge hP4le (by rw [h, hP3]))
    have h2dvd := card_dvd_of_le (zpowers_le.mpr hn4)
    rw [hcardn] at h2dvd
    have hle : Nat.card (expCentral 2 Q 4) ≤ 4 := Nat.le_of_dvd (by norm_num) hdvd
    have hpos : 0 < Nat.card (expCentral 2 Q 4) := Nat.card_pos
    have h2 : Nat.card (expCentral 2 Q 4) = 2 := by
      obtain ⟨m, hm⟩ : ∃ m, Nat.card (expCentral 2 Q 4) = m := ⟨_, rfl⟩
      rw [hm] at hle hne4 hpos h2dvd ⊢
      interval_cases m <;> omega
    exact (eq_of_le_of_card_ge (zpowers_le.mpr hn4) (by rw [h2, hcardn])).symm
  -- (1)–(2): `γ₂ = P₃` of order `4`, `|γ₃| = 2`
  have hγ2le : lowerCentralSeries Q 1 ≤ expCentral 2 Q 3 := by
    rw [lowerCentralSeries_one, _root_.commutator_def]
    refine commutator_le.mpr fun a _ b _ => hmk _ ?_
    rw [map_commutatorElement, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm,
      mul_comm]
  have e2 : lowerCentralSeries Q 2 = ⁅lowerCentralSeries Q 1, ⊤⁆ := lowerCentralSeries_succ 1
  have e3 : lowerCentralSeries Q 3 = ⁅lowerCentralSeries Q 2, ⊤⁆ := lowerCentralSeries_succ 2
  have hγ32 : lowerCentralSeries Q 2 ≤ lowerCentralSeries Q 1 :=
    lowerCentralSeries_antitone (by norm_num)
  have hγ3ne : lowerCentralSeries Q 2 ≠ lowerCentralSeries Q 1 := by
    intro h
    apply hQ.gamma_three_ne_bot
    calc lowerCentralSeries Q 2 = ⁅lowerCentralSeries Q 1, ⊤⁆ := e2
      _ = ⁅lowerCentralSeries Q 2, ⊤⁆ := by rw [h]
      _ = lowerCentralSeries Q 3 := e3.symm
      _ = ⊥ := hQ.gamma_four_eq_bot
  have hγ3card1 : Nat.card (lowerCentralSeries Q 2) ≠ 1 := fun h =>
    hQ.gamma_three_ne_bot (card_eq_one.mp h)
  have hγ3ne' : Nat.card (lowerCentralSeries Q 2) ≠ Nat.card (lowerCentralSeries Q 1) := fun h =>
    hγ3ne (eq_of_le_of_card_ge hγ32 h.ge)
  have hγ2card : Nat.card (lowerCentralSeries Q 1) = 4 ∧ Nat.card (lowerCentralSeries Q 2) = 2 := by
    have h1 := card_dvd_of_le hγ2le
    rw [hP3] at h1
    have h2 := card_dvd_of_le hγ32
    have hpos : 0 < Nat.card (lowerCentralSeries Q 2) := Nat.card_pos
    have h3 := hγ3card1
    have h4 := hγ3ne'
    obtain ⟨m, hm⟩ : ∃ m, Nat.card (lowerCentralSeries Q 1) = m := ⟨_, rfl⟩
    obtain ⟨k, hk⟩ : ∃ k, Nat.card (lowerCentralSeries Q 2) = k := ⟨_, rfl⟩
    rw [hm] at h1 h2 h4 ⊢
    rw [hk] at h2 h3 h4 hpos ⊢
    have hm4 : m ≤ 4 := Nat.le_of_dvd (by norm_num) h1
    have hkm : k ≤ m := Nat.le_of_dvd (Nat.pos_of_dvd_of_pos h1 (by norm_num)) h2
    clear hm hk
    interval_cases m <;> interval_cases k <;> omega
  have hγ2 : lowerCentralSeries Q 1 = expCentral 2 Q 3 :=
    eq_of_le_of_card_ge hγ2le (by rw [hP3, hγ2card.1])
  -- (3): `M₅ ≤ Q⁸`
  have hM5 : jennings 2 Q 5 ≤ powSubgroup ⊤ 8 := by
    refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => (closure_le _).mpr ?_
    rintro _ ⟨h, hh, rfl⟩
    have hpow : ∀ {a : ℕ}, h ^ a = 1 → a ∣ 2 ^ j → h ^ 2 ^ j ∈ powSubgroup (⊤ : Subgroup Q) 8 :=
      fun ha hdvd => by rw [pow_eq_one_of_dvd ha hdvd]; exact one_mem _
    rcases i with _ | _ | _ | i
    · have hj : 3 ≤ j := by
        by_contra hj
        have : 2 ^ j ≤ 2 ^ 2 := Nat.pow_le_pow_right (by norm_num) (by omega)
        norm_num at this hij
        omega
      have : h ^ 2 ^ j = (h ^ 2 ^ (j - 3)) ^ 8 := by
        rw [← pow_mul, ← show 2 ^ (j - 3) * 2 ^ 3 = 2 ^ j by rw [← pow_add]; congr 1; omega]
        rfl
      rw [this]
      exact pow_mem_powSubgroup (mem_top _) 8
    · have hj : 2 ≤ j := by
        by_contra hj
        have : 2 ^ j ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
        norm_num at this hij
        omega
      refine hpow (a := 2 ^ 2) ?_ (pow_dvd_pow 2 hj)
      have := pow_card_eq_one_of_mem hh
      rw [hγ2card.1] at this
      simpa using this
    · have hj : 1 ≤ j := by
        by_contra hj
        simp_all
      refine hpow (a := 2) ?_ (dvd_pow_self 2 (by omega))
      have := pow_card_eq_one_of_mem hh
      rwa [hγ2card.2] at this
    · have h1 : h = 1 := by
        have := lowerCentralSeries_antitone (G := Q) (by omega : 3 ≤ i + 1 + 1 + 1) hh
        rwa [hQ.gamma_four_eq_bot, mem_bot] at this
      refine hpow (a := 1) (by rw [h1, one_pow]) (one_dvd _)
  -- (4)–(5): `x⁸ = n` for some `x`
  have hS : ∀ x : Q, x ^ 8 = 1 ∨ x ^ 8 = n := by
    intro x
    have hx8 : x ^ 8 ∈ zpowers n := by
      rw [← hP4]
      have h := pow_mem_expCentral_succ (p := 2) (n := 3) (by norm_num) (hx4 x)
      rw [← pow_mul] at h
      exact h
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp hx8
    rw [← hk, ← zpow_mod_orderOf, hQ.orderOf_eq_two]
    rcases Int.emod_two_eq_zero_or_one k with h | h <;> simp [h]
  obtain ⟨x, hx⟩ : ∃ x : Q, x ^ 8 = n := by
    by_contra hno
    have hle : powSubgroup (⊤ : Subgroup Q) 8 ≤ ⊥ := by
      refine (closure_le _).mpr ?_
      rintro _ ⟨y, -, rfl⟩
      exact mem_bot.mpr ((hS y).resolve_right fun h => hno ⟨y, h⟩)
    exact hn1 (mem_bot.mp (hle (hM5 hQ.mem_jennings)))
  -- `γ₂ = ⟨x⁴⟩`
  have hord : orderOf (x ^ 4) = 4 := by
    have h := orderOf_eq_prime_pow (p := 2) (n := 1) (x := x ^ 4) ?_ ?_
    · simpa using h
    · rw [← pow_mul]
      exact hx ▸ hn1
    · rw [← pow_mul, show 4 * 2 ^ (1 + 1) = 8 * 2 by norm_num, pow_mul, hx,
        ← hQ.orderOf_eq_two, pow_orderOf_eq_one]
  have hx4γ : x ^ 4 ∈ lowerCentralSeries Q 1 := hγ2 ▸ hx4 x
  have hγ2z : zpowers (x ^ 4) = lowerCentralSeries Q 1 :=
    eq_of_le_of_card_ge (zpowers_le.mpr hx4γ) (by rw [Nat.card_zpowers, hord, hγ2card.1])
  -- (6): `x⁴` is central
  have hcent : x ^ 4 ∈ center Q := by
    rw [mem_center_iff]
    intro g
    have hc : ⁅x, g⁆ ∈ lowerCentralSeries Q 1 := by
      rw [lowerCentralSeries_one]
      exact commutator_mem_commutator (mem_top x) (mem_top g)
    have hcx : Commute ⁅x, g⁆ x := by
      rw [← hγ2z] at hc
      obtain ⟨k, hk⟩ := mem_zpowers_iff.mp hc
      rw [← hk]
      exact ((Commute.refl x).pow_left 4).zpow_left k
    have hxg : x * g * x⁻¹ = ⁅x, g⁆ * g := by
      rw [commutatorElement_def]
      group
    have hconj : ∀ m : ℕ, x ^ m * g * (x ^ m)⁻¹ = ⁅x, g⁆ ^ m * g := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        calc x ^ (m + 1) * g * (x ^ (m + 1))⁻¹ = x * (x ^ m * g * (x ^ m)⁻¹) * x⁻¹ := by group
          _ = ⁅x, g⁆ ^ m * (x * g * x⁻¹) := by
            rw [ih, ← mul_assoc x, ← (hcx.pow_left m).eq]
            group
          _ = ⁅x, g⁆ ^ (m + 1) * g := by rw [hxg, pow_succ, mul_assoc]
    have h4 : ⁅x, g⁆ ^ 4 = 1 := by
      have := pow_card_eq_one_of_mem hc
      rwa [hγ2card.1] at this
    have := hconj 4
    rw [h4, one_mul, mul_inv_eq_iff_eq_mul] at this
    exact this.symm
  -- (7): `γ₃ = [γ₂, Q] = 1`, a contradiction
  apply hQ.gamma_three_ne_bot
  rw [e2, ← hγ2z, eq_bot_iff]
  refine commutator_le.mpr fun a ha b _ => ?_
  have hac : a ∈ center Q := zpowers_le.mpr hcent ha
  exact mem_bot.mpr (commutatorElement_eq_one_iff_mul_comm.mpr ((mem_center_iff.mp hac b).symm))

end GroupDimension
