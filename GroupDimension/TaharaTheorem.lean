module

public import GroupDimension.ExpThreePlus
public import GroupDimension.TaharaProof.Decode12

@[expose] public section

/-!
# Tahara's Theorem 6.1, and Theorems 6.6 and 6.8 without hypotheses

`taharaFiveOne` proves `TaharaFiveOne` (`Tahara.lean`), the inclusion `⊆` of Tahara's description
of `D₅` for finite groups of class `≤ 4` [Tah81, Thm. 6.1]. The proof (`TaharaProof/`) follows
§§2–6 of [Tah81]:

* a *frame*: the uniqueness bases of the layers `γ_k/γ_{k+1}` glued into one ordered family with
  normal forms (`Words`, `Basis`, `Layers`, `TFrame`); the basic products `P a` form a `ℤ`-basis
  of `ℤG`, and `Δ^n` is spanned by the products of weight `≥ n` modulo lower ones (`Induction`);
* the maps `ψ₁` and `ψ₃` of Tahara's Theorems 4.1 and 5.1 into `W₁* ⊕ W₂` and `W₃* ⊕ W₄`,
  with Losey's basis of the target (`Level1`, `Level3Defs`, `Level3Basis`, `Level3`,
  `Level3Cases`): `ψ₃(Δ⁵)` lies in the span `R₅*` of the relations (I)–(VII);
* decoding (`Decode1`–`Decode12`): an element `g ∈ D₅` lies in `γ₃` (`D_three_le`), its symbol
  `S g` lies in `R₅*`, the coordinates of the combination of the relations give the conditions
  (A)–(F) for `τ = (u, v, v', w, w', w'')`, and the `A₃ ⊕ A₄` part gives `g = gen τ`.

With it, Theorems 6.6 and 6.8 of the paper (`ExpThree.lean`, `ExpThreePlus.lean`, where
`TaharaFiveOne` is a hypothesis) hold unconditionally.
-/

namespace GroupDimension

open TaharaProof Tahara in
/-- **Tahara's Theorem 6.1** [Tah81] (the inclusion `⊆`), proved. -/
theorem taharaFiveOne : TaharaFiveOne := by
  intro G _ _ h4 T hT z hz
  classical
  letI := Fintype.ofFinite G
  obtain ⟨v, y4, o4, hy4, ho4⟩ := exists_layer4 (G := G)
  have hz3 : z ∈ (⊤ : Subgroup G).lowerCentralSeries 2 :=
    (Tframe h4 hT hy4).D_three_le (D_antitone (by norm_num : 3 ≤ 5) hz)
  have hR := Frame.S_mem_R5 (Tframe_class4 h4 hT hy4 ho4) hz hz3
  obtain ⟨p, U, V, V', W5, W6, W7, hS⟩ := RT_coeffs h4 hT hy4 (R5_le_RT h4 hT hy4 hR)
  rw [comb_eq h4 hT hy4 ho4] at hS
  exact Subgroup.subset_closure ⟨tau U V V' W5 W6 W7, admissible_tau h4 hT hy4 hS,
    eq_gen h4 hT hy4 ho4 hz3 hS⟩


/-- **Theorem 6.6 of the paper** (unconditional): if `G/γ₂(G)` is finite of exponent `3`, then
`D₅(G) = γ₅(G)`. -/
theorem D_five_eq_gamma_five_of_exp_three (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1)) (h1 : ∀ x : G, x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  ExpThree.D_five_eq_gamma_five taharaFiveOne G hfin h1

/-- Theorem 6.6, the finite form: a finite group of class `≤ 4` with `G/γ₂` of exponent `3` has
`D₅ = 1`. -/
theorem D_five_eq_bot_of_class_four_exp_three {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥) (h1 : ∀ x : Q, x ^ 3 ∈ (⊤ : Subgroup Q).lowerCentralSeries 1) :
    D 5 Q = ⊥ :=
  ExpThree.D_five_eq_bot_of_class_four taharaFiveOne h5 h1

/-- **Theorem 6.8 of the paper** (unconditional): if `G/γ₂(G)` is a finite `3`-group whose cubes
form a cyclic group (generated by the image of `t³`), then `D₅(G) = γ₅(G)`. -/
theorem D_five_eq_gamma_five_of_cubes_cyclic (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1) (t : G)
    (ht : ∀ x : G, ∃ n : ℕ, (t ^ (3 * n))⁻¹ * x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  ExpThree.D_five_eq_gamma_five_cyclic taharaFiveOne G hfin h3grp t ht

/-- Theorem 6.8, the finite form. -/
theorem D_five_eq_bot_of_class_four_cubes_cyclic {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥) (h3grp : ∀ x : Q, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup Q).lowerCentralSeries 1)
    (t : Q) (ht : ∀ x : Q, ∃ n : ℕ, (t ^ (3 * n))⁻¹ * x ^ 3 ∈ (⊤ : Subgroup Q).lowerCentralSeries 1) :
    D 5 Q = ⊥ :=
  ExpThree.D_five_eq_bot_of_class_four_cyclic taharaFiveOne h5 h3grp t ht

end GroupDimension
