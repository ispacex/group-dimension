module

public import GroupDimension.ExpThreePlus
public import GroupDimension.ExpThreeGen
public import GroupDimension.ExpNine
public import GroupDimension.G4Cube
public import GroupDimension.Ab399Finite
public import GroupDimension.TaharaProof.Decode12
public import GroupDimension.D5Tag

@[expose] public section

/-!
# Tahara's Theorem 6.1, and Theorems 6.6 and 6.8 without hypotheses

`taharaFiveOne` proves `TaharaFiveOne` (`Tahara.lean`), the inclusion `⊆` of Tahara's description
of `D₅` for finite groups of class `≤ 4` [Tah81, Thm. 6.1]. The proof (`TaharaProof/`) follows
§§2–6 of [Tah81]:

* a *frame*: the uniqueness bases of the layers `γ_k/γ_{k+1}` glued into one ordered family with
  normal forms (`Words`, `Basis`, `Layers`, `TFrame`); the basic products `P a` form a `ℤ`-basis
  of `ℤG`, and `Δ^n` is spanned by the products of weight `≥ n` modulo lower ones (`Induction`);
* the maps `ψ₁` and `ψ₃` of Tahara's Theorems 4.1 and 5.1 into `W₁* ⊕ W₂` and `W₃* ⊕ W₄`,
  with Losey's basis of the target (`Level1`, `Level3Defs`, `Level3Basis`, `Level3`,
  `Level3Cases`): `ψ₃(Δ⁵)` lies in the span `R₅*` of the relations (I)–(VII);
* decoding (`Decode1`–`Decode12`): an element `g ∈ D₅` lies in `γ₃` (`D_three_le`), its symbol
  `S g` lies in `R₅*`, the coordinates of the combination of the relations give the conditions
  (A)–(F) for `τ = (u, v, v', w, w', w'')`, and the `A₃ ⊕ A₄` part gives `g = gen τ`.

With it, Theorems 6.6, 6.8, 6.9, 6.10 and 6.11 (Theorem B) of the paper
(`ExpThree.lean`, `ExpThreePlus.lean`, `ExpThreeGen.lean`, `ExpNine.lean`, `G4Cube.lean`, where
`TaharaFiveOne` is a hypothesis) hold unconditionally. Theorem 6.10 is derived here from Theorem B
(`γ₄³ ⊆ γ₅` alone); its direct proof `ExpThree.D_five_eq_gamma_five_g4_cube_g2_nine` is kept.
Theorem 6.9 is derived here from Theorem 6.10 (its hypothesis gives `γ₄³ ⊆ γ₅` and
`γ₂⁹ ⊆ γ₄`); its direct proof `ExpThree.D_five_eq_gamma_five_exp_L1` is kept.
-/

namespace GroupDimension

open TaharaProof Tahara in
/-- **Tahara's Theorem 6.1** [Tah81] (the inclusion `⊆`), proved. -/
@[d5 "ext:tahara61"]
theorem taharaFiveOne : TaharaFiveOne := by
  intro G _ _ h4 T hT z hz
  classical
  letI := Fintype.ofFinite G
  obtain ⟨v, y4, o4, hy4, ho4⟩ := exists_layer4 (G := G)
  have hz3 : z ∈ (⊤ : Subgroup G).lowerCentralSeries 2 :=
    (Tframe h4 hT hy4).D_three_le (D_antitone (by norm_num : 3 ≤ 5) hz)
  have hR := Frame.S_mem_R5 (Tframe_class4 h4 hT hy4 ho4) hz hz3
  obtain ⟨p, U, V, V', W5, W6, W7, hS⟩ := RT_coeffs h4 hT hy4 (R5_le_RT h4 hT hy4 hR)
  rw [comb_eq h4 hT hy4 ho4] at hS
  exact Subgroup.subset_closure ⟨tau U V V' W5 W6 W7, admissible_tau h4 hT hy4 hS,
    eq_gen h4 hT hy4 ho4 hz3 hS⟩


/-- **Theorem 6.6 of the paper** (unconditional): if `G/γ₂(G)` is finite of exponent `3`, then
`D₅(G) = γ₅(G)`. -/
@[d5 "thm:exp3"]
theorem D_five_eq_gamma_five_of_exp_three (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1)) (h1 : ∀ x : G, x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  ExpThree.D_five_eq_gamma_five taharaFiveOne G hfin h1

/-- Theorem 6.6, the finite form: a finite group of class `≤ 4` with `G/γ₂` of exponent `3` has
`D₅ = 1`. -/
theorem D_five_eq_bot_of_class_four_exp_three {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥) (h1 : ∀ x : Q, x ^ 3 ∈ (⊤ : Subgroup Q).lowerCentralSeries 1) :
    D 5 Q = ⊥ :=
  ExpThree.D_five_eq_bot_of_class_four taharaFiveOne h5 h1

/-- **Theorem 6.8 of the paper** (unconditional): if `G/γ₂(G)` is a finite `3`-group whose cubes
form a cyclic group (generated by the image of `t³`), then `D₅(G) = γ₅(G)`. -/
@[d5 "thm:exp3plus"]
theorem D_five_eq_gamma_five_of_cubes_cyclic (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1) (t : G)
    (ht : ∀ x : G, ∃ n : ℕ, (t ^ (3 * n))⁻¹ * x ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 1) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  ExpThree.D_five_eq_gamma_five_cyclic taharaFiveOne G hfin h3grp t ht

/-- Theorem 6.8, the finite form. -/
theorem D_five_eq_bot_of_class_four_cubes_cyclic {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥) (h3grp : ∀ x : Q, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup Q).lowerCentralSeries 1)
    (t : Q) (ht : ∀ x : Q, ∃ n : ℕ, (t ^ (3 * n))⁻¹ * x ^ 3 ∈ (⊤ : Subgroup Q).lowerCentralSeries 1) :
    D 5 Q = ⊥ :=
  ExpThree.D_five_eq_bot_of_class_four_cyclic taharaFiveOne h5 h3grp t ht

/-- **Theorem 6.11 of the paper** (`thm:g4cube`, Theorem B of MATH-444, unconditional): if `G/γ₂(G)` is a finite `3`-group and
`γ₄(G)³ ⊆ γ₅(G)`, then `D₅(G) = γ₅(G)`. It contains Theorems 6.10
(`D_five_eq_gamma_five_of_g4_cube_g2_nine`) and 6.9 (`D_five_eq_gamma_five_of_exp_L1_three`). -/
@[d5 "thm:g4cube"]
theorem D_five_eq_gamma_five_of_g4_cube (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1)
    (h4 : ∀ c ∈ (⊤ : Subgroup G).lowerCentralSeries 3, c ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 4) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  ExpThree.D_five_eq_gamma_five_g4_cube taharaFiveOne G hfin h3grp h4

/-- Theorem B, the finite form: a finite group of class `≤ 4` with `G/γ₂` a `3`-group and
`c³ = 1` for `c ∈ γ₄` has `D₅ = 1`. -/
@[d5 "thm:g4cube"]
theorem D_five_eq_bot_of_class_four_g4_cube {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥)
    (h3grp : ∀ x : Q, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup Q).lowerCentralSeries 1)
    (h4 : ∀ c ∈ (⊤ : Subgroup Q).lowerCentralSeries 3, c ^ 3 = 1) :
    D 5 Q = ⊥ :=
  ExpThree.D_five_eq_bot_of_class_four_g4_cube taharaFiveOne h5 h3grp h4

/-- `Q_ab ≅ C₃ × C₉ × C₉` (MATH-448): a finite group of class `≤ 4` whose abelianization is
`C₃ × C₉ × C₉` has `D₅ = 1`. No condition on `γ₄` is assumed; in particular this covers
`γ₄ ≅ C₉`, the case left open by Theorem 6.11 (remark 6.13 of the paper) for this type of `Q_ab`.
Proof: the exact identity `(⋆)` (`Star.two_smul_gen_eq`) evaluated term by term (`Ab399`). -/
theorem D_five_eq_bot_of_class_four_ab399 {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥)
    (hab : Nonempty (Q ⧸ (⊤ : Subgroup Q).lowerCentralSeries 1 ≃*
      Multiplicative (ZMod 3 × ZMod 9 × ZMod 9))) :
    D 5 Q = ⊥ :=
  Ab399.D_five_eq_bot_of_class_four_ab399 taharaFiveOne h5 hab

/-- **Theorem 6.10 of the paper** (`thm:exp3h9`, unconditional; MATH-444): if `G/γ₂(G)` is a
finite `3`-group, `γ₄(G)³ ⊆ γ₅(G)` and `γ₂(G)⁹ ⊆ γ₄(G)`, then `D₅(G) = γ₅(G)`. It contains
Theorem 6.9 (`D_five_eq_gamma_five_of_exp_L1_three`). Derived from Theorem B
(`D_five_eq_gamma_five_of_g4_cube`); the direct proof is
`ExpThree.D_five_eq_gamma_five_g4_cube_g2_nine`. -/
@[d5 "thm:exp3h9"]
theorem D_five_eq_gamma_five_of_g4_cube_g2_nine (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1)
    (h4 : ∀ c ∈ (⊤ : Subgroup G).lowerCentralSeries 3, c ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 4)
    (_h9 : ∀ a ∈ (⊤ : Subgroup G).lowerCentralSeries 1, a ^ 9 ∈ (⊤ : Subgroup G).lowerCentralSeries 3) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  D_five_eq_gamma_five_of_g4_cube G hfin h3grp h4

/-- Theorem 6.10, the finite form: a finite group of class `≤ 4` with `G/γ₂` a `3`-group,
`c³ = 1` for `c ∈ γ₄` and `a⁹ ∈ γ₄` for `a ∈ γ₂` has `D₅ = 1` (derived from Theorem B). -/
@[d5 "thm:exp3h9"]
theorem D_five_eq_bot_of_class_four_g4_cube_g2_nine {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥)
    (h3grp : ∀ x : Q, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup Q).lowerCentralSeries 1)
    (h4 : ∀ c ∈ (⊤ : Subgroup Q).lowerCentralSeries 3, c ^ 3 = 1)
    (_h9 : ∀ a ∈ (⊤ : Subgroup Q).lowerCentralSeries 1, a ^ 9 ∈ (⊤ : Subgroup Q).lowerCentralSeries 3) :
    D 5 Q = ⊥ :=
  D_five_eq_bot_of_class_four_g4_cube h5 h3grp h4

/-- `γ₂/γ₃` of exponent dividing `3` gives the second hypothesis of Theorem 6.10, `γ₂⁹ ⊆ γ₄`
(the first, `γ₄³ ⊆ γ₅`, is `ExpThree.cube_succ (ExpThree.cube_L2 h2)`). -/
@[d5 "thm:exp3gen"]
theorem nine_L1_of_exp_L1 {G : Type*} [Group G]
    (h2 : ∀ a ∈ (⊤ : Subgroup G).lowerCentralSeries 1, a ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 2) :
    ∀ a ∈ (⊤ : Subgroup G).lowerCentralSeries 1, a ^ 9 ∈ (⊤ : Subgroup G).lowerCentralSeries 3 := by
  intro a ha
  rw [show a ^ 9 = (a ^ 3) ^ 3 by rw [← pow_mul]]
  exact ExpThree.cube_L2 h2 _ (h2 a ha)

/-- **Theorem 6.9 of the paper** (unconditional; MATH-443): if `G/γ₂(G)` is a finite `3`-group and
`γ₂(G)/γ₃(G)` has exponent dividing `3` (`a³ ∈ γ₃(G)` for every `a ∈ γ₂(G)`), then
`D₅(G) = γ₅(G)`. There is no restriction on the invariants of `G/γ₂(G)`; Theorems 6.6 and 6.8 follow from
it (`ExpThree.D_five_eq_gamma_five_of_exp_three_of_exp_L1`,
`ExpThree.D_five_eq_gamma_five_cyclic_of_exp_L1`); they are also proved directly
(`D_five_eq_gamma_five_of_exp_three`, `D_five_eq_gamma_five_of_cubes_cyclic`). Derived from
Theorem 6.10 (`D_five_eq_gamma_five_of_g4_cube_g2_nine`; MATH-444); the direct proof is
`ExpThree.D_five_eq_gamma_five_exp_L1`. -/
@[d5 "thm:exp3gen"]
theorem D_five_eq_gamma_five_of_exp_L1_three (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1)
    (h2 : ∀ a ∈ (⊤ : Subgroup G).lowerCentralSeries 1, a ^ 3 ∈ (⊤ : Subgroup G).lowerCentralSeries 2) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  D_five_eq_gamma_five_of_g4_cube_g2_nine G hfin h3grp
    (fun c hc => ExpThree.cube_succ (ExpThree.cube_L2 h2) c hc) (nine_L1_of_exp_L1 h2)

open scoped commutatorElement in
/-- Theorem 6.9 with the hypothesis in the form `[x³, y] ∈ γ₃(G)` for all `x, y`
(`ExpThree.cube_L1_of_comm_cube`). -/
@[d5 "thm:exp3gen"]
theorem D_five_eq_gamma_five_of_comm_cube (G : Type) [Group G]
    (hfin : Finite (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 1))
    (h3grp : ∀ x : G, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup G).lowerCentralSeries 1)
    (h : ∀ x y : G, ⁅x ^ 3, y⁆ ∈ (⊤ : Subgroup G).lowerCentralSeries 2) :
    D 5 G = (⊤ : Subgroup G).lowerCentralSeries 4 :=
  D_five_eq_gamma_five_of_exp_L1_three G hfin h3grp (ExpThree.cube_L1_of_comm_cube h)

/-- Theorem 6.9, the finite form: a finite group of class `≤ 4` with `G/γ₂` a `3`-group and
`γ₂/γ₃` of exponent dividing `3` has `D₅ = 1` (derived from Theorem 6.10). -/
theorem D_five_eq_bot_of_class_four_exp_L1_three {Q : Type} [Group Q] [Finite Q]
    (h5 : (⊤ : Subgroup Q).lowerCentralSeries 4 = ⊥)
    (h3grp : ∀ x : Q, ∃ k : ℕ, x ^ (3 ^ k) ∈ (⊤ : Subgroup Q).lowerCentralSeries 1)
    (h2 : ∀ a ∈ (⊤ : Subgroup Q).lowerCentralSeries 1, a ^ 3 ∈ (⊤ : Subgroup Q).lowerCentralSeries 2) :
    D 5 Q = ⊥ :=
  D_five_eq_bot_of_class_four_g4_cube_g2_nine h5 h3grp (ExpThree.cube_L3 h5 h2) (nine_L1_of_exp_L1 h2)

end GroupDimension
