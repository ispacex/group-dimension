file: `rels` and `tests` are transcribed from the presentation by `trace_to_lean.py`. -/
theorem certified :
    (∀ t ∈ members, mt trace.d trace.n (findWord t trace.tests) - 1 ∈ LT trace trace.n) ∧
    (∀ w : FreeMonoid (Fin trace.d), w ≠ 1 →
      ((trace.p ^ (trace.E - 1) : ℕ) : ℤ) • MonoidAlgebra.single w 1 ∈
        LT trace trace.n ⊔ Fspan trace.d trace.F) :=
  check_sound trace members check_ok

/-- The weight-1 polynomial maps (cert/polymaps): `a_j = φ(x_{j+1})`. -/
def maps : List (List Int) := [[0, 0, 0, 1, 0]]

/-- The functionals `φ^K` and the integer left inverse on the free columns (`trace_to_lean.py`). -/
def hcert : HomCert where
  funcs := [([0, 0, 0, 1, 0], 1), ([0, 0, 0, 1, 0], 2), ([0, 0, 0, 1, 0], 3)]
  rows := [([1, 0, 0], 1), ([-1, 1, 0], 2), ([2, -3, 1], 6)]

theorem hom_ok : checkHom trace hcert = true := by decide +kernel

theorem maps_ok : hcert.funcs.all (fun κ => maps.any (fun a => a == κ.1)) = true := by decide

