    (hφ : ∀ a ∈ maps, ∃ φ : G →* Multiplicative ℤ,
      ∀ j : Fin trace.d, Multiplicative.toAdd (φ (g j)) = a.getD j.val 0)
    (hord : ∃ m : ℕ, ((trace.p : ℤ) ^ m) • (MonoidAlgebra.of ℤ G (gword g [(1, -1), (2, -256), (1, 1), (2, 256), (1, -1), (3, -16384), (1, 1), (3, 16384), (2, -1), (3, -32768), (2, 1), (3, 32768)]) - 1) ∈
