module

public import Mathlib

@[expose] public section

/-!
# Iterated extensions of an abelian group by infinite cyclic groups

Let `A` be an abelian group, `T 0, T 1, …` pairwise commuting automorphisms of `A`, and `b j i ∈ A`
for `j < i`. We build, for every `k`, a group `G` generated by `ι(A)` and `X 0, …, X (k-1)` with

* `(X j)⁻¹ ι(a) X j = ι(T j a)`, and
* `(X i)⁻¹ X j X i = X j ι(b j i)` for `j < i`,

that has the universal property for these relations (`Stage.lift`), contains `A` (`ι` is
injective), and in which every element is `ι(a) X 0 ^ s 0 ⋯ X (k-1) ^ s (k-1)` (`Stage.nf`).
Stage `k + 1` is the semidirect product of stage `k` with `ℤ`, acting by "conjugation by `X k`".
This needs that conjugation to be an automorphism of stage `k`. That holds if the `T`'s commute
(`hT`) and, for `j < i < k`,

  `-T j (b i k) + b j i + T i (b j k) + b i k = b j k + T k (b j i)`,

which, with `T = 1 + D`, is the Jacobi identity `D_k b_ji = D_i b_jk - D_j b_ik` (`hJ`).
No consistency of a presentation has to be checked: each step is a semidirect product.

This is used in `NonterminalSufficient.lean` for the sufficiency part of Theorem 6.12.
-/

namespace GroupDimension.IterExt

open Multiplicative

variable {A : Type} [AddCommGroup A] (T : ℕ → A ≃+ A) (b : ℕ → ℕ → A)

/-- Stage `k` of the construction, with its universal property. -/
structure Stage (k : ℕ) where
  /-- the group -/
  G : Type
  [grp : Group G]
  /-- the embedding of `A` -/
  ι : Multiplicative A →* G
  /-- the generators `X 0, …, X (k-1)` (the values at `j ≥ k` are irrelevant) -/
  X : ℕ → G
  ι_injective : Function.Injective ι
  conj_ι : ∀ j < k, ∀ a : A, (X j)⁻¹ * ι (ofAdd a) * X j = ι (ofAdd (T j a))
  conj_X : ∀ i j, j < i → i < k → (X i)⁻¹ * X j * X i = X j * ι (ofAdd (b j i))
  nf : ∀ g : G, ∃ (a : A) (s : ℕ → ℤ),
    g = ι (ofAdd a) * ((List.range k).map fun j => X j ^ s j).prod
  lift : ∀ {K : Type} [Group K] (ψ : Multiplicative A →* K) (y : ℕ → K),
    (∀ j < k, ∀ a : A, (y j)⁻¹ * ψ (ofAdd a) * y j = ψ (ofAdd (T j a))) →
    (∀ i j, j < i → i < k → (y i)⁻¹ * y j * y i = y j * ψ (ofAdd (b j i))) →
    {f : G →* K // (∀ a, f (ι a) = ψ a) ∧ ∀ j < k, f (X j) = y j}
  hom_ext : ∀ {K : Type} [Group K] (f g : G →* K), (∀ a, f (ι a) = g (ι a)) →
    (∀ j < k, f (X j) = g (X j)) → f = g

attribute [instance] Stage.grp

namespace Stage

variable {T b} {k : ℕ} (S : Stage T b k)

theorem ι_add (a c : A) : S.ι (ofAdd (a + c)) = S.ι (ofAdd a) * S.ι (ofAdd c) := by
  rw [ofAdd_add, map_mul]

theorem ι_neg (a : A) : S.ι (ofAdd (-a)) = (S.ι (ofAdd a))⁻¹ := by
  rw [ofAdd_neg, map_inv]

theorem ι_zero : S.ι (ofAdd (0 : A)) = 1 := by
  rw [ofAdd_zero, map_one]

theorem ι_comm (a c : A) : S.ι (ofAdd a) * S.ι (ofAdd c) = S.ι (ofAdd c) * S.ι (ofAdd a) := by
  rw [← S.ι_add, ← S.ι_add, add_comm]

theorem ι_mul_X {j : ℕ} (hj : j < k) (a : A) :
    S.ι (ofAdd a) * S.X j = S.X j * S.ι (ofAdd (T j a)) := by
  rw [← S.conj_ι j hj a]; group

/-- `(X j ^ n)⁻¹ ι(a) X j ^ n = ι(T j^[n] a)`. -/
theorem conj_pow {j : ℕ} (hj : j < k) (a : A) (n : ℕ) :
    (S.X j ^ n)⁻¹ * S.ι (ofAdd a) * S.X j ^ n = S.ι (ofAdd ((⇑(T j))^[n] a)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', ← S.conj_ι j hj, ← ih, pow_succ]; group

/-- Conjugating `X i` by `X j`, for `i, j < k`. -/
theorem conj_X' {i j : ℕ} (hi : i < k) (hj : j < k) :
    (S.X j)⁻¹ * S.X i * S.X j = S.X i * S.ι (ofAdd
      (if i < j then b i j else if j < i then -b j i else 0)) := by
  rcases lt_trichotomy i j with h | rfl | h
  · rw [if_pos h, S.conj_X j i h hj]
  · simp
  · rw [if_neg (lt_asymm h), if_pos h, S.ι_neg]
    have e := S.conj_X i j h hi
    have e2 : S.X j * S.X i = S.X i * (S.X j * S.ι (ofAdd (b j i))) := by rw [← e]; group
    calc (S.X j)⁻¹ * S.X i * S.X j
        = (S.X j)⁻¹ * (S.X i * (S.X j * S.ι (ofAdd (b j i)))) * (S.ι (ofAdd (b j i)))⁻¹ := by
          group
      _ = (S.X j)⁻¹ * (S.X j * S.X i) * (S.ι (ofAdd (b j i)))⁻¹ := by rw [e2]
      _ = S.X i * (S.ι (ofAdd (b j i)))⁻¹ := by group

/-- An element commuting with `ι(A)` and with `X 0, …, X (k-1)` is central. -/
theorem mem_center {c : S.G} (hι : ∀ a, Commute c (S.ι (ofAdd a)))
    (hX : ∀ j < k, Commute c (S.X j)) : c ∈ Subgroup.center S.G := by
  rw [Subgroup.mem_center_iff]
  intro g
  obtain ⟨a, s, rfl⟩ := S.nf g
  have hl : ∀ l : List ℕ, (∀ j ∈ l, j < k) → Commute c ((l.map fun j => S.X j ^ s j).prod) := by
    intro l hl
    induction l with
    | nil => simp
    | cons j l ih =>
      simp only [List.map_cons, List.prod_cons]
      exact ((hX j (hl j List.mem_cons_self)).zpow_right _).mul_right
        (ih fun i hi => hl i (List.mem_cons_of_mem _ hi))
  exact ((hι a).mul_right (hl _ fun j hj => List.mem_range.mp hj)).eq.symm

end Stage

/-! ### Stage `0` -/

/-- Stage `0` is `A` itself. -/
def stage0 : Stage T b 0 where
  G := Multiplicative A
  ι := MonoidHom.id _
  X := fun _ => 1
  ι_injective := Function.injective_id
  conj_ι := fun j hj => absurd hj (Nat.not_lt_zero j)
  conj_X := fun i _ _ hi => absurd hi (Nat.not_lt_zero i)
  nf := fun g => ⟨toAdd g, 0, by simp⟩
  lift := fun ψ _ _ _ => ⟨ψ, fun _ => rfl, fun j hj => absurd hj (Nat.not_lt_zero j)⟩
  hom_ext := fun _ _ h _ => MonoidHom.ext h

/-! ### From stage `k` to stage `k + 1` -/

/-- If `f α = β f` for automorphisms `α`, `β`, then `f α^m = β^m f` for all `m : ℤ`. -/
theorem intertwine_zpow {N K : Type*} [Group N] [Group K] (f : N →* K) (α : MulAut N)
    (β : MulAut K) (h : ∀ n, f (α n) = β (f n)) (m : ℤ) : ∀ n, f ((α ^ m) n) = (β ^ m) (f n) := by
  have hinv : ∀ n, f (α⁻¹ n) = β⁻¹ (f n) := fun n => by
    apply β.injective
    rw [← h, MulAut.apply_inv_self, MulAut.apply_inv_self]
  induction m using Int.induction_on with
  | zero => intro n; simp
  | succ m ih => intro n; rw [zpow_add_one, zpow_add_one, MulAut.mul_apply, MulAut.mul_apply, ih, h]
  | pred m ih =>
    intro n; rw [zpow_sub_one, zpow_sub_one, MulAut.mul_apply, MulAut.mul_apply, ih, hinv]

section Succ

variable {T b}
  (hT : ∀ i j a, T i (T j a) = T j (T i a))
  {k : ℕ}
  (hJ : ∀ i j, j < i → i < k →
    -T j (b i k) + b j i + T i (b j k) + b i k = b j k + T k (b j i))
  (S : Stage T b k)

/-- `e` as a monoid homomorphism of `Multiplicative A`. -/
def mulOf (e : A ≃+ A) : Multiplicative A →* Multiplicative A where
  toFun a := ofAdd (e (toAdd a))
  map_one' := by simp
  map_mul' a c := by simp [toAdd_mul]

include hT hJ in
/-- Conjugation by the new generator `X k`, on stage `k`. -/
def fwd : S.G →* S.G :=
  (S.lift (S.ι.comp (mulOf (T k))) (fun j => S.X j * S.ι (ofAdd (b j k)))
    (fun j hj a => by
      show (S.X j * S.ι (ofAdd (b j k)))⁻¹ * S.ι (ofAdd (T k a)) * (S.X j * S.ι (ofAdd (b j k)))
        = S.ι (ofAdd (T k (T j a)))
      calc (S.X j * S.ι (ofAdd (b j k)))⁻¹ * S.ι (ofAdd (T k a)) * (S.X j * S.ι (ofAdd (b j k)))
          = (S.ι (ofAdd (b j k)))⁻¹ * ((S.X j)⁻¹ * S.ι (ofAdd (T k a)) * S.X j) *
            S.ι (ofAdd (b j k)) := by group
        _ = S.ι (ofAdd (T j (T k a))) := by
          rw [S.conj_ι j hj, mul_assoc, S.ι_comm, inv_mul_cancel_left]
        _ = S.ι (ofAdd (T k (T j a))) := by rw [hT])
    (fun i j hji hik => by
      show (S.X i * S.ι (ofAdd (b i k)))⁻¹ * (S.X j * S.ι (ofAdd (b j k))) *
          (S.X i * S.ι (ofAdd (b i k))) = S.X j * S.ι (ofAdd (b j k)) * S.ι (ofAdd (T k (b j i)))
      calc (S.X i * S.ι (ofAdd (b i k)))⁻¹ * (S.X j * S.ι (ofAdd (b j k))) *
            (S.X i * S.ι (ofAdd (b i k)))
          = S.ι (ofAdd (-b i k)) * ((S.X i)⁻¹ * S.X j * S.X i) *
            ((S.X i)⁻¹ * S.ι (ofAdd (b j k)) * S.X i) * S.ι (ofAdd (b i k)) := by
            rw [S.ι_neg]; group
        _ = S.ι (ofAdd (-b i k)) * S.X j * S.ι (ofAdd (b j i)) * S.ι (ofAdd (T i (b j k))) *
            S.ι (ofAdd (b i k)) := by
            rw [S.conj_X i j hji hik, S.conj_ι i hik]; group
        _ = S.X j * S.ι (ofAdd (T j (-b i k))) * S.ι (ofAdd (b j i)) *
            S.ι (ofAdd (T i (b j k))) * S.ι (ofAdd (b i k)) := by
            rw [S.ι_mul_X (hji.trans hik)]
        _ = S.X j * S.ι (ofAdd (-T j (b i k) + b j i + T i (b j k) + b i k)) := by
            rw [map_neg, S.ι_add, S.ι_add, S.ι_add]; simp only [mul_assoc]
        _ = S.X j * S.ι (ofAdd (b j k)) * S.ι (ofAdd (T k (b j i))) := by
            rw [hJ i j hji hik, S.ι_add, mul_assoc])).1

include hT hJ in
/-- The inverse of `fwd`. -/
def bwd : S.G →* S.G :=
  (S.lift (S.ι.comp (mulOf (T k).symm)) (fun j => S.X j * S.ι (ofAdd (-(T k).symm (b j k))))
    (fun j hj a => by
      show (S.X j * S.ι (ofAdd (-(T k).symm (b j k))))⁻¹ * S.ι (ofAdd ((T k).symm a)) *
          (S.X j * S.ι (ofAdd (-(T k).symm (b j k)))) = S.ι (ofAdd ((T k).symm (T j a)))
      have hc : T j ((T k).symm a) = (T k).symm (T j a) := by
        apply (T k).injective
        rw [AddEquiv.apply_symm_apply, hT, AddEquiv.apply_symm_apply]
      calc (S.X j * S.ι (ofAdd (-(T k).symm (b j k))))⁻¹ * S.ι (ofAdd ((T k).symm a)) *
            (S.X j * S.ι (ofAdd (-(T k).symm (b j k))))
          = (S.ι (ofAdd (-(T k).symm (b j k))))⁻¹ *
            ((S.X j)⁻¹ * S.ι (ofAdd ((T k).symm a)) * S.X j) *
            S.ι (ofAdd (-(T k).symm (b j k))) := by group
        _ = S.ι (ofAdd (T j ((T k).symm a))) := by
          rw [S.conj_ι j hj, mul_assoc, S.ι_comm, inv_mul_cancel_left]
        _ = S.ι (ofAdd ((T k).symm (T j a))) := by rw [hc])
    (fun i j hji hik => by
      have hc : ∀ l a, T l ((T k).symm a) = (T k).symm (T l a) := fun l a => by
        apply (T k).injective
        rw [AddEquiv.apply_symm_apply, hT, AddEquiv.apply_symm_apply]
      -- `hJ` transported by `(T k)⁻¹`
      have h := congrArg (T k).symm (hJ i j hji hik)
      simp only [map_add, map_neg, ← hc, AddEquiv.apply_symm_apply] at h
      show (S.X i * S.ι (ofAdd (-(T k).symm (b i k))))⁻¹ *
          (S.X j * S.ι (ofAdd (-(T k).symm (b j k)))) *
          (S.X i * S.ι (ofAdd (-(T k).symm (b i k)))) =
          S.X j * S.ι (ofAdd (-(T k).symm (b j k))) * S.ι (ofAdd ((T k).symm (b j i)))
      calc (S.X i * S.ι (ofAdd (-(T k).symm (b i k))))⁻¹ *
            (S.X j * S.ι (ofAdd (-(T k).symm (b j k)))) *
            (S.X i * S.ι (ofAdd (-(T k).symm (b i k))))
          = S.ι (ofAdd (- -(T k).symm (b i k))) * ((S.X i)⁻¹ * S.X j * S.X i) *
            ((S.X i)⁻¹ * S.ι (ofAdd (-(T k).symm (b j k))) * S.X i) *
            S.ι (ofAdd (-(T k).symm (b i k))) := by
            rw [S.ι_neg (-(T k).symm (b i k))]; group
        _ = S.ι (ofAdd (- -(T k).symm (b i k))) * S.X j * S.ι (ofAdd (b j i)) *
            S.ι (ofAdd (T i (-(T k).symm (b j k)))) * S.ι (ofAdd (-(T k).symm (b i k))) := by
            rw [S.conj_X i j hji hik, S.conj_ι i hik]; group
        _ = S.X j * S.ι (ofAdd (T j (- -(T k).symm (b i k)))) * S.ι (ofAdd (b j i)) *
            S.ι (ofAdd (T i (-(T k).symm (b j k)))) * S.ι (ofAdd (-(T k).symm (b i k))) := by
            rw [S.ι_mul_X (hji.trans hik)]
        _ = S.X j * S.ι (ofAdd (T j ((T k).symm (b i k)) + b j i - T i ((T k).symm (b j k)) -
            (T k).symm (b i k))) := by
            rw [neg_neg, map_neg]
            simp only [mul_assoc, ← S.ι_add]
            congr 3; abel
        _ = S.X j * S.ι (ofAdd (-(T k).symm (b j k))) * S.ι (ofAdd ((T k).symm (b j i))) := by
            rw [mul_assoc, ← S.ι_add]
            congr 3
            rw [← sub_eq_zero, ← neg_eq_zero]
            rw [← sub_eq_zero] at h
            rw [← h]; abel)).1

theorem fwd_ι (a : A) : fwd hT hJ S (S.ι (ofAdd a)) = S.ι (ofAdd (T k a)) :=
  (S.lift _ _ _ _).2.1 _

theorem fwd_X {j : ℕ} (hj : j < k) : fwd hT hJ S (S.X j) = S.X j * S.ι (ofAdd (b j k)) :=
  (S.lift _ _ _ _).2.2 j hj

theorem bwd_ι (a : A) : bwd hT hJ S (S.ι (ofAdd a)) = S.ι (ofAdd ((T k).symm a)) :=
  (S.lift _ _ _ _).2.1 _

theorem bwd_X {j : ℕ} (hj : j < k) :
    bwd hT hJ S (S.X j) = S.X j * S.ι (ofAdd (-(T k).symm (b j k))) :=
  (S.lift _ _ _ _).2.2 j hj

/-- Conjugation by the new generator, as an automorphism of stage `k`. -/
def conjAut : MulAut S.G :=
  MonoidHom.toMulEquiv (fwd hT hJ S) (bwd hT hJ S)
    (S.hom_ext _ _ (fun a => by
      obtain ⟨a, rfl⟩ := ofAdd.surjective a
      simp [fwd_ι, bwd_ι])
      (fun j hj => by
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply, fwd_X hT hJ S hj, map_mul,
          bwd_X hT hJ S hj, bwd_ι, mul_assoc, ← S.ι_add, neg_add_cancel, S.ι_zero, mul_one]))
    (S.hom_ext _ _ (fun a => by
      obtain ⟨a, rfl⟩ := ofAdd.surjective a
      simp [fwd_ι, bwd_ι])
      (fun j hj => by
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply, bwd_X hT hJ S hj, map_mul,
          fwd_X hT hJ S hj, fwd_ι, map_neg, AddEquiv.apply_symm_apply, mul_assoc, ← S.ι_add,
          add_neg_cancel, S.ι_zero, mul_one]))

theorem conjAut_apply (g : S.G) : conjAut hT hJ S g = fwd hT hJ S g := rfl

/-- The action of `ℤ` on stage `k`. -/
def act : Multiplicative ℤ →* MulAut S.G := zpowersHom (MulAut S.G) (conjAut hT hJ S)

/-- The new generator. -/
def newX : S.G ⋊[act hT hJ S] Multiplicative ℤ := SemidirectProduct.inr (ofAdd (-1))

theorem newX_conj (n : S.G) :
    (newX hT hJ S)⁻¹ * SemidirectProduct.inl n * newX hT hJ S =
      SemidirectProduct.inl (fwd hT hJ S n) := by
  have h := SemidirectProduct.inl_aut (φ := act hT hJ S) (ofAdd (1 : ℤ)) n
  have e : (newX hT hJ S)⁻¹ = SemidirectProduct.inr (ofAdd (1 : ℤ)) := by
    rw [newX, ← map_inv SemidirectProduct.inr]; rfl
  have e' : newX hT hJ S = SemidirectProduct.inr (ofAdd (1 : ℤ))⁻¹ := rfl
  rw [e, e', ← h]
  simp [act, conjAut_apply]

/-- Stage `k + 1`. -/
def succ : Stage T b (k + 1) where
  G := S.G ⋊[act hT hJ S] Multiplicative ℤ
  ι := SemidirectProduct.inl.comp S.ι
  X := fun j => if j = k then newX hT hJ S else SemidirectProduct.inl (S.X j)
  ι_injective := SemidirectProduct.inl_injective.comp S.ι_injective
  conj_ι := fun j hj a => by
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
    · rw [if_neg hj.ne]
      simp only [MonoidHom.comp_apply, ← map_inv, ← map_mul, S.conj_ι j hj]
    · rw [if_pos rfl]
      simp only [MonoidHom.comp_apply, newX_conj, fwd_ι]
  conj_X := fun i j hji hik => by
    have hjk : j ≠ k := by omega
    rw [if_neg hjk]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hik with hik | rfl
    · rw [if_neg hik.ne]
      simp only [MonoidHom.comp_apply, ← map_inv, ← map_mul, S.conj_X i j hji hik]
    · rw [if_pos rfl, newX_conj, fwd_X hT hJ S hji, map_mul, MonoidHom.comp_apply]
  nf := fun g => by
    obtain ⟨a, s, hs⟩ := S.nf g.left
    refine ⟨a, Function.update s k (-toAdd g.right), ?_⟩
    rw [List.range_succ, List.map_append, List.prod_append]
    have e1 : ((List.range k).map fun j =>
        (if j = k then newX hT hJ S else SemidirectProduct.inl (S.X j)) ^
          Function.update s k (-toAdd g.right) j) =
        ((List.range k).map fun j => S.X j ^ s j).map SemidirectProduct.inl := by
      rw [List.map_map]
      refine List.map_congr_left fun j hj => ?_
      have hjk : j ≠ k := (List.mem_range.mp hj).ne
      simp [hjk]
    have e2 : (newX hT hJ S) ^ (-toAdd g.right) =
        (SemidirectProduct.inr g.right : S.G ⋊[act hT hJ S] Multiplicative ℤ) := by
      rw [newX, ← map_zpow]
      congr 1
      rw [← ofAdd_toAdd g.right, ← ofAdd_zsmul]
      simp
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, ↓reduceIte,
      Function.update_self, e1, ← map_list_prod, e2]
    conv_lhs => rw [← SemidirectProduct.inl_left_mul_inr_right g, hs]
    simp only [MonoidHom.comp_apply, map_mul, mul_assoc]
  lift := fun {K} _ ψ y h1 h2 => by
    obtain ⟨f₁, hf₁⟩ := S.lift ψ y (fun j hj => h1 j (Nat.lt_succ_of_lt hj))
      (fun i j hji hik => h2 i j hji (Nat.lt_succ_of_lt hik))
    let f₂ : Multiplicative ℤ →* K := zpowersHom K (y k)⁻¹
    -- the generator of `ℤ` acts compatibly
    have base : ∀ n, f₁ (fwd hT hJ S n) = (MulAut.conj (y k)⁻¹) (f₁ n) := by
      intro n
      have := S.hom_ext (f₁.comp (fwd hT hJ S)) ((MulAut.conj (y k)⁻¹).toMonoidHom.comp f₁)
        (fun a => by
          obtain ⟨a, rfl⟩ := ofAdd.surjective a
          simp only [MonoidHom.comp_apply, fwd_ι, hf₁.1, MulEquiv.coe_toMonoidHom,
            MulAut.conj_apply, inv_inv]
          exact (h1 k (Nat.lt_succ_self k) a).symm)
        (fun j hj => by
          simp only [MonoidHom.comp_apply, fwd_X hT hJ S hj, map_mul, hf₁.1, hf₁.2 j hj,
            MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
          exact (h2 k j hj (Nat.lt_succ_self k)).symm)
      exact DFunLike.congr_fun this n
    refine ⟨SemidirectProduct.lift f₁ f₂ (fun g => ?_), fun a => ?_, fun j hj => ?_⟩
    · ext n
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, act, zpowersHom_apply, f₂,
        map_zpow]
      exact intertwine_zpow f₁ (conjAut hT hJ S) (MulAut.conj (y k)⁻¹)
        (fun n => by rw [conjAut_apply]; exact base n) _ n
    · simp [SemidirectProduct.lift_inl, hf₁.1]
    · show SemidirectProduct.lift f₁ f₂ _ (if j = k then newX hT hJ S else _) = y j
      by_cases hjk : j = k
      · subst hjk
        rw [if_pos rfl, newX, SemidirectProduct.lift_inr]
        simp [f₂]
      · rw [if_neg hjk, SemidirectProduct.lift_inl]
        exact hf₁.2 j (by omega)
  hom_ext := fun {K} _ f g hι hX => by
    apply SemidirectProduct.hom_ext
    · apply S.hom_ext
      · intro a; exact hι a
      · intro j hj
        have := hX j (Nat.lt_succ_of_lt hj)
        simp only [if_neg hj.ne] at this
        exact this
    · apply MonoidHom.ext_mint
      have := hX k (Nat.lt_succ_self k)
      simp only [↓reduceIte, newX] at this
      have e : (ofAdd (1 : ℤ) : Multiplicative ℤ) = (ofAdd (-1 : ℤ))⁻¹ := rfl
      simp only [MonoidHom.comp_apply, e, map_inv, this]

end Succ

/-- All stages up to `n`, given the Jacobi condition for indices below `n`. -/
def stage (hT : ∀ i j a, T i (T j a) = T j (T i a)) (n : ℕ)
    (hJ : ∀ i j k, j < i → i < k → k < n →
      -T j (b i k) + b j i + T i (b j k) + b i k = b j k + T k (b j i)) :
    (k : ℕ) → k ≤ n → Stage T b k
  | 0, _ => stage0 T b
  | k + 1, h => succ hT (fun i j hji hik => hJ i j k hji hik (by omega)) (stage hT n hJ k (by omega))

end GroupDimension.IterExt
