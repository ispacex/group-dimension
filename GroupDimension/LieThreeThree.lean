module

public import Mathlib.Algebra.Lie.Nilpotent
public import Mathlib.Algebra.Lie.Solvable
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.LinearAlgebra.StdBasis

@[expose] public section

/-!
# A Lie algebra of type `(3,3,1,1)` with `[M₂,M₂] ≠ 0` (Appendix A)

Remark 6.4(2) and Appendix A of the paper: Lemma 6.3 (`commutator_gamma_two_le_gamma_five`)
needs `γ₂/γ₃` to be generated by two elements; its Lie analogue fails with three (the group
counterexamples of order `3⁸` in Remark 6.4(2) are a computation and are not formalized here).
The paper's algebra `M = M₁ ⊕ M₂ ⊕ M₃ ⊕ M₄` has bases `M₁ = ⟨e,k₁,k₂⟩`, `M₂ = ⟨u₁,u₂,ρ⟩`,
`M₃ = ⟨t⟩`, `M₄ = ⟨w⟩` and the nonzero brackets
`[e,k₁] = u₁`, `[e,k₂] = u₂`, `[k₁,k₂] = ρ`, `[k₁,u₂] = t`, `[k₂,u₁] = -t`, `[e,ρ] = 2t`,
`[e,t] = w`, `[u₁,u₂] = w`
(over `𝔽₃` the paper writes `[e,ρ] = -t`, the same constant, see `two_eq_neg_one`).

We put it on `R⁸`, basis `b 0, …, b 7 = e, k₁, k₂, u₁, u₂, ρ, t, w`, over any commutative ring `R`:
the bracket is given in coordinates, so the Lie axioms are polynomial identities. Then:

* `lcs_eq`: the lower central series is `γ_{k+1} = F (k+1)`, the span of the basis vectors of
  degree `≥ k+1` (degrees `1,1,1,2,2,2,3,4`). In particular `γ₅ = 0` (`lcs_four`).
* `finrank_lcs` (over a field): `dim γ₁, …, γ₅ = 8, 5, 2, 1, 0`, i.e. type `(3,3,1,1)`.
* `lieSpan_eq_top`: the algebra is generated by `e, k₁, k₂`.
* `lie_lcs_one_ne_bot`, `derivedSeries_two_ne_bot`: `[γ₂,γ₂] ∋ w ≠ 0`, so the algebra is not
  metabelian.

`exists_lie_three_three` collects these over any field, e.g. `𝔽_p`. As in Mathlib,
`lowerCentralSeries R L L k` is `γ_{k+1}`.
-/

namespace GroupDimension.LieThreeThree

universe u

/-- The underlying module `R⁸` (a type synonym, so that the bracket below is not the pointwise
one). -/
def L (R : Type*) [CommRing R] : Type _ := Fin 8 → R

variable {R : Type*} [CommRing R]

instance : AddCommGroup (L R) := inferInstanceAs (AddCommGroup (Fin 8 → R))
instance : Module R (L R) := inferInstanceAs (Module R (Fin 8 → R))

@[simp] theorem add_apply (x y : L R) (i : Fin 8) : (x + y) i = x i + y i := rfl
@[simp] theorem sub_apply (x y : L R) (i : Fin 8) : (x - y) i = x i - y i := rfl
@[simp] theorem neg_apply (x : L R) (i : Fin 8) : (-x) i = -x i := rfl
@[simp] theorem zero_apply (i : Fin 8) : (0 : L R) i = 0 := rfl
@[simp] theorem smul_apply (c : R) (x : L R) (i : Fin 8) : (c • x) i = c * x i := rfl

theorem sum_apply {ι : Type*} (s : Finset ι) (f : ι → L R) (i : Fin 8) :
    (∑ j ∈ s, f j) i = ∑ j ∈ s, f j i :=
  Finset.sum_apply i s f

@[ext] theorem ext {x y : L R} (h : ∀ i, x i = y i) : x = y := funext h

/-- The bracket in coordinates (indices `0, …, 7` are `e, k₁, k₂, u₁, u₂, ρ, t, w`). -/
def br (x y : L R) : L R := ![0, 0, 0,
  x 0 * y 1 - x 1 * y 0,
  x 0 * y 2 - x 2 * y 0,
  x 1 * y 2 - x 2 * y 1,
  (x 1 * y 4 - x 4 * y 1) - (x 2 * y 3 - x 3 * y 2) + 2 * (x 0 * y 5 - x 5 * y 0),
  (x 0 * y 6 - x 6 * y 0) + (x 3 * y 4 - x 4 * y 3)]

section brApply
variable (x y : L R)
@[simp] theorem br_0 : br x y 0 = 0 := rfl
@[simp] theorem br_1 : br x y 1 = 0 := rfl
@[simp] theorem br_2 : br x y 2 = 0 := rfl
@[simp] theorem br_3 : br x y 3 = x 0 * y 1 - x 1 * y 0 := rfl
@[simp] theorem br_4 : br x y 4 = x 0 * y 2 - x 2 * y 0 := rfl
@[simp] theorem br_5 : br x y 5 = x 1 * y 2 - x 2 * y 1 := rfl
@[simp] theorem br_6 : br x y 6 =
    (x 1 * y 4 - x 4 * y 1) - (x 2 * y 3 - x 3 * y 2) + 2 * (x 0 * y 5 - x 5 * y 0) := rfl
@[simp] theorem br_7 : br x y 7 = (x 0 * y 6 - x 6 * y 0) + (x 3 * y 4 - x 4 * y 3) := rfl
end brApply

instance : LieRing (L R) where
  bracket := br
  add_lie x y z := by ext i; fin_cases i <;> simp <;> ring
  lie_add x y z := by ext i; fin_cases i <;> simp <;> ring
  lie_self x := by ext i; fin_cases i <;> simp <;> ring
  leibniz_lie x y z := by ext i; fin_cases i <;> simp <;> ring

instance : LieAlgebra R (L R) where
  lie_smul c x y := by ext i; fin_cases i <;> simp [Bracket.bracket] <;> ring

theorem lie_def (x y : L R) : ⁅x, y⁆ = br x y := rfl

/-- The basis vectors. -/
def b (i : Fin 8) : L R := Pi.single i 1

theorem b_apply (i j : Fin 8) : (b i : L R) j = if j = i then 1 else 0 := by
  simp [b, Pi.single_apply]

theorem decomp (x : L R) : x = ∑ i, x i • b i := by
  ext j
  rw [sum_apply, Finset.sum_eq_single j]
  · simp [b_apply]
  · intro c _ hc
    simp [b_apply, Ne.symm hc]
  · simp

/-! The brackets of the paper on basis vectors. -/

theorem lie_b01 : ⁅(b 0 : L R), (b 1 : L R)⁆ = (b 3 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b02 : ⁅(b 0 : L R), (b 2 : L R)⁆ = (b 4 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b12 : ⁅(b 1 : L R), (b 2 : L R)⁆ = (b 5 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b14 : ⁅(b 1 : L R), (b 4 : L R)⁆ = (b 6 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b23 : ⁅(b 2 : L R), (b 3 : L R)⁆ = -(b 6 : L R) := by
  ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b05 : ⁅(b 0 : L R), (b 5 : L R)⁆ = (2 : R) • (b 6 : L R) := by
  ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b06 : ⁅(b 0 : L R), (b 6 : L R)⁆ = (b 7 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]
theorem lie_b34 : ⁅(b 3 : L R), (b 4 : L R)⁆ = (b 7 : L R) := by ext i; fin_cases i <;> simp [lie_def, b_apply]

/-- Over `𝔽₃` the constant `2` of `[e,ρ] = 2t` is the paper's `-1`. -/
theorem two_eq_neg_one : (2 : ZMod 3) = -1 := by decide

/-- The degrees of the basis vectors. -/
def deg : Fin 8 → ℕ := ![1, 1, 1, 2, 2, 2, 3, 4]

theorem br_mem {k : ℕ} {y : L R} (h : ∀ i, deg i < k → y i = 0) (x : L R) :
    ∀ i, deg i < k + 1 → br x y i = 0 := by
  have h0 : 1 < k → y 0 = 0 := h 0
  have h1 : 1 < k → y 1 = 0 := h 1
  have h2 : 1 < k → y 2 = 0 := h 2
  have h3 : 2 < k → y 3 = 0 := h 3
  have h4 : 2 < k → y 4 = 0 := h 4
  have h5 : 2 < k → y 5 = 0 := h 5
  have h6 : 3 < k → y 6 = 0 := h 6
  intro i hi
  fin_cases i <;> simp [deg] at hi <;> simp (disch := omega) [h0, h1, h2, h3, h4, h5, h6]

/-- `F k`: the vectors whose coordinates of degree `< k` vanish, an ideal. -/
def F (k : ℕ) : LieIdeal R (L R) where
  carrier := {x | ∀ i, deg i < k → x i = 0}
  add_mem' {x y} hx hy i hi := by simp [hx i hi, hy i hi]
  zero_mem' _ _ := rfl
  smul_mem' c x hx i hi := by simp [hx i hi]
  lie_mem {x y} hy i hi := br_mem hy x i (by omega)

theorem mem_F {k : ℕ} {x : L R} : x ∈ F k ↔ ∀ i, deg i < k → x i = 0 := Iff.rfl

theorem b_mem_F {k : ℕ} {i : Fin 8} (h : k ≤ deg i) : (b i : L R) ∈ F k := by
  intro j hj
  have : j ≠ i := by rintro rfl; omega
  simp [b_apply, this]

theorem F_le {k : ℕ} (N : Submodule R (L R)) (h : ∀ i, k ≤ deg i → (b i : L R) ∈ N) {x : L R}
    (hx : x ∈ F k) : x ∈ N := by
  rw [decomp x]
  refine Submodule.sum_mem _ fun i _ => ?_
  by_cases hi : deg i < k
  · simp [hx i hi]
  · exact Submodule.smul_mem _ _ (h i (by omega))

theorem F_toSubmodule (k : ℕ) :
    ((F k : LieIdeal R (L R)) : Submodule R (L R)) =
      Submodule.span R (Set.range fun i : {i : Fin 8 // k ≤ deg i} => (b i.1 : L R)) := by
  apply le_antisymm
  · intro x hx
    exact F_le _ (fun i hi => Submodule.subset_span (Set.mem_range.2 ⟨⟨i, hi⟩, rfl⟩)) hx
  · rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact b_mem_F i.2

theorem F_one : (F 1 : LieIdeal R (L R)) = ⊤ := by
  ext x
  simp only [LieSubmodule.mem_top, iff_true]
  intro i hi
  fin_cases i <;> simp [deg] at hi

theorem F_five : (F 5 : LieIdeal R (L R)) = ⊥ := by
  ext x
  simp only [LieSubmodule.mem_bot]
  refine ⟨fun hx => ext fun i => hx i ?_, fun hx => hx ▸ (F 5).zero_mem⟩
  fin_cases i <;> simp [deg]

open LieModule in
/-- The lower central series: `γ_{k+1} = F (k+1)`. -/
theorem lcs_eq (k : ℕ) : lowerCentralSeries R (L R) (L R) k = F (k + 1) := by
  induction k with
  | zero => rw [lowerCentralSeries_zero, F_one]
  | succ k ih =>
    rw [lowerCentralSeries_succ, ih]
    apply le_antisymm
    · rw [LieSubmodule.lie_le_iff]
      intro x _ y hy
      exact br_mem hy x
    · intro x hx
      refine F_le ((⁅(⊤ : LieIdeal R (L R)), F (k + 1)⁆ : LieIdeal R (L R)) : Submodule R (L R)) ?_ hx
      have top : ∀ y : L R, y ∈ (⊤ : LieIdeal R (L R)) := LieSubmodule.mem_top
      intro i hi
      fin_cases i <;> simp [deg] at hi
      · change (b 3 : L R) ∈ _
        rw [← lie_b01]
        exact LieSubmodule.lie_mem_lie (top _) (b_mem_F (by simp [deg]; omega))
      · change (b 4 : L R) ∈ _
        rw [← lie_b02]
        exact LieSubmodule.lie_mem_lie (top _) (b_mem_F (by simp [deg]; omega))
      · change (b 5 : L R) ∈ _
        rw [← lie_b12]
        exact LieSubmodule.lie_mem_lie (top _) (b_mem_F (by simp [deg]; omega))
      · change (b 6 : L R) ∈ _
        rw [← lie_b14]
        exact LieSubmodule.lie_mem_lie (top _) (b_mem_F (by simp [deg]; omega))
      · change (b 7 : L R) ∈ _
        rw [← lie_b06]
        exact LieSubmodule.lie_mem_lie (top _) (b_mem_F (by simp [deg]; omega))

theorem lcs_four : LieModule.lowerCentralSeries R (L R) (L R) 4 = ⊥ := by
  rw [lcs_eq, F_five]

/-- The algebra is generated by `e, k₁, k₂`. -/
theorem lieSpan_eq_top :
    LieSubalgebra.lieSpan R (L R) {b 0, b 1, b 2} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have h0 : (b 0 : L R) ∈ LieSubalgebra.lieSpan R (L R) {b 0, b 1, b 2} :=
    LieSubalgebra.subset_lieSpan (by simp)
  have h1 : (b 1 : L R) ∈ LieSubalgebra.lieSpan R (L R) {b 0, b 1, b 2} :=
    LieSubalgebra.subset_lieSpan (by simp)
  have h2 : (b 2 : L R) ∈ LieSubalgebra.lieSpan R (L R) {b 0, b 1, b 2} :=
    LieSubalgebra.subset_lieSpan (by simp)
  have h4 := lie_b02 (R := R) ▸ LieSubalgebra.lie_mem _ h0 h2
  have h6 := lie_b14 (R := R) ▸ LieSubalgebra.lie_mem _ h1 h4
  refine F_le (k := 1) (LieSubalgebra.lieSpan R (L R) {b 0, b 1, b 2}).toSubmodule ?_
    (F_one (R := R) ▸ LieSubmodule.mem_top x)
  intro i _
  fin_cases i
  · exact h0
  · exact h1
  · exact h2
  · exact lie_b01 (R := R) ▸ LieSubalgebra.lie_mem _ h0 h1
  · exact h4
  · exact lie_b12 (R := R) ▸ LieSubalgebra.lie_mem _ h1 h2
  · exact h6
  · exact lie_b06 (R := R) ▸ LieSubalgebra.lie_mem _ h0 h6

theorem b_ne_zero [Nontrivial R] (i : Fin 8) : (b i : L R) ≠ 0 := by
  intro h
  simpa [b_apply] using congrArg (· i) h

/-- `[γ₂, γ₂] ≠ 0`: it contains `w = [u₁, u₂]`. -/
theorem lie_lcs_one_ne_bot [Nontrivial R] :
    ⁅LieModule.lowerCentralSeries R (L R) (L R) 1, LieModule.lowerCentralSeries R (L R) (L R) 1⁆
      ≠ ⊥ := by
  intro h
  have : (b 7 : L R) ∈ ⁅LieModule.lowerCentralSeries R (L R) (L R) 1,
      LieModule.lowerCentralSeries R (L R) (L R) 1⁆ := by
    rw [← lie_b34, lcs_eq]
    exact LieSubmodule.lie_mem_lie (b_mem_F (by simp [deg])) (b_mem_F (by simp [deg]))
  rw [h, LieSubmodule.mem_bot] at this
  exact b_ne_zero 7 this

/-- The algebra is not metabelian. -/
theorem derivedSeries_two_ne_bot [Nontrivial R] : LieAlgebra.derivedSeries R (L R) 2 ≠ ⊥ := by
  have h1 : LieAlgebra.derivedSeries R (L R) 1 = LieModule.lowerCentralSeries R (L R) (L R) 1 := by
    rw [LieAlgebra.derivedSeries_def, LieAlgebra.derivedSeriesOfIdeal_succ,
      LieAlgebra.derivedSeriesOfIdeal_zero, LieModule.lowerCentralSeries_succ,
      LieModule.lowerCentralSeries_zero]
  rw [LieAlgebra.derivedSeries_def, LieAlgebra.derivedSeriesOfIdeal_succ,
    ← LieAlgebra.derivedSeries_def, h1]
  exact lie_lcs_one_ne_bot

section Field

variable {K : Type*} [Field K]

theorem finrank_F (k : ℕ) :
    Module.finrank K ((F k : LieIdeal K (L K)) : Submodule K (L K)) =
      Fintype.card {i : Fin 8 // k ≤ deg i} := by
  rw [F_toSubmodule, finrank_span_eq_card]
  have := (Pi.basisFun K (Fin 8)).linearIndependent.comp
    (Subtype.val : {i : Fin 8 // k ≤ deg i} → Fin 8) Subtype.val_injective
  have e : (fun i : {i : Fin 8 // k ≤ deg i} => (b i.1 : L K)) =
      (Pi.basisFun K (Fin 8)) ∘ Subtype.val := by
    funext i
    exact (Pi.basisFun_apply K (Fin 8) i.1).symm
  rw [e]
  exact this

theorem finrank_lcs_eq (k : ℕ) :
    Module.finrank K
      ((LieModule.lowerCentralSeries K (L K) (L K) k : LieIdeal K (L K)) : Submodule K (L K)) =
      Fintype.card {i : Fin 8 // k + 1 ≤ deg i} := by
  rw [lcs_eq, finrank_F]

/-- `dim γ₁, …, γ₅ = 8, 5, 2, 1, 0`: type `(3,3,1,1)`. -/
theorem finrank_lcs :
    (List.range 5).map (fun k => Module.finrank K
      ((LieModule.lowerCentralSeries K (L K) (L K) k : LieIdeal K (L K)) : Submodule K (L K)))
      = [8, 5, 2, 1, 0] := by
  simp only [finrank_lcs_eq]
  decide

theorem finrank_L : Module.finrank K (L K) = 8 := Module.finrank_fin_fun K

end Field

/-- **Appendix A.** Over every field `K` (the paper takes `K = 𝔽_p`, `p` odd) there is a Lie
algebra of dimension `8`, generated by three elements, with `dim γ_k/γ_{k+1} = 3, 3, 1, 1` for
`k = 1, …, 4` (`dim γ_k = 8, 5, 2, 1, 0` for `k = 1, …, 5`), `γ₅ = 0` and `[γ₂, γ₂] ≠ 0`. (In
characteristic `2` the constant `2` of `[e,ρ]` vanishes; the statement still holds, but that is not
the case of the paper.) -/
theorem exists_lie_three_three (K : Type u) [Field K] :
    ∃ (M : Type u) (_ : LieRing M) (_ : LieAlgebra K M) (x : Fin 3 → M),
      Module.finrank K M = 8 ∧
      LieSubalgebra.lieSpan K M (Set.range x) = ⊤ ∧
      (List.range 5).map (fun k => Module.finrank K
        ((LieModule.lowerCentralSeries K M M k : LieIdeal K M) : Submodule K M)) =
        [8, 5, 2, 1, 0] ∧
      LieModule.lowerCentralSeries K M M 4 = ⊥ ∧
      ⁅LieModule.lowerCentralSeries K M M 1, LieModule.lowerCentralSeries K M M 1⁆ ≠ ⊥ := by
  have hx : Set.range ![(b 0 : L K), b 1, b 2] = {b 0, b 1, b 2} := by
    ext x
    simp only [Set.mem_range, Fin.exists_fin_succ, Fin.exists_fin_zero, Set.mem_insert_iff,
      Set.mem_singleton_iff]
    simp [eq_comm]
  refine ⟨L K, inferInstance, inferInstance, ![b 0, b 1, b 2], finrank_L, ?_, finrank_lcs,
    lcs_four, lie_lcs_one_ne_bot⟩
  rw [hx]
  exact lieSpan_eq_top

end GroupDimension.LieThreeThree
