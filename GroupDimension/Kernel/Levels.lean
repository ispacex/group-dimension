module

public import GroupDimension.Kernel.Sieve

@[expose] public section

/-!
# `J_k` level by level, and the generators of `π_k(J_k)` (fast-core paper, §6.13; MATH-308)

`cflint-fast-core`, `docs/analysis.md`, §6.13(b) (the method of `gpu/stdmono.py`):

> **Lemma N1.** `J_k = span{μ(r) − 1 : r ∈ R_0} + Σ_j (J_{k−1} a_j + a_j J_{k−1})`, the products taken
> in `A_k`. …
>
> **Lemma N2.** `π_k(J_k)` is generated by `π_k` of: (i) `μ(r) − 1`; (ii) `t a_j`, `a_j t` for the rows
> `t` of the Howell form of `π_{k−1}(J_{k−1})` with a non-unit pivot; (iii) the *overlaps*
> `a_j (u − NF_{k−1}(u))` for `u ∉ S_{k−1}` with `u[:−1] ∈ S_{k−1}` and `a_j u[:−1] ∉ S_{k−1}`.

Here the lower level is `k` and the upper one `k + 1` (the paper's `k − 1` and `k`). The notation is
that of `GroupDimension.Kernel.Magnus` (`A X n`, `mon`, `aA`, `muF`, `Jspan`) and
`GroupDimension.Kernel.Sieve` (`truncA`). Everything is over `ℤ`.

## What is proved

* **Lemma N1** (`lemmaN1`). `shR k j z` (`shL k j z`) is `z · a_j` (`a_j · z`) for `z ∈ A_k`, taken in
  `A_{k+1}` through any lift of `z` (`shR_eq`, `shL_eq`: it does not depend on the lift, because the
  top degree of a lift dies in the product, `mul_aA_eq_zero`). Then
  `J_{k+1} = span({μ(r) − 1} ∪ {z a_j : z ∈ J_k} ∪ {a_j z : z ∈ J_k})`.
  With a generating set `B` of `J_k` (`lemmaN1_span`): `J_{k+1} = span({μ(r) − 1} ∪ B a ∪ a B)`.
* **The projection** (§6.13(b), "Candidates and the projection"), for any `ℤ`-linear `π` with
  `x − π x ∈ J`: `π(J) ⊆ J` (`map_le_of_proj`), `x ∈ J ⟺ π x ∈ π(J)` (`mem_iff_map_proj`), and, if `π`
  is idempotent, `range π / π(J) ≅ M / J` (`projQuotEquiv`; the paper's `A_k^+/J_k ≅ ℤ^{C_k}/π_k(J_k)`
  with `range π` in place of `ℤ^{C_k}`).
* **Lemma N2** (`lemmaN2`, and `mem_J_iff_N2` with the projection), in the abstract form below:
  `π(J_{k+1}) = span(π '' N2gens)`, `N2gens` = (i) the relators `μ(r) − 1`, (ii) `t a_j` and `a_j t` for
  `t ∈ T`, (iii) `a_j g_u` for `u = u' a_l` non-standard with `u' ∈ S` and `a_j u' ∉ S`.

  The data of level `k` are those of the reduced Howell form of `J_k` in all columns, as the paper's
  proof uses them (`HowellData`): the standard monomials `S` (with `1 ∈ S`: the empty word is not a
  column), for every non-standard word `u` (`NS k S`: length `< k`, not in `S`) the unit row
  `g u = u − NF(u)` (`g u ∈ J_k`, `u − g u` on the columns after `u`), the torsion rows `T ⊆ J_k`;
  the rows generate `J_k` (`gen`), and the **Howell property** (`howell`): an element of `J_k` on the
  columns after `u` is a combination of the `g x`, `x` after `u`, and of `T`. The columns are numbered
  by `col` (bounded on the words of length `< k`, compatible with `· a_l` on the right: true for the
  order "by degree, then the word, first letter most significant" of `stdmono.py`).
  The map `π` is any `ℤ`-linear map that obeys the two rewriting rules of `stdmono.py`
  (`RewriteRules`): the **prefix rule** `π(u a_l) = π(NF(u) a_l)` for non-standard `u`, i.e.
  `π(g_u a_l) = 0`; the **suffix rule** `π(a_j u) = π(a_j NF(u))` when the prefix `a_j u[:−1]` of
  `a_j u` is standard, i.e. `π(a_j g_u) = 0`. The proof is the paper's: by N1 with the generating set
  `{g_u} ∪ T`, the prefix rule kills `π(g_u a_l)`, and `π(a_j g_u)` is either killed by the suffix rule,
  an overlap (iii), or (`u' ∉ S`) `π((a_j g_{u'}) a_l) + π(a_j z)` with `z = g_u − g_{u'} a_l` on the
  columns after `u`; by the Howell property and downward induction on the column of `u` both lie in
  the span (`shL_mul_aA`, `later_mul_aA`).

## What is not formalized here

* That the computed objects satisfy these hypotheses: that the rows of `stdmono.py`/`sparse_howell.c`
  form a reduced Howell form (`HowellData`), that `S_k` is closed under prefixes and suffixes and
  `S_k ⊆ C_k`, that the rewriting terminates, that its result `π_k` obeys the two rules and
  `x − π_k x ∈ J_k`, is idempotent and has range `ℤ^{C_k}` (here these are hypotheses on `π`); the
  truncation check of the Howell form (§3.4), `NF_k` and the tables `T_k[p]`.
* Arithmetic modulo `2^E` (the paper's N1 also holds there; here everything is over `ℤ`).
-/

namespace GroupDimension.Kernel.Levels

noncomputable section

open MonoidAlgebra GroupDimension.Kernel.Magnus GroupDimension.Kernel.Sieve

variable {X : Type*}

/-! ## Words -/

theorem eq_one_or_eq_mul_of (v : FreeMonoid X) : v = 1 ∨ ∃ v' j, v = v' * FreeMonoid.of j := by
  rcases List.eq_nil_or_concat (FreeMonoid.toList v) with h | ⟨L, b, h⟩
  · exact Or.inl (FreeMonoid.toList.injective (h.trans FreeMonoid.toList_one.symm))
  · refine Or.inr ⟨FreeMonoid.ofList L, b, FreeMonoid.toList.injective ?_⟩
    rw [h, FreeMonoid.toList_mul, FreeMonoid.toList_ofList, FreeMonoid.toList_of,
      List.concat_eq_append]

theorem eq_one_or_eq_of_mul (u : FreeMonoid X) : u = 1 ∨ ∃ j u', u = FreeMonoid.of j * u' := by
  rcases h : FreeMonoid.toList u with _ | ⟨j, L⟩
  · exact Or.inl (FreeMonoid.toList.injective (h.trans FreeMonoid.toList_one.symm))
  · refine Or.inr ⟨j, FreeMonoid.ofList L, FreeMonoid.toList.injective ?_⟩
    rw [h, FreeMonoid.toList_mul, FreeMonoid.toList_of, FreeMonoid.toList_ofList]
    rfl

/-! ## From level `k` to level `k + 1`: the shifts `z a_j`, `a_j z` -/

/-- The truncation `A_{k+1} → A_k`. -/
abbrev tr (k : ℕ) : A X (k + 1) →+* A X k := truncA (Nat.le_succ k)

theorem tr_mon (k : ℕ) (u : FreeMonoid X) : tr k (mon (k + 1) u) = mon k u := trunc_mon _ u

theorem tr_aA (k : ℕ) (j : X) : tr k (aA (k + 1) j) = aA k j := trunc_mon _ _

theorem single_of_mem_Ik_one (j : X) : (single (FreeMonoid.of j) 1 : FA X) ∈ Ik X 1 :=
  single_mem_Ik (by rw [FreeMonoid.length_of]) 1

/-- The top degree of `A_{k+1}` (the kernel of the truncation) dies after `· a_j`. -/
theorem mul_aA_eq_zero {k : ℕ} {x : A X (k + 1)} (hx : tr k x = 0) (j : X) :
    x * aA (k + 1) j = 0 := by
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [tr, trunc_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
  show Ideal.Quotient.mk _ y * Ideal.Quotient.mk _ (single (FreeMonoid.of j) 1) = 0
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact mem_Itr.mpr (mul_mem_Ik_add (mem_Itr.mp hx) (single_of_mem_Ik_one j))

/-- The top degree of `A_{k+1}` dies after `a_j ·`. -/
theorem aA_mul_eq_zero {k : ℕ} {x : A X (k + 1)} (hx : tr k x = 0) (j : X) :
    aA (k + 1) j * x = 0 := by
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [tr, trunc_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
  show Ideal.Quotient.mk _ (single (FreeMonoid.of j) 1) * Ideal.Quotient.mk _ y = 0
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  have h := mul_mem_Ik_add (single_of_mem_Ik_one j) (mem_Itr.mp hx)
  rw [Nat.add_comm] at h
  exact mem_Itr.mpr h

theorem mul_aA_eq_of_tr_eq {k : ℕ} {x x' : A X (k + 1)} (h : tr k x = tr k x') (j : X) :
    x * aA (k + 1) j = x' * aA (k + 1) j := by
  rw [← sub_eq_zero, ← sub_mul]
  exact mul_aA_eq_zero (by rw [map_sub, h, sub_self]) j

theorem aA_mul_eq_of_tr_eq {k : ℕ} {x x' : A X (k + 1)} (h : tr k x = tr k x') (j : X) :
    aA (k + 1) j * x = aA (k + 1) j * x' := by
  rw [← sub_eq_zero, ← mul_sub]
  exact aA_mul_eq_zero (by rw [map_sub, h, sub_self]) j

/-- A lift `A_k → A_{k+1}` (a section of the truncation; not additive in general). -/
def liftA (k : ℕ) (y : A X k) : A X (k + 1) :=
  Function.surjInv (trunc_surjective (X := X) (Nat.le_succ k)) y

theorem tr_liftA (k : ℕ) (y : A X k) : tr k (liftA k y) = y :=
  Function.surjInv_eq (trunc_surjective (X := X) (Nat.le_succ k)) y

/-- `z ↦ z a_j`, `A_k → A_{k+1}`: a lift of `z` times `a_j` (independent of the lift, `shR_eq`). -/
def shR (k : ℕ) (j : X) : A X k →+ A X (k + 1) where
  toFun y := liftA k y * aA (k + 1) j
  map_zero' :=
    (mul_aA_eq_of_tr_eq (x := liftA k 0) (x' := 0) (by rw [tr_liftA, map_zero]) j).trans
      (zero_mul _)
  map_add' y y' := by
    rw [← add_mul]
    exact mul_aA_eq_of_tr_eq (by rw [map_add, tr_liftA, tr_liftA, tr_liftA]) j

/-- `z ↦ a_j z`, `A_k → A_{k+1}` (independent of the lift, `shL_eq`). -/
def shL (k : ℕ) (j : X) : A X k →+ A X (k + 1) where
  toFun y := aA (k + 1) j * liftA k y
  map_zero' :=
    (aA_mul_eq_of_tr_eq (x := liftA k 0) (x' := 0) (by rw [tr_liftA, map_zero]) j).trans
      (mul_zero _)
  map_add' y y' := by
    rw [← mul_add]
    exact aA_mul_eq_of_tr_eq (by rw [map_add, tr_liftA, tr_liftA, tr_liftA]) j

/-- `z a_j` with any lift `x` of `z`. -/
theorem shR_eq {k : ℕ} {x : A X (k + 1)} {y : A X k} (h : tr k x = y) (j : X) :
    shR k j y = x * aA (k + 1) j :=
  mul_aA_eq_of_tr_eq (by rw [tr_liftA, h]) j

/-- `a_j z` with any lift `x` of `z`. -/
theorem shL_eq {k : ℕ} {x : A X (k + 1)} {y : A X k} (h : tr k x = y) (j : X) :
    shL k j y = aA (k + 1) j * x :=
  aA_mul_eq_of_tr_eq (by rw [tr_liftA, h]) j

/-- `a_j (y a_l) = (a_j y) a_l` across the levels. -/
theorem shL_mul_aA (k : ℕ) (j l : X) (y : A X k) :
    shL k j (y * aA k l) = shR k l (aA k j * y) := by
  rw [shL_eq (x := liftA k y * aA (k + 1) l) (by rw [map_mul, tr_liftA, tr_aA]), ← mul_assoc,
    shR_eq (x := aA (k + 1) j * liftA k y) (by rw [map_mul, tr_liftA, tr_aA])]

variable (R0 : Set (FreeGroup X))

variable {R0} in
theorem shR_mem {k : ℕ} (j : X) {z : A X k} (hz : z ∈ Jspan R0 k) :
    shR k j z ∈ Jspan R0 (k + 1) := by
  obtain ⟨x, hx, rfl⟩ := (mem_Jideal_iff_trunc R0 (Nat.le_succ k) z).mp (mem_Jideal.mpr hz)
  rw [shR_eq (x := x) rfl]
  exact Jspan_mul_right _ (mem_Jideal.mp hx)

variable {R0} in
theorem shL_mem {k : ℕ} (j : X) {z : A X k} (hz : z ∈ Jspan R0 k) :
    shL k j z ∈ Jspan R0 (k + 1) := by
  obtain ⟨x, hx, rfl⟩ := (mem_Jideal_iff_trunc R0 (Nat.le_succ k) z).mp (mem_Jideal.mpr hz)
  rw [shL_eq (x := x) rfl]
  exact Jspan_mul_left _ (mem_Jideal.mp hx)

theorem tr_mem {k : ℕ} {x : A X (k + 1)} (hx : x ∈ Jspan R0 (k + 1)) : tr k x ∈ Jspan R0 k :=
  mem_Jideal.mp (trunc_mem_Jideal R0 (Nat.le_succ k) (mem_Jideal.mpr hx))

/-! ## Lemma N1 -/

/-- The relators `μ(r) − 1` in `A_n`. -/
def relGens (n : ℕ) : Set (A X n) := {y | ∃ r ∈ R0, y = (muF n r : A X n) - 1}

/-- The generators of Lemma N1 built on a set `B ⊆ A_k`: the relators, `B a_j` and `a_j B`. -/
def N1gens (k : ℕ) (B : Set (A X k)) : Set (A X (k + 1)) :=
  relGens R0 (k + 1) ∪ {y | ∃ j, ∃ b ∈ B, y = shR k j b} ∪ {y | ∃ j, ∃ b ∈ B, y = shL k j b}

/-- **Lemma N1**: `J_{k+1} = span{μ(r) − 1} + Σ_j (J_k a_j + a_j J_k)`, the products in `A_{k+1}`. -/
theorem lemmaN1 (k : ℕ) : Jspan R0 (k + 1) = Submodule.span ℤ (N1gens R0 k (Jspan R0 k)) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨r, hr, u, v, rfl⟩
    have hx : ∀ u' v' : FreeMonoid X,
        mon (k + 1) u' * ((muF (k + 1) r : A X (k + 1)) - 1) * mon (k + 1) v' ∈ Jspan R0 (k + 1) :=
      fun u' v' => Submodule.subset_span ⟨r, hr, u', v', rfl⟩
    rcases eq_one_or_eq_mul_of v with rfl | ⟨v', j, rfl⟩
    · rcases eq_one_or_eq_of_mul u with rfl | ⟨j, u', rfl⟩
      · refine Submodule.subset_span (Or.inl (Or.inl ⟨r, hr, ?_⟩))
        simp only [mon_one, one_mul, mul_one]
      · refine Submodule.subset_span (Or.inr ⟨j, _, tr_mem R0 (hx u' 1), ?_⟩)
        rw [shL_eq rfl, mon_mul]
        simp only [mul_assoc]
    · refine Submodule.subset_span (Or.inl (Or.inr ⟨j, _, tr_mem R0 (hx u v'), ?_⟩))
      rw [shR_eq rfl, mon_mul]
      simp only [mul_assoc]
  · rw [Submodule.span_le]
    rintro _ ((⟨r, hr, rfl⟩ | ⟨j, z, hz, rfl⟩) | ⟨j, z, hz, rfl⟩)
    · exact mem_Jideal.mp (muF_sub_one_mem_J (k + 1) hr)
    · exact shR_mem j hz
    · exact shL_mem j hz

theorem mem_span_image_of_mem_span {M N : Type*} [AddCommGroup M] [AddCommGroup N] (f : M →+ N)
    {B : Set M} {z : M} (hz : z ∈ Submodule.span ℤ B) : f z ∈ Submodule.span ℤ (f '' B) := by
  have h := Submodule.mem_map_of_mem (f := f.toIntLinearMap) hz
  rw [Submodule.map_span] at h
  exact h

/-- **Lemma N1** with a generating set `B` of `J_k`: `J_{k+1} = span({μ(r) − 1} ∪ B a ∪ a B)`. -/
theorem lemmaN1_span (k : ℕ) {B : Set (A X k)} (hB : Submodule.span ℤ B = Jspan R0 k) :
    Jspan R0 (k + 1) = Submodule.span ℤ (N1gens R0 k B) := by
  have hBJ : B ⊆ Jspan R0 k := fun b hb => by rw [← hB]; exact Submodule.subset_span hb
  apply le_antisymm
  · rw [lemmaN1 R0 k, Submodule.span_le]
    rintro _ ((hr | ⟨j, z, hz, rfl⟩) | ⟨j, z, hz, rfl⟩)
    · exact Submodule.subset_span (Or.inl (Or.inl hr))
    · rw [← hB] at hz
      refine Submodule.span_mono ?_ (mem_span_image_of_mem_span (shR k j) hz)
      rintro _ ⟨b, hb, rfl⟩
      exact Or.inl (Or.inr ⟨j, b, hb, rfl⟩)
    · rw [← hB] at hz
      refine Submodule.span_mono ?_ (mem_span_image_of_mem_span (shL k j) hz)
      rintro _ ⟨b, hb, rfl⟩
      exact Or.inr ⟨j, b, hb, rfl⟩
  · rw [Submodule.span_le]
    rintro _ ((⟨r, hr, rfl⟩ | ⟨j, b, hb, rfl⟩) | ⟨j, b, hb, rfl⟩)
    · exact mem_Jideal.mp (muF_sub_one_mem_J (k + 1) hr)
    · exact shR_mem j (hBJ hb)
    · exact shL_mem j (hBJ hb)

/-! ## A projection with kernel in `J` -/

section Proj

variable {M : Type*} [AddCommGroup M] (J : Submodule ℤ M) (π : M →ₗ[ℤ] M)

/-- If `x − π x ∈ J` for all `x`, then `π(J) ⊆ J`. -/
theorem map_le_of_proj (hπ : ∀ x, x - π x ∈ J) : J.map π ≤ J := by
  rintro _ ⟨w, hw, rfl⟩
  have h := J.sub_mem hw (hπ w)
  rwa [sub_sub_cancel] at h

/-- `x ∈ J ⟺ π x ∈ π(J)` for a map `π` with `x − π x ∈ J`. -/
theorem mem_iff_map_proj (hπ : ∀ x, x - π x ∈ J) (x : M) : x ∈ J ↔ π x ∈ J.map π := by
  refine ⟨fun hx => Submodule.mem_map_of_mem hx, fun hx => ?_⟩
  have h := J.add_mem (hπ x) (map_le_of_proj J π hπ hx)
  rwa [sub_add_cancel] at h

/-- For an idempotent `π` with `x − π x ∈ J`: `range π / π(J) ≅ M / J`. -/
def projQuotEquiv (hπ : ∀ x, x - π x ∈ J) (hid : ∀ x, π (π x) = π x) :
    (LinearMap.range π ⧸ (J.map π).comap (LinearMap.range π).subtype) ≃ₗ[ℤ] M ⧸ J :=
  let f : LinearMap.range π →ₗ[ℤ] M ⧸ J := J.mkQ ∘ₗ (LinearMap.range π).subtype
  have hf : Function.Surjective f := by
    intro z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective J z
    refine ⟨⟨π x, LinearMap.mem_range_self π x⟩, ?_⟩
    show Submodule.Quotient.mk (π x) = Submodule.Quotient.mk x
    rw [Submodule.Quotient.eq, ← neg_sub]
    exact J.neg_mem (hπ x)
  have hker : LinearMap.ker f = (J.map π).comap (LinearMap.range π).subtype := by
    ext ⟨y, hy⟩
    obtain ⟨x', rfl⟩ := LinearMap.mem_range.mp hy
    rw [LinearMap.mem_ker, Submodule.mem_comap]
    show Submodule.Quotient.mk (π x') = (0 : M ⧸ J) ↔ π x' ∈ J.map π
    rw [Submodule.Quotient.mk_eq_zero]
    exact ⟨fun h => ⟨π x', h, hid x'⟩, fun h => map_le_of_proj J π hπ h⟩
  (Submodule.quotEquivOfEq _ _ hker.symm).trans (f.quotKerEquivOfSurjective hf)

end Proj

/-! ## Lemma N2 -/

/-- The non-standard words of level `k`: length `< k`, not in `S`. -/
def NS (k : ℕ) (S : Set (FreeMonoid X)) : Set (FreeMonoid X) := {u | u.length < k ∧ u ∉ S}

theorem mem_NS {k : ℕ} {S : Set (FreeMonoid X)} {u : FreeMonoid X} :
    u ∈ NS k S ↔ u.length < k ∧ u ∉ S := Iff.rfl

/-- The span of the words in the columns after `u` (numbered by `col`). -/
def later (k : ℕ) (col : FreeMonoid X → ℕ) (u : FreeMonoid X) : Submodule ℤ (A X k) :=
  Submodule.span ℤ {y | ∃ v, col u < col v ∧ y = mon k v}

theorem later_mul_aA {k : ℕ} {col : FreeMonoid X → ℕ}
    (hcol : ∀ u v : FreeMonoid X, ∀ l, col u < col v →
      col (u * FreeMonoid.of l) < col (v * FreeMonoid.of l))
    {u : FreeMonoid X} (l : X) {y : A X k} (hy : y ∈ later k col u) :
    y * aA k l ∈ later k col (u * FreeMonoid.of l) := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨v, hv, rfl⟩ := hy
    exact Submodule.subset_span ⟨v * FreeMonoid.of l, hcol u v l hv, (mon_mul k v _).symm⟩
  | zero => rw [zero_mul]; exact zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact add_mem ha hb
  | smul c a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c ha

/-- The data of level `k`: a reduced Howell form of `J_k` in all columns, as the proof of N2 uses it.
`S`: the standard monomials; `g u = u − NF(u)` for the non-standard words `u`; `T`: the torsion rows
(non-unit pivot); `col`: the column numbering. -/
structure HowellData (k : ℕ) (S : Set (FreeMonoid X)) (g : FreeMonoid X → A X k)
    (T : Set (A X k)) (col : FreeMonoid X → ℕ) : Prop where
  /-- The empty word (not a column) counts as standard. -/
  one_mem : (1 : FreeMonoid X) ∈ S
  /-- The unit rows lie in `J_k`. -/
  g_mem : ∀ u ∈ NS k S, g u ∈ Jspan R0 k
  /-- `NF(u) = u − g u` lies on the columns after `u`. -/
  g_lead : ∀ u ∈ NS k S, mon k u - g u ∈ later k col u
  /-- The torsion rows lie in `J_k`. -/
  T_mem : T ⊆ Jspan R0 k
  /-- The rows generate `J_k`. -/
  gen : Jspan R0 k ≤ Submodule.span ℤ (g '' NS k S ∪ T)
  /-- The Howell property: an element of `J_k` on the columns after `u` is a combination of the
  unit rows of the columns after `u` and of the torsion rows. -/
  howell : ∀ u ∈ NS k S, ∀ z ∈ Jspan R0 k, z ∈ later k col u →
    z ∈ Submodule.span ℤ (g '' {x | x ∈ NS k S ∧ col u < col x} ∪ T)
  /-- The columns of the words of length `< k` are bounded. -/
  col_bdd : ∃ m, ∀ u : FreeMonoid X, u.length < k → col u < m
  /-- `· a_l` keeps the column order. -/
  col_mul : ∀ u v : FreeMonoid X, ∀ l, col u < col v →
    col (u * FreeMonoid.of l) < col (v * FreeMonoid.of l)

/-- The rewriting rules of `π_{k+1}` (`stdmono.py`, `project`), on the unit rows `g u = u − NF(u)`. -/
structure RewriteRules (k : ℕ) (S : Set (FreeMonoid X)) (g : FreeMonoid X → A X k)
    (π : A X (k + 1) →ₗ[ℤ] A X (k + 1)) : Prop where
  /-- The prefix rule `u a_l ↦ NF(u) a_l` for `u` non-standard. -/
  prefix_rule : ∀ u ∈ NS k S, ∀ l, π (shR k l (g u)) = 0
  /-- The suffix rule `a_j u ↦ a_j NF(u)` for `u` non-standard when the prefix `a_j u[:−1]` of `a_j u`
  is standard. -/
  suffix_rule : ∀ u ∈ NS k S, ∀ u' l j, u = u' * FreeMonoid.of l →
    FreeMonoid.of j * u' ∈ S → π (shL k j (g u)) = 0

/-- The generators of `π_{k+1}(J_{k+1})` in Lemma N2 (before `π`): (i) the relators; (ii) both shifts
of the torsion rows; (iii) the overlaps `a_j g_u`, `u = u' a_l` non-standard, `u' ∈ S`, `a_j u' ∉ S`. -/
def N2gens (k : ℕ) (S : Set (FreeMonoid X)) (g : FreeMonoid X → A X k) (T : Set (A X k)) :
    Set (A X (k + 1)) :=
  relGens R0 (k + 1) ∪ {y | ∃ j, ∃ t ∈ T, y = shR k j t ∨ y = shL k j t} ∪
    {y | ∃ j, ∃ u ∈ NS k S, ∃ u' l, u = u' * FreeMonoid.of l ∧ u' ∈ S ∧
      FreeMonoid.of j * u' ∉ S ∧ y = shL k j (g u)}

theorem N2gens_subset {k : ℕ} {S : Set (FreeMonoid X)} {g : FreeMonoid X → A X k}
    {T : Set (A X k)} {col : FreeMonoid X → ℕ} (hH : HowellData R0 k S g T col) :
    N2gens R0 k S g T ⊆ Jspan R0 (k + 1) := by
  rintro _ ((⟨r, hr, rfl⟩ | ⟨j, t, ht, rfl | rfl⟩) | ⟨j, u, hu, u', l, -, -, -, rfl⟩)
  · exact mem_Jideal.mp (muF_sub_one_mem_J (k + 1) hr)
  · exact shR_mem j (hH.T_mem ht)
  · exact shL_mem j (hH.T_mem ht)
  · exact shL_mem j (hH.g_mem u hu)

/-- **Lemma N2**: `π(J_{k+1})` is spanned by `π` of the relators, of both shifts of the torsion rows
and of the overlaps, for any `ℤ`-linear `π` obeying the prefix and suffix rules. -/
theorem lemmaN2 {k : ℕ} {S : Set (FreeMonoid X)} {g : FreeMonoid X → A X k} {T : Set (A X k)}
    {col : FreeMonoid X → ℕ} {π : A X (k + 1) →ₗ[ℤ] A X (k + 1)}
    (hH : HowellData R0 k S g T col) (hπ : RewriteRules k S g π) :
    (Jspan R0 (k + 1)).map π = Submodule.span ℤ (π '' N2gens R0 k S g T) := by
  set Tgt := Submodule.span ℤ (π '' N2gens R0 k S g T) with hTgt
  have inT : ∀ y ∈ N2gens R0 k S g T, π y ∈ Tgt := fun y hy => Submodule.subset_span ⟨y, hy, rfl⟩
  have hB : Submodule.span ℤ (g '' NS k S ∪ T) = Jspan R0 k := by
    refine le_antisymm ?_ hH.gen
    rw [Submodule.span_le]
    rintro _ (⟨u, hu, rfl⟩ | ht)
    · exact hH.g_mem u hu
    · exact hH.T_mem ht
  -- (A) `π(z a_l) ∈ Tgt` for every `z ∈ J_k`
  have hA : ∀ z ∈ Jspan R0 k, ∀ l, π (shR k l z) ∈ Tgt := by
    intro z hz l
    rw [← hB] at hz
    refine Submodule.span_le.mpr ?_
      (mem_span_image_of_mem_span (π.toAddMonoidHom.comp (shR k l)) hz)
    rintro _ ⟨b, (⟨u, hu, rfl⟩ | ht), rfl⟩
    · show π (shR k l (g u)) ∈ Tgt
      rw [hπ.prefix_rule u hu l]; exact zero_mem _
    · exact inT _ (Or.inl (Or.inr ⟨l, b, ht, Or.inl rfl⟩))
  -- (B) the overlaps and their reduction, by downward induction on the column of `u`
  obtain ⟨m, hm⟩ := hH.col_bdd
  have key : ∀ d : ℕ, ∀ u ∈ NS k S, m - col u = d → ∀ j, π (shL k j (g u)) ∈ Tgt := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
      intro u hu hd j
      rcases eq_one_or_eq_mul_of u with rfl | ⟨u', l, rfl⟩
      · exact absurd hH.one_mem (mem_NS.mp hu).2
      have hlen : u'.length < k := by
        have := (mem_NS.mp hu).1
        rw [FreeMonoid.length_mul, FreeMonoid.length_of] at this
        omega
      by_cases hu' : u' ∈ S
      · by_cases hj : FreeMonoid.of j * u' ∈ S
        · rw [hπ.suffix_rule _ hu u' l j rfl hj]; exact zero_mem _
        · exact inT _ (Or.inr ⟨j, _, hu, u', l, rfl, hu', hj, rfl⟩)
      · have hu'NS : u' ∈ NS k S := mem_NS.mpr ⟨hlen, hu'⟩
        set z := g (u' * FreeMonoid.of l) - g u' * aA k l with hz
        have hzJ : z ∈ Jspan R0 k :=
          sub_mem (hH.g_mem _ hu) (Jspan_mul_right _ (hH.g_mem u' hu'NS))
        have hzL : z ∈ later k col (u' * FreeMonoid.of l) := by
          have e : z = (mon k u' - g u') * aA k l -
              (mon k (u' * FreeMonoid.of l) - g (u' * FreeMonoid.of l)) := by
            rw [hz, mon_mul]; noncomm_ring
          rw [e]
          exact sub_mem (later_mul_aA hH.col_mul l (hH.g_lead u' hu'NS)) (hH.g_lead _ hu)
        have hsplit : shL k j (g (u' * FreeMonoid.of l)) =
            shR k l (aA k j * g u') + shL k j z := by
          rw [← shL_mul_aA, ← map_add, hz]
          congr 1
          abel
        rw [hsplit, map_add]
        refine add_mem (hA _ (Jspan_mul_left _ (hH.g_mem u' hu'NS)) l) ?_
        have hz' := hH.howell _ hu z hzJ hzL
        refine Submodule.span_le.mpr ?_
          (mem_span_image_of_mem_span (π.toAddMonoidHom.comp (shL k j)) hz')
        rintro _ ⟨b, (⟨x, ⟨hx, hlt⟩, rfl⟩ | ht), rfl⟩
        · have hxm := hm x (mem_NS.mp hx).1
          exact ih (m - col x) (by omega) x hx rfl j
        · exact inT _ (Or.inl (Or.inr ⟨j, b, ht, Or.inr rfl⟩))
  apply le_antisymm
  · rw [lemmaN1_span R0 k hB, Submodule.map_span, Submodule.span_le]
    rintro _ ⟨y, ((hr | ⟨j, b, hb, rfl⟩) | ⟨j, b, hb, rfl⟩), rfl⟩
    · exact inT _ (Or.inl (Or.inl hr))
    · rcases hb with ⟨u, hu, rfl⟩ | ht
      · show π (shR k j (g u)) ∈ Tgt
        rw [hπ.prefix_rule u hu j]; exact zero_mem _
      · exact inT _ (Or.inl (Or.inr ⟨j, b, ht, Or.inl rfl⟩))
    · rcases hb with ⟨u, hu, rfl⟩ | ht
      · exact key _ u hu rfl j
      · exact inT _ (Or.inl (Or.inr ⟨j, b, ht, Or.inr rfl⟩))
  · rw [hTgt, Submodule.span_le]
    rintro _ ⟨y, hy, rfl⟩
    exact Submodule.mem_map_of_mem (N2gens_subset R0 hH hy)

/-- **N2 with the projection**: if moreover `x − π x ∈ J_{k+1}` for all `x`, then
`x ∈ J_{k+1} ⟺ π x ∈ span(π '' N2gens)` — the membership test of `stdmono.py`. -/
theorem mem_J_iff_N2 {k : ℕ} {S : Set (FreeMonoid X)} {g : FreeMonoid X → A X k} {T : Set (A X k)}
    {col : FreeMonoid X → ℕ} {π : A X (k + 1) →ₗ[ℤ] A X (k + 1)}
    (hH : HowellData R0 k S g T col) (hπ : RewriteRules k S g π)
    (hπJ : ∀ x, x - π x ∈ Jspan R0 (k + 1)) (x : A X (k + 1)) :
    x ∈ Jspan R0 (k + 1) ↔ π x ∈ Submodule.span ℤ (π '' N2gens R0 k S g T) := by
  rw [← lemmaN2 R0 hH hπ]
  exact mem_iff_map_proj _ π hπJ x

end

