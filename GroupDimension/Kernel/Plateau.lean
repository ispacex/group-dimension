@[expose] public section

/-!
# The plateau is forced by the grading (fast-core paper, §6.9; MATH-313)

`cflint-fast-core`, `docs/analysis.md`, §6.9, paragraph "The plateau is forced by the grading":

> In the component of `a` (degree 2) a word with `k` letters `x₄` has `2 + Nk` other letters, so
> its length is `2 + (N+1)k ∈ {2, N+3, 2N+4, …}`; the same holds for `L_N` of [IMP26] with the
> grading `deg x₅ = (0,1)`, `deg x₄ = (0,−N)`, `deg x_{1,2,3} = (1,0)`. Since `ϖⁿ` is spanned by
> the words of length `≥ n`, `ϖ^{N+4} ∩ U(L)₂ = ϖ^{2N+4} ∩ U(L)₂`, hence
> `D_{N+4} ∩ L₂ = D_{2N+4} ∩ L₂`.

## Setting

* `FA X = MonoidAlgebra ℤ (FreeMonoid X)` is the free associative ring `ℤ⟨X⟩` (Mathlib's
  `FreeAlgebra ℤ X` is isomorphic to it, `FreeAlgebra.equivMonoidAlgebraFreeMonoid`); its
  `ℤ`-basis is the set of words.
* A grading is a map `deg : X → G` into an additive commutative group; `wdeg deg w` is the degree
  of a word. `homog deg d` is the span of the words of degree `d`, `wordsGe n` the span of the words
  of length `≥ n` (`wordsGe_eq_span`).
* `U = RingQuot (relOf R) = ℤ⟨X⟩ / (R)` for a set `R` of relators, with `π = RingQuot.mkAlgHom`.
  The paper's `U(L)` is of this form (`U(L) = ℤ⟨X⟩/(relators)`, §6.9 "Method"), and the paper's
  hypothesis is that every relator is homogeneous: `hR : ∀ ρ ∈ R, ∃ e, ρ ∈ homog deg e`.
* `augU π = π(wordsGe 1)` is the augmentation ideal `ϖ` of `U` (the two-sided ideal generated by
  the images of the letters), `augU π ^ n` its `n`-th power as a `ℤ`-submodule of `U`
  (`Submodule` power in an algebra), and `comp deg π d = π(homog deg d)` is the degree-`d`
  component `U_d`.

## What is proved

* `aug_pow_succ : wordsGe 1 ^ (n+1) = wordsGe (n+1)` and
  `augU_pow_succ : augU π ^ (n+1) = π(wordsGe (n+1))`: "`ϖⁿ` is spanned by the words of length
  `≥ n`" (for `n ≥ 1`; the submodule power `ϖ⁰` is `ℤ·1`).
* `inf_comp_eq_of_gap` (the abstract statement): if the kernel of `π` is graded and every word of
  degree `d` and length `≥ p` has length `≥ q` (`p ≤ q`), then `ϖ^p ∩ U_d = ϖ^q ∩ U_d`.
* `ker_graded_of_homogeneous`: the kernel of `ℤ⟨X⟩ → ℤ⟨X⟩/(R)` is graded when `R` is homogeneous.
* `length_eq_of_weight`, `length_eq_two_add`, `gap_of_weight`, `length_LprimeN`, `length_LN`: the
  admissible lengths `2 + (N+1)k` (`k = Σ isX4` the number of letters `x₄`) for both gradings of
  the paper, hence the gap: length `≥ N+4` forces length `≥ 2N+4`.
* `plateau_LprimeN` (`L'_N`: four letters, `deg x₁ = deg x₂ = deg x₃ = 1`, `deg x₄ = −N`) and
  `plateau_LN` (`L_N` of [IMP26]: five letters, `ℤ²`-grading as above):
  `ϖ^{N+4} ∩ U₂ = ϖ^{2N+4} ∩ U₂` for **every** homogeneous set of relators.
* `dimension_inf_eq`: for any map `ι : L → U` sending a subset `L₂ ⊆ L` into `U₂`,
  `{ℓ ∈ L₂ | ι ℓ ∈ ϖ^{N+4}} = {ℓ ∈ L₂ | ι ℓ ∈ ϖ^{2N+4}}`; with `ι` the PBW embedding `L → U(L)`
  and `D_n(L) = ι⁻¹(ϖⁿ)` this is `D_{N+4} ∩ L₂ = D_{2N+4} ∩ L₂`.

## What is not formalized here (the gap to the paper)

* The identification `U(L'_N) ≅ ℤ⟨x₁..x₄⟩/(relators)` and the PBW embedding `L ↪ U(L)` are not
  formalized: the Lie side enters only through `dimension_inf_eq`, for an arbitrary map `ι` with
  `ι(L₂) ⊆ U₂`.
* The homogeneity of the actual relators of `L'_N` and `L_N` (the paper: "every relator is
  homogeneous (`deg c_i = deg x_i`)") is a hypothesis `hR`, not checked here. The theorems hold for
  every homogeneous relator set, so no information about the specific relators is used.
* The remark "once `D_{N+4} ⊆ L₂`, the length `N+1` of the plateau is the gap…" is only the reading
  of the equality; nothing about `D_{N+4} ⊆ L₂` (a computer result for `N = 2`) is claimed.
-/

namespace GroupDimension.Kernel.Plateau

open MonoidAlgebra

/-- The free associative ring `ℤ⟨X⟩`, with the words as `ℤ`-basis. -/
abbrev FA (X : Type*) := MonoidAlgebra ℤ (FreeMonoid X)

variable {X : Type*} {G : Type*} [AddCommGroup G] (deg : X → G)

/-- The degree of a word: the sum of the degrees of its letters. -/
def wdeg (w : FreeMonoid X) : G := (w.toList.map deg).sum

@[simp] theorem wdeg_one : wdeg deg (1 : FreeMonoid X) = 0 := by
  simp [wdeg]

theorem wdeg_mul (u v : FreeMonoid X) : wdeg deg (u * v) = wdeg deg u + wdeg deg v := by
  simp [wdeg, FreeMonoid.toList_mul, List.map_append, List.sum_append]

/-- The span of the words of length `≥ n` (as the submodule of elements supported on them). -/
noncomputable def wordsGe (X : Type*) (n : ℕ) : Submodule ℤ (FA X) :=
  MonoidAlgebra.supported ℤ ℤ {w : FreeMonoid X | n ≤ w.length}

/-- The degree-`d` component of `ℤ⟨X⟩`: elements supported on the words of degree `d`. -/
noncomputable def homog (d : G) : Submodule ℤ (FA X) :=
  MonoidAlgebra.supported ℤ ℤ {w : FreeMonoid X | wdeg deg w = d}

theorem wordsGe_eq_span (n : ℕ) :
    wordsGe X n = Submodule.span ℤ
      ((fun w => (single w 1 : FA X)) '' {w : FreeMonoid X | n ≤ w.length}) :=
  MonoidAlgebra.supported_eq_span_single ℤ _

theorem homog_eq_span (d : G) :
    homog deg d = Submodule.span ℤ
      ((fun w => (single w 1 : FA X)) '' {w : FreeMonoid X | wdeg deg w = d}) :=
  MonoidAlgebra.supported_eq_span_single ℤ _

theorem single_mem_wordsGe {n : ℕ} {w : FreeMonoid X} (h : n ≤ w.length) (c : ℤ) :
    (single w c : FA X) ∈ wordsGe X n := by
  rw [wordsGe, MonoidAlgebra.mem_supported]
  intro x hx
  rw [Finset.mem_coe, MonoidAlgebra.coeff_single] at hx
  rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hx)]
  exact h

theorem single_mem_homog {d : G} {w : FreeMonoid X} (h : wdeg deg w = d) (c : ℤ) :
    (single w c : FA X) ∈ homog deg d := by
  rw [homog, MonoidAlgebra.mem_supported]
  intro x hx
  rw [Finset.mem_coe, MonoidAlgebra.coeff_single] at hx
  rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hx)]
  exact h

/-! ### `ϖⁿ` is spanned by the words of length `≥ n` -/

theorem wordsGe_one_mul (n : ℕ) : wordsGe X 1 * wordsGe X n = wordsGe X (n + 1) := by
  rw [wordsGe_eq_span, wordsGe_eq_span, wordsGe_eq_span, Submodule.span_mul_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨u, hu, rfl⟩, _, ⟨v, hv, rfl⟩, rfl⟩
    apply Submodule.subset_span
    refine ⟨u * v, ?_, ?_⟩
    · change 1 ≤ u.length at hu
      change n ≤ v.length at hv
      change n + 1 ≤ (u * v).length
      rw [FreeMonoid.length_mul]; omega
    · simp only [single_mul_single, mul_one]
  · apply Submodule.span_le.mpr
    rintro _ ⟨w, hw, rfl⟩
    apply Submodule.subset_span
    obtain ⟨l, rfl⟩ : ∃ l : List X, FreeMonoid.ofList l = w := ⟨w.toList, rfl⟩
    change n + 1 ≤ l.length at hw
    cases l with
    | nil => exact absurd hw (by simp)
    | cons x l' =>
      refine ⟨single (FreeMonoid.of x) 1, ⟨FreeMonoid.of x, (show 1 ≤ (FreeMonoid.of x).length by rw [FreeMonoid.length_of]), rfl⟩,
        single (FreeMonoid.ofList l') 1, ⟨FreeMonoid.ofList l', ?_, rfl⟩, ?_⟩
      · change n ≤ l'.length
        simp only [List.length_cons] at hw; omega
      · simp only [single_mul_single, mul_one]
        rfl


/-- `ϖⁿ` in `ℤ⟨X⟩` is spanned by the words of length `≥ n` (`n ≥ 1`; for `n = 0` the submodule
power `ϖ⁰ = 1` is `ℤ·1`, not the whole ring). -/
theorem aug_pow_succ (n : ℕ) : wordsGe X 1 ^ (n + 1) = wordsGe X (n + 1) := by
  induction n with
  | zero => rw [zero_add, pow_one]
  | succ n ih => rw [pow_succ', ih, wordsGe_one_mul]

theorem wordsGe_mono {m n : ℕ} (h : m ≤ n) : wordsGe X n ≤ wordsGe X m :=
  MonoidAlgebra.supported_mono fun _ hw => le_trans h hw

/-! ### The quotient `U`: augmentation ideal and graded components -/

section Quotient

variable {U : Type*} [Semiring U] [Algebra ℤ U]

/-- The augmentation ideal `ϖ` of `U`: the image of the span of the nonempty words. -/
noncomputable def augU (π : FA X →ₐ[ℤ] U) : Submodule ℤ U := (wordsGe X 1).map π.toLinearMap

/-- The degree-`d` component `U_d` of `U`: the image of the degree-`d` component of `ℤ⟨X⟩`. -/
noncomputable def comp (π : FA X →ₐ[ℤ] U) (d : G) : Submodule ℤ U := (homog deg d).map π.toLinearMap

/-- `ϖⁿ` (`n ≥ 1`) in `U` is the image of the span of the words of length `≥ n`. -/
theorem augU_pow_succ (π : FA X →ₐ[ℤ] U) (n : ℕ) :
    augU π ^ (n + 1) = (wordsGe X (n + 1)).map π.toLinearMap := by
  rw [augU, ← Submodule.map_pow, aug_pow_succ]

end Quotient

/-! ### Projection on a graded component -/

/-- The projection of `ℤ⟨X⟩` on its degree-`d` component (drop the words of other degrees). -/
noncomputable def proj (d : G) : FA X →ₗ[ℤ] FA X := by
  classical
  exact
  { toFun := fun f => MonoidAlgebra.ofCoeff (f.coeff.filter fun w => wdeg deg w = d)
    map_add' := fun f g => by
      simp only [MonoidAlgebra.coeff_add, Finsupp.filter_add, MonoidAlgebra.ofCoeff_add]
    map_smul' := fun c f => by
      simp only [MonoidAlgebra.coeff_smul, Finsupp.filter_smul, MonoidAlgebra.ofCoeff_smul,
        RingHom.id_apply] }

theorem coeff_proj_of_eq {d : G} (f : FA X) {w : FreeMonoid X} (h : wdeg deg w = d) :
    (proj deg d f).coeff w = f.coeff w := by
  classical
  exact Finsupp.filter_apply_pos _ _ h

theorem coeff_proj_of_ne {d : G} (f : FA X) {w : FreeMonoid X} (h : wdeg deg w ≠ d) :
    (proj deg d f).coeff w = 0 := by
  classical
  exact Finsupp.filter_apply_neg _ _ h

theorem proj_of_mem_homog {d : G} {g : FA X} (hg : g ∈ homog deg d) : proj deg d g = g := by
  rw [homog, MonoidAlgebra.mem_supported] at hg
  apply MonoidAlgebra.coeff_injective
  ext w
  by_cases h : wdeg deg w = d
  · exact coeff_proj_of_eq deg g h
  · rw [coeff_proj_of_ne deg g h]
    by_contra hne
    exact h (hg (Finsupp.mem_support_iff.mpr (Ne.symm hne)))

theorem proj_of_mem_homog_ne {d e : G} {g : FA X} (hg : g ∈ homog deg d) (hde : d ≠ e) :
    proj deg e g = 0 := by
  rw [homog, MonoidAlgebra.mem_supported] at hg
  apply MonoidAlgebra.coeff_injective
  ext w
  rw [MonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply]
  by_cases h : wdeg deg w = e
  · rw [coeff_proj_of_eq deg g h]
    by_contra hne
    exact hde ((hg (Finsupp.mem_support_iff.mpr hne)).symm.trans h)
  · exact coeff_proj_of_ne deg g h

theorem proj_mem_wordsGe {d : G} {p q : ℕ}
    (hgap : ∀ w : FreeMonoid X, wdeg deg w = d → p ≤ w.length → q ≤ w.length)
    {f : FA X} (hf : f ∈ wordsGe X p) : proj deg d f ∈ wordsGe X q := by
  rw [wordsGe, MonoidAlgebra.mem_supported] at hf ⊢
  intro w hw
  have hw' : (proj deg d f).coeff w ≠ 0 := Finsupp.mem_support_iff.mp hw
  by_cases h : wdeg deg w = d
  · rw [coeff_proj_of_eq deg f h] at hw'
    exact hgap w h (hf (Finsupp.mem_support_iff.mpr hw'))
  · exact absurd (coeff_proj_of_ne deg f h) hw'

theorem homog_mul_le (d₁ d₂ : G) : homog deg d₁ * homog deg d₂ ≤ homog deg (d₁ + d₂) := by
  rw [homog_eq_span, homog_eq_span, Submodule.span_mul_span, Submodule.span_le]
  rintro _ ⟨_, ⟨u, hu, rfl⟩, _, ⟨v, hv, rfl⟩, rfl⟩
  change wdeg deg u = d₁ at hu
  change wdeg deg v = d₂ at hv
  show (single u 1 : FA X) * single v 1 ∈ homog deg (d₁ + d₂)
  rw [single_mul_single, mul_one]
  exact single_mem_homog deg (by rw [wdeg_mul, hu, hv]) 1

/-! ### The abstract statement: a gap in the admissible lengths gives a plateau -/

/-- **The plateau from a gap.** Let `π : ℤ⟨X⟩ → U` be an algebra map whose kernel is graded
(`hker`), and suppose every word of degree `d` and length `≥ p` has length `≥ q`, `p ≤ q`,
`p ≥ 1`. Then `ϖ^p ∩ U_d = ϖ^q ∩ U_d`. -/
theorem inf_comp_eq_of_gap {U : Type*} [Semiring U] [Algebra ℤ U] (π : FA X →ₐ[ℤ] U)
    (hker : ∀ f g : FA X, π f = π g → ∀ e : G, π (proj deg e f) = π (proj deg e g))
    (d : G) {p q : ℕ} (hp : p ≠ 0) (hpq : p ≤ q)
    (hgap : ∀ w : FreeMonoid X, wdeg deg w = d → p ≤ w.length → q ≤ w.length) :
    augU π ^ p ⊓ comp deg π d = augU π ^ q ⊓ comp deg π d := by
  obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
  obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  rw [augU_pow_succ, augU_pow_succ]
  apply le_antisymm
  · rintro u ⟨⟨f, hf, rfl⟩, ⟨g, hg, hgf⟩⟩
    refine ⟨⟨proj deg d f, proj_mem_wordsGe deg hgap hf, ?_⟩, ⟨g, hg, hgf⟩⟩
    have h := hker g f hgf d
    rw [proj_of_mem_homog deg hg] at h
    exact h.symm.trans hgf
  · exact inf_le_inf_right _ (Submodule.map_mono (wordsGe_mono hpq))

/-! ### `U = ℤ⟨X⟩/(R)` with homogeneous relators has a graded kernel -/

section Relators

variable (R : Set (FA X))

/-- The relation `ρ ~ 0` for `ρ ∈ R`; `RingQuot (relOf R) = ℤ⟨X⟩/(R)`. -/
def relOf : FA X → FA X → Prop := fun a b => a ∈ R ∧ b = 0

/-- The two-sided ideal generated by `R`, as the `ℤ`-span of the `u ρ v` (`u, v` words). -/
noncomputable def idealOf : Submodule ℤ (FA X) :=
  Submodule.span ℤ {f | ∃ u v : FreeMonoid X, ∃ ρ ∈ R, f = single u 1 * ρ * single v 1}

theorem single_eq_smul (w : FreeMonoid X) (c : ℤ) : (single w c : FA X) = c • single w 1 := by
  rw [smul_single', mul_one]

theorem mul_mem_idealOf_left (x : FA X) {i : FA X} (hi : i ∈ idealOf R) : x * i ∈ idealOf R := by
  induction hi using Submodule.span_induction with
  | mem i hi =>
    obtain ⟨u, v, ρ, hρ, rfl⟩ := hi
    induction x using MonoidAlgebra.induction_linear with
    | zero => rw [zero_mul]; exact zero_mem _
    | add a b ha hb => rw [add_mul]; exact add_mem ha hb
    | single w c =>
      rw [single_eq_smul w c, smul_mul_assoc, ← mul_assoc, ← mul_assoc, single_mul_single, mul_one]
      exact Submodule.smul_mem _ c (Submodule.subset_span ⟨w * u, v, ρ, hρ, rfl⟩)
  | zero => rw [mul_zero]; exact zero_mem _
  | add a b _ _ ha hb => rw [mul_add]; exact add_mem ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ c ha

theorem mul_mem_idealOf_right (x : FA X) {i : FA X} (hi : i ∈ idealOf R) : i * x ∈ idealOf R := by
  induction hi using Submodule.span_induction with
  | mem i hi =>
    obtain ⟨u, v, ρ, hρ, rfl⟩ := hi
    induction x using MonoidAlgebra.induction_linear with
    | zero => rw [mul_zero]; exact zero_mem _
    | add a b ha hb => rw [mul_add]; exact add_mem ha hb
    | single w c =>
      rw [single_eq_smul w c, mul_smul_comm, mul_assoc, single_mul_single, mul_one]
      exact Submodule.smul_mem _ c (Submodule.subset_span ⟨u, v * w, ρ, hρ, rfl⟩)
  | zero => rw [zero_mul]; exact zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact add_mem ha hb
  | smul c a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c ha

/-- The ring congruence `a ≡ b ↔ a - b ∈ (R)`. -/
noncomputable def conOf : RingCon (FA X) where
  r a b := a - b ∈ idealOf R
  iseqv :=
    { refl := fun a => by rw [sub_self]; exact zero_mem _
      symm := fun h => by rw [← neg_sub]; exact neg_mem h
      trans := fun h₁ h₂ => by
        have := add_mem h₁ h₂
        rwa [sub_add_sub_cancel] at this }
  add' {a b c d} h₁ h₂ := by
    have e : a + c - (b + d) = (a - b) + (c - d) := by abel
    rw [e]; exact add_mem h₁ h₂
  mul' {a b c d} h₁ h₂ := by
    have e : a * c - b * d = (a - b) * c + b * (c - d) := by noncomm_ring
    rw [e]
    exact add_mem (mul_mem_idealOf_right R c h₁) (mul_mem_idealOf_left R b h₂)

/-- The kernel of `ℤ⟨X⟩ → ℤ⟨X⟩/(R)` is contained in the two-sided ideal `(R)`. -/
theorem sub_mem_idealOf {a b : FA X}
    (h : RingQuot.mkAlgHom ℤ (relOf R) a = RingQuot.mkAlgHom ℤ (relOf R) b) :
    a - b ∈ idealOf R := by
  have w : ∀ ⦃x y : FA X⦄, relOf R x y → (conOf R).mk' x = (conOf R).mk' y := by
    intro x y hxy
    obtain ⟨hx, rfl⟩ := hxy
    refine (conOf R).eq.mpr ?_
    show x - 0 ∈ idealOf R
    rw [sub_zero]
    refine Submodule.subset_span ⟨1, 1, x, hx, ?_⟩
    change x = (1 : FA X) * x * 1
    rw [one_mul, mul_one]
  have e : ∀ x, RingQuot.mkAlgHom ℤ (relOf R) x = RingQuot.mkRingHom (relOf R) x := fun x =>
    DFunLike.congr_fun (RingQuot.mkAlgHom_coe ℤ (relOf R)) x
  rw [e a, e b] at h
  have h' := congrArg (RingQuot.lift ⟨(conOf R).mk', w⟩) h
  rw [RingQuot.lift_mkRingHom_apply, RingQuot.lift_mkRingHom_apply] at h'
  exact (conOf R).eq.mp h'

theorem mkAlgHom_eq_zero_of_mem {i : FA X} (hi : i ∈ idealOf R) :
    RingQuot.mkAlgHom ℤ (relOf R) i = 0 := by
  induction hi using Submodule.span_induction with
  | mem i hi =>
    obtain ⟨u, v, ρ, hρ, rfl⟩ := hi
    rw [map_mul, map_mul, RingQuot.mkAlgHom_rel ℤ (show relOf R ρ 0 from ⟨hρ, rfl⟩), map_zero,
      mul_zero, zero_mul]
  | zero => exact map_zero _
  | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
  | smul c a _ ha => rw [map_smul, ha]; simp

variable {R}

/-- With homogeneous relators, the projections preserve the two-sided ideal `(R)`. -/
theorem proj_mem_idealOf (hR : ∀ ρ ∈ R, ∃ e : G, ρ ∈ homog deg e) (e : G) {i : FA X}
    (hi : i ∈ idealOf R) : proj deg e i ∈ idealOf R := by
  induction hi using Submodule.span_induction with
  | mem i hi =>
    obtain ⟨u, v, ρ, hρ, rfl⟩ := hi
    obtain ⟨e', he'⟩ := hR ρ hρ
    have hhom : single u 1 * ρ * single v 1 ∈ homog deg (wdeg deg u + e' + wdeg deg v) :=
      homog_mul_le deg _ _ (Submodule.mul_mem_mul
        (homog_mul_le deg _ _ (Submodule.mul_mem_mul (single_mem_homog deg rfl 1) he'))
        (single_mem_homog deg rfl 1))
    by_cases hde : wdeg deg u + e' + wdeg deg v = e
    · rw [← hde, proj_of_mem_homog deg hhom]
      exact Submodule.subset_span ⟨u, v, ρ, hρ, rfl⟩
    · rw [proj_of_mem_homog_ne deg hhom hde]; exact zero_mem _
  | zero => rw [map_zero]; exact zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

/-- **The kernel of `ℤ⟨X⟩ → ℤ⟨X⟩/(R)` is graded** when every relator is homogeneous. -/
theorem ker_graded_of_homogeneous (hR : ∀ ρ ∈ R, ∃ e : G, ρ ∈ homog deg e) (f g : FA X)
    (hfg : RingQuot.mkAlgHom ℤ (relOf R) f = RingQuot.mkAlgHom ℤ (relOf R) g) (e : G) :
    RingQuot.mkAlgHom ℤ (relOf R) (proj deg e f) = RingQuot.mkAlgHom ℤ (relOf R) (proj deg e g) := by
  have h := mkAlgHom_eq_zero_of_mem R (proj_mem_idealOf deg hR e (sub_mem_idealOf R hfg))
  rwa [map_sub, map_sub, sub_eq_zero] at h

/-- **`ϖ^p ∩ U_d = ϖ^q ∩ U_d` in `U = ℤ⟨X⟩/(R)`** for homogeneous `R`, given the gap in the
lengths of the words of degree `d`. -/
theorem inf_comp_eq_of_gap_quot (hR : ∀ ρ ∈ R, ∃ e : G, ρ ∈ homog deg e)
    (d : G) {p q : ℕ} (hp : p ≠ 0) (hpq : p ≤ q)
    (hgap : ∀ w : FreeMonoid X, wdeg deg w = d → p ≤ w.length → q ≤ w.length) :
    augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ p ⊓ comp deg (RingQuot.mkAlgHom ℤ (relOf R)) d =
      augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ q ⊓ comp deg (RingQuot.mkAlgHom ℤ (relOf R)) d :=
  inf_comp_eq_of_gap deg _ (ker_graded_of_homogeneous deg hR) d hp hpq hgap

end Relators

/-! ### The admissible lengths `2 + (N+1)k` -/

/-- If every letter satisfies `φ(deg x) + (N+1)·s(x) = 1` for an additive `φ : G → ℤ` and a count
`s : X → ℕ` (`s x = 1` on the letters `x₄`, `0` otherwise), then a word `w` has length
`φ(deg w) + (N+1)·Σ s` (the sum over the letters of `w`). -/
theorem length_eq_of_weight (φ : G →+ ℤ) (s : X → ℕ) (N : ℕ)
    (h : ∀ x, φ (deg x) + (N + 1) * (s x : ℤ) = 1) (w : FreeMonoid X) :
    (w.length : ℤ) = φ (wdeg deg w) + (N + 1) * ((w.toList.map s).sum : ℕ) := by
  obtain ⟨l, rfl⟩ : ∃ l : List X, FreeMonoid.ofList l = w := ⟨w.toList, rfl⟩
  change (l.length : ℤ) = φ ((l.map deg).sum) + (N + 1) * ((l.map s).sum : ℕ)
  induction l with
  | nil => simp
  | cons x l ih =>
    have hx := h x
    simp only [List.length_cons, List.map_cons, List.sum_cons, map_add] at ih ⊢
    push_cast at ih ⊢
    linarith

/-- Under the hypothesis of `length_eq_of_weight`, a word of degree `d` with `φ d = 2` has length
`2 + (N+1)k`, `k = Σ s` the number of its letters `x₄`. -/
theorem length_eq_two_add (φ : G →+ ℤ) (s : X → ℕ) (N : ℕ)
    (h : ∀ x, φ (deg x) + (N + 1) * (s x : ℤ) = 1) {d : G} (hd : φ d = 2)
    (w : FreeMonoid X) (hw : wdeg deg w = d) :
    w.length = 2 + (N + 1) * (w.toList.map s).sum := by
  have := length_eq_of_weight deg φ s N h w
  rw [hw, hd] at this
  exact_mod_cast this

/-- The gap: under the same hypotheses, a word of degree `d` and length `≥ N + 4` has length
`≥ 2N + 4` (the admissible lengths are `2, N + 3, 2N + 4, …`). -/
theorem gap_of_weight (φ : G →+ ℤ) (s : X → ℕ) (N : ℕ)
    (h : ∀ x, φ (deg x) + (N + 1) * (s x : ℤ) = 1) {d : G} (hd : φ d = 2)
    (w : FreeMonoid X) (hw : wdeg deg w = d) (hlen : N + 4 ≤ w.length) : 2 * N + 4 ≤ w.length := by
  rw [length_eq_two_add deg φ s N h hd w hw] at hlen ⊢
  generalize (w.toList.map s).sum = k at hlen ⊢
  rcases Nat.lt_or_ge k 2 with hk | hk
  · interval_cases k <;> omega
  · nlinarith [Nat.mul_le_mul_left (N + 1) hk]

/-! ### The two gradings of §6.9 -/

/-- The grading of `L'_N` (letters `x₁..x₄` = `0..3`): `deg x₁ = deg x₂ = deg x₃ = 1`,
`deg x₄ = −N`. -/
def degLp (N : ℕ) : Fin 4 → ℤ := fun i => if i = 3 then -(N : ℤ) else 1

/-- The `ℤ²`-grading of `L_N` of [IMP26] (letters `x₁..x₅` = `0..4`): `deg x_{1,2,3} = (1,0)`,
`deg x₄ = (0,−N)`, `deg x₅ = (0,1)`. -/
def degL (N : ℕ) : Fin 5 → ℤ × ℤ := fun i =>
  if i = 3 then (0, -(N : ℤ)) else if i = 4 then (0, 1) else (1, 0)

/-- The count of the letter `x₄` (index `3`). -/
def isX4 {n : ℕ} (i : Fin n) : ℕ := if i.val = 3 then 1 else 0

theorem weight_degLp (N : ℕ) (x : Fin 4) :
    AddMonoidHom.id ℤ (degLp N x) + (N + 1) * (isX4 x : ℤ) = 1 := by
  fin_cases x <;> simp [degLp, isX4]

theorem weight_degL (N : ℕ) (x : Fin 5) :
    (AddMonoidHom.fst ℤ ℤ + AddMonoidHom.snd ℤ ℤ) (degL N x) + (N + 1) * (isX4 x : ℤ) = 1 := by
  fin_cases x <;> simp [degL, isX4]

/-- **Admissible lengths for `L'_N`.** A word of degree 2 with `k` letters `x₄` has length
`2 + (N+1)k`. -/
theorem length_LprimeN (N : ℕ) (w : FreeMonoid (Fin 4)) (hw : wdeg (degLp N) w = 2) :
    w.length = 2 + (N + 1) * (w.toList.map isX4).sum :=
  length_eq_two_add (degLp N) (AddMonoidHom.id ℤ) isX4 N (weight_degLp N) rfl w hw

/-- **Admissible lengths for `L_N` of [IMP26].** A word of degree `(2,0)` with `k` letters `x₄`
has length `2 + (N+1)k`. -/
theorem length_LN (N : ℕ) (w : FreeMonoid (Fin 5)) (hw : wdeg (degL N) w = (2, 0)) :
    w.length = 2 + (N + 1) * (w.toList.map isX4).sum :=
  length_eq_two_add (degL N) _ isX4 N (weight_degL N) (by simp) w hw

/-- **§6.9 for `L'_N`.** In `U = ℤ⟨x₁..x₄⟩/(R)` with any set `R` of relators homogeneous for
`deg x_{1,2,3} = 1`, `deg x₄ = −N`: `ϖ^{N+4} ∩ U₂ = ϖ^{2N+4} ∩ U₂`. -/
theorem plateau_LprimeN (N : ℕ) (R : Set (FA (Fin 4)))
    (hR : ∀ ρ ∈ R, ∃ e : ℤ, ρ ∈ homog (degLp N) e) :
    augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ (N + 4) ⊓
        comp (degLp N) (RingQuot.mkAlgHom ℤ (relOf R)) 2 =
      augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ (2 * N + 4) ⊓
        comp (degLp N) (RingQuot.mkAlgHom ℤ (relOf R)) 2 :=
  inf_comp_eq_of_gap_quot (degLp N) hR 2 (by omega) (by omega)
    (gap_of_weight (degLp N) (AddMonoidHom.id ℤ) isX4 N (weight_degLp N) rfl)

/-- **§6.9 for `L_N` of [IMP26].** In `U = ℤ⟨x₁..x₅⟩/(R)` with any set `R` of relators homogeneous
for `deg x_{1,2,3} = (1,0)`, `deg x₄ = (0,−N)`, `deg x₅ = (0,1)`:
`ϖ^{N+4} ∩ U_{(2,0)} = ϖ^{2N+4} ∩ U_{(2,0)}`. -/
theorem plateau_LN (N : ℕ) (R : Set (FA (Fin 5)))
    (hR : ∀ ρ ∈ R, ∃ e : ℤ × ℤ, ρ ∈ homog (degL N) e) :
    augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ (N + 4) ⊓
        comp (degL N) (RingQuot.mkAlgHom ℤ (relOf R)) (2, 0) =
      augU (RingQuot.mkAlgHom ℤ (relOf R)) ^ (2 * N + 4) ⊓
        comp (degL N) (RingQuot.mkAlgHom ℤ (relOf R)) (2, 0) :=
  inf_comp_eq_of_gap_quot (degL N) hR (2, 0) (by omega) (by omega)
    (gap_of_weight (degL N) _ isX4 N (weight_degL N) (by simp))

/-- **The consequence for dimension subrings.** For any map `ι : L → U` sending `L₂ ⊆ L` into
`U_d`, an equality `ϖ^p ∩ U_d = ϖ^q ∩ U_d` gives
`{ℓ ∈ L₂ | ι ℓ ∈ ϖ^p} = {ℓ ∈ L₂ | ι ℓ ∈ ϖ^q}`. With `ι : L → U(L)` the PBW embedding,
`D_n(L) = ι⁻¹(ϖⁿ)` and `L₂` the degree-2 part of `L`, and `plateau_LprimeN` / `plateau_LN`, this is
`D_{N+4} ∩ L₂ = D_{2N+4} ∩ L₂`. (The identification of `U(L)` with `ℤ⟨X⟩/(R)` is not formalized.) -/
theorem dimension_inf_eq {U : Type*} [Semiring U] [Algebra ℤ U] (π : FA X →ₐ[ℤ] U) {L : Type*}
    (ι : L → U) (L₂ : Set L) (d : G) (hL₂ : ∀ ℓ ∈ L₂, ι ℓ ∈ comp deg π d) {p q : ℕ}
    (h : augU π ^ p ⊓ comp deg π d = augU π ^ q ⊓ comp deg π d) :
    {ℓ ∈ L₂ | ι ℓ ∈ augU π ^ p} = {ℓ ∈ L₂ | ι ℓ ∈ augU π ^ q} := by
  ext ℓ
  constructor
  · rintro ⟨h₁, h₂⟩
    have : ι ℓ ∈ augU π ^ p ⊓ comp deg π d := ⟨h₂, hL₂ ℓ h₁⟩
    rw [h] at this
    exact ⟨h₁, this.1⟩
  · rintro ⟨h₁, h₂⟩
    have : ι ℓ ∈ augU π ^ q ⊓ comp deg π d := ⟨h₂, hL₂ ℓ h₁⟩
    rw [← h] at this
    exact ⟨h₁, this.1⟩

end GroupDimension.Kernel.Plateau
