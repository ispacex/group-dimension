module

public import GroupDimension.Kernel.Magnus

@[expose] public section

/-!
# All levels from one `J_N`, and the sieve `D_n ∩ K` (fast-core paper, §3.4–3.5; MATH-307)

`cflint-fast-core`, `docs/analysis.md`:

> **§3.4.** `J_n` is the image of `J_N` (`n < N`) under dropping the degrees `≥ n`. …
>
> **§3.5.** If `K ⊆ D_{n−1}` is an elementary abelian `p`-subgroup with independent generators
> `g_1..g_r`, then `g ↦ (g − 1) mod Δⁿ` is a homomorphism on `K`: `gh − 1 = (g−1) + (h−1) +
> (g−1)(h−1)` and `(g−1)(h−1) ∈ Δ^{2n−2} ⊆ Δⁿ`. Hence `D_n ∩ K` is the kernel of
> `c ↦ Σ c_i v_i` modulo `J_n`, `v_i = μ(w_{g_i}) − 1`. …

The notation is that of `GroupDimension.Kernel.Magnus` (`A X n`, `muF`, `Jspan`, `Jideal`,
`quotEquiv`, `D`, `augIdeal`).

## What is proved

* **§3.4** (at the level of submodules and ideals, no Howell forms). `trunc h : A_N →+* A_n`
  (`h : n ≤ N`) is the map that drops the degrees `≥ n`; it sends words to words (`trunc_mon`)
  and `μ_N(g)` to `μ_n(g)` (`trunc_muF`). Then
  `Jspan_map_trunc : (Jspan R0 N).map trunc = Jspan R0 n`, equivalently
  `mem_Jideal_iff_trunc : y ∈ J_n ⟺ ∃ x ∈ J_N, trunc x = y` and, as ideals,
  `map_trunc_Jideal : Ideal.map trunc (Jideal R0 N) = Jideal R0 n`. End to end,
  `mem_D_iff_trunc : φ w ∈ D_n(G) ⟺ trunc(μ_N(w) − 1) ∈ trunc(J_N)`: the `J_N` of one level
  `N` decides membership in `D_n` for every `n ≤ N`.
* **§3.5.** For any `n`, `g, h ∈ D_{n−1}` give `(g−1)(h−1) ∈ Δⁿ` (`sub_one_mul_sub_one_mem`;
  we use `Δ^{n−1}·Δ ⊆ Δⁿ` rather than `Δ^{2n−2}`, which also covers `n ≤ 1`), so
  `sieveHom n : D_{n−1} →* Multiplicative (ℤ[G]/Δⁿ)`, `g ↦ (g − 1) mod Δⁿ`, is a group
  homomorphism with kernel `D_n` (`ker_sieveHom`). For any subgroup `K ≤ D_{n−1}` its restriction
  `sieveHomK` has kernel `D_n ∩ K` (`ker_sieveHomK`, `map_ker_sieveHomK : … = D_n ⊓ K`).
  Neither "elementary abelian" nor "`p`-group" is needed for this.
  In the coordinates of `A_n/J_n`: for `g_i = φ(w_i) ∈ D_{n−1}` and `c ∈ ℕ^r`,
  `prod_mem_D_iff : ∏ g_i^{c_i} ∈ D_n ⟺ Σ c_i (μ(w_i) − 1) ∈ J_n` (the product in the order
  `i = 0, 1, …`; `G` need not be abelian). If moreover `g_i^p = 1`, then `p v_i ∈ J_n`
  (`nsmul_sub_one_mem_J`), the map `sieveLin : (ZMod p)^r →+ A_n/J_n`,
  `c ↦ Σ c_i v_i mod J_n`, is well defined and additive, and
  `mem_ker_sieveLin : c ∈ ker sieveLin ⟺ ∏ g_i^{val c_i} ∈ D_n`. For `K` abelian generated by
  the `g_i` with `g_i^p = 1`, every element of `K` is such a product, so this is the paper's
  "`D_n ∩ K` is the kernel of `c ↦ Σ c_i v_i` modulo `J_n`".

## What is not formalized here

* The Howell-form / HNF statements of §3.4 (rows with pivot of degree `< n`, truncated, form a
  Howell form of `J_n`) and the matrix `[J_n | 0; V | I; 0 | pI]` of §3.5, i.e. everything about
  `magnus_pres.py` and its echelon forms; only the submodule statements they implement are proved.
* "Independent generators" (that `c ↦ ∏ g_i^{c_i}` is a bijection `(ZMod p)^r ≅ K`) is not used:
  the kernel statement is about the vectors `c`, and is true without it.
-/

namespace GroupDimension.Kernel.Sieve

noncomputable section

-- instance search through the quotient rings `A X n`, `A X n ⧸ J_n` is slow
set_option synthInstance.maxHeartbeats 400000

open MonoidAlgebra GroupDimension.Kernel.Magnus

variable {X : Type*}

/-! ## §3.4: dropping the degrees `≥ n` -/

theorem Itr_le {n N : ℕ} (h : n ≤ N) : Itr X N ≤ Itr X n := fun _ hx => Ik_mono h hx

/-- `A_N → A_n` (`n ≤ N`): drop the degrees `≥ n`. -/
def trunc {n N : ℕ} (h : n ≤ N) : A X N →+* A X n :=
  Ideal.Quotient.lift (Itr X N) (Ideal.Quotient.mk (Itr X n))
    (fun _ ha => Ideal.Quotient.eq_zero_iff_mem.mpr (Itr_le h ha))

theorem trunc_mk {n N : ℕ} (h : n ≤ N) (x : FA X) :
    trunc h (Ideal.Quotient.mk (Itr X N) x) = Ideal.Quotient.mk (Itr X n) x :=
  Ideal.Quotient.lift_mk _ _ _

theorem trunc_mon {n N : ℕ} (h : n ≤ N) (u : FreeMonoid X) : trunc h (mon N u) = mon n u :=
  trunc_mk h _

theorem trunc_surjective {n N : ℕ} (h : n ≤ N) : Function.Surjective (trunc (X := X) h) := by
  intro y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨Ideal.Quotient.mk _ x, trunc_mk h x⟩

/-- Truncation commutes with the Magnus map: `trunc (μ_N g) = μ_n g`. -/
theorem trunc_muF {n N : ℕ} (h : n ≤ N) (g : FreeGroup X) :
    trunc h (muF N g : A X N) = (muF n g : A X n) := by
  have e : (Units.map (trunc (X := X) h).toMonoidHom).comp (muF N) = muF n :=
    FreeGroup.ext_hom _ _ fun j => Units.ext (by
      show trunc h (muF N (FreeGroup.of j) : A X N) = (muF n (FreeGroup.of j) : A X n)
      rw [muF_of, muF_of, map_add, map_one]
      exact congrArg (1 + ·) (trunc_mon h _))
  have := congrArg (fun u : (A X n)ˣ => (u : A X n)) (DFunLike.congr_fun e g)
  exact this

variable (R0 : Set (FreeGroup X))

/-- **§3.4**: the image of `J_N` under dropping the degrees `≥ n` is `J_n` (as `ℤ`-submodules). -/
theorem Jspan_map_trunc {n N : ℕ} (h : n ≤ N) :
    (Jspan R0 N).map (trunc (X := X) h).toAddMonoidHom.toIntLinearMap = Jspan R0 n := by
  rw [Jspan, Jspan, Submodule.map_span]
  congr 1
  ext y
  constructor
  · rintro ⟨_, ⟨r, hr, u, v, rfl⟩, rfl⟩
    refine ⟨r, hr, u, v, ?_⟩
    show trunc h (mon N u * ((muF N r : A X N) - 1) * mon N v) = _
    rw [map_mul, map_mul, map_sub, map_one, trunc_mon, trunc_mon, trunc_muF]
  · rintro ⟨r, hr, u, v, rfl⟩
    refine ⟨_, ⟨r, hr, u, v, rfl⟩, ?_⟩
    show trunc h (mon N u * ((muF N r : A X N) - 1) * mon N v) = _
    rw [map_mul, map_mul, map_sub, map_one, trunc_mon, trunc_mon, trunc_muF]

/-- **§3.4**, elementwise: `y ∈ J_n ⟺ y` is the truncation of an element of `J_N`. -/
theorem mem_Jideal_iff_trunc {n N : ℕ} (h : n ≤ N) (y : A X n) :
    y ∈ Jideal R0 n ↔ ∃ x ∈ Jideal R0 N, trunc h x = y := by
  rw [mem_Jideal, ← Jspan_map_trunc R0 h, Submodule.mem_map]
  exact Iff.rfl

theorem trunc_mem_Jideal {n N : ℕ} (h : n ≤ N) {x : A X N} (hx : x ∈ Jideal R0 N) :
    trunc h x ∈ Jideal R0 n :=
  (mem_Jideal_iff_trunc R0 h _).mpr ⟨x, hx, rfl⟩

/-- **§3.4**, as ideals: `trunc(J_N) = J_n`. -/
theorem map_trunc_Jideal {n N : ℕ} (h : n ≤ N) :
    Ideal.map (trunc (X := X) h) (Jideal R0 N) = Jideal R0 n := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact Ideal.mem_comap.mpr (trunc_mem_Jideal R0 h hx)
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := (mem_Jideal_iff_trunc R0 h y).mp hy
    exact Ideal.mem_map_of_mem _ hx

section Group

variable {G : Type*} [Group G] (φ : FreeGroup X →* G)

/-- **§3.4, end to end**: `J_N` decides `D_n` for every `n ≤ N`:
`φ w ∈ D_n(G) ⟺ trunc(μ_N(w) − 1) ∈ trunc(J_N)`. -/
theorem mem_D_iff_trunc (hφ : Function.Surjective φ) (hker : φ.ker = Subgroup.normalClosure R0)
    {n N : ℕ} (h : n ≤ N) (w : FreeGroup X) :
    φ w ∈ D n G ↔ ∃ x ∈ Jideal R0 N, trunc h x = trunc h ((muF N w : A X N) - 1) := by
  rw [mem_D_iff φ R0 hφ hker, mem_Jideal_iff_trunc R0 h, map_sub, map_one, trunc_muF]

end Group

/-! ## §3.5: the sieve -/

section Sieve

variable {G : Type*} [Group G]

/-- `(g − 1)(h − 1) ∈ Δⁿ` for `g, h ∈ D_{n−1}` (any `n`; only `g ∈ D_{n−1}` is used). -/
theorem sub_one_mul_sub_one_mem {n : ℕ} {g : G} (hg : g ∈ D (n - 1) G) (h : G) :
    (of ℤ G g - 1) * (of ℤ G h - 1) ∈ augIdeal G ^ n := by
  rcases n with _ | k
  · simp [Submodule.pow_zero, Ideal.one_eq_top]
  · rw [Nat.add_sub_cancel] at hg
    rw [Submodule.pow_succ]
    exact Submodule.mul_mem_mul (mem_D.mp hg) (of_sub_one_mem_augIdeal h)

/-- `gh − 1 ≡ (g − 1) + (h − 1) (mod Δⁿ)` for `g ∈ D_{n−1}`. -/
theorem mk_mul_sub_one {n : ℕ} {g : G} (hg : g ∈ D (n - 1) G) (h : G) :
    Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (g * h) - 1) =
      Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G g - 1) +
        Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G h - 1) := by
  rw [← map_add, Ideal.Quotient.eq]
  have e : of ℤ G (g * h) - 1 - ((of ℤ G g - 1) + (of ℤ G h - 1)) =
      (of ℤ G g - 1) * (of ℤ G h - 1) := by
    rw [map_mul]; noncomm_ring
  rw [e]
  exact sub_one_mul_sub_one_mem hg h

/-- `g^c − 1 ≡ c (g − 1) (mod Δⁿ)` for `g ∈ D_{n−1}`. -/
theorem mk_pow_sub_one {n : ℕ} {g : G} (hg : g ∈ D (n - 1) G) :
    ∀ c : ℕ, Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (g ^ c) - 1) =
      c • Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G g - 1)
  | 0 => by rw [pow_zero, map_one, sub_self, map_zero, zero_nsmul]
  | c + 1 => by
    rw [pow_succ', mk_mul_sub_one hg, mk_pow_sub_one hg c, succ_nsmul']

variable (G) in
/-- **§3.5**: `g ↦ (g − 1) mod Δⁿ` is a homomorphism `D_{n−1} → ℤ[G]/Δⁿ` (to the additive
group, written multiplicatively). -/
def sieveHom (n : ℕ) : D (n - 1) G →* Multiplicative (MonoidAlgebra ℤ G ⧸ augIdeal G ^ n) where
  toFun g := Multiplicative.ofAdd (Ideal.Quotient.mk _ (of ℤ G (g : G) - 1))
  map_one' := by
    show Multiplicative.ofAdd _ = 1
    rw [OneMemClass.coe_one, map_one, sub_self, map_zero, ofAdd_zero]
  map_mul' g h := by
    show Multiplicative.ofAdd _ = Multiplicative.ofAdd _ * Multiplicative.ofAdd _
    rw [← ofAdd_add, Subgroup.coe_mul, mk_mul_sub_one g.2]

theorem sieveHom_apply (n : ℕ) (g : D (n - 1) G) :
    sieveHom G n g = Multiplicative.ofAdd (Ideal.Quotient.mk _ (of ℤ G (g : G) - 1)) := rfl

/-- **§3.5**: the kernel of `sieveHom` is `D_n` (inside `D_{n−1}`). -/
theorem ker_sieveHom (n : ℕ) : (sieveHom G n).ker = (D n G).subgroupOf (D (n - 1) G) := by
  ext g
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, sieveHom_apply, ofAdd_eq_one,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Iff.rfl

/-- The sieve on a subgroup `K ≤ D_{n−1}`. -/
def sieveHomK {n : ℕ} {K : Subgroup G} (hK : K ≤ D (n - 1) G) :
    K →* Multiplicative (MonoidAlgebra ℤ G ⧸ augIdeal G ^ n) :=
  (sieveHom G n).comp (Subgroup.inclusion hK)

theorem sieveHomK_apply {n : ℕ} {K : Subgroup G} (hK : K ≤ D (n - 1) G) (g : K) :
    sieveHomK hK g = Multiplicative.ofAdd (Ideal.Quotient.mk _ (of ℤ G (g : G) - 1)) := rfl

/-- **§3.5**: for `K ≤ D_{n−1}`, `D_n ∩ K` is the kernel of `g ↦ (g − 1) mod Δⁿ` on `K`. -/
theorem ker_sieveHomK {n : ℕ} {K : Subgroup G} (hK : K ≤ D (n - 1) G) :
    (sieveHomK hK).ker = (D n G).subgroupOf K := by
  ext g
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, sieveHomK_apply, ofAdd_eq_one,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Iff.rfl

/-- The same, as a subgroup of `G`: the kernel is `D_n ⊓ K`. -/
theorem map_ker_sieveHomK {n : ℕ} {K : Subgroup G} (hK : K ≤ D (n - 1) G) :
    (sieveHomK hK).ker.map K.subtype = D n G ⊓ K := by
  rw [ker_sieveHomK, Subgroup.subgroupOf_map_subtype]

theorem ofFn_prod_mem (H : Subgroup G) {r : ℕ} (g : Fin r → G) (hg : ∀ i, g i ∈ H)
    (c : Fin r → ℕ) : (List.ofFn fun i => g i ^ c i).prod ∈ H := by
  induction r with
  | zero => simp
  | succ r ih =>
    have ih' : (List.ofFn fun i : Fin r => g i.succ ^ c i.succ).prod ∈ H :=
      ih (fun i => g i.succ) (fun i => hg i.succ) (fun i => c i.succ)
    simp only [List.ofFn_succ, List.prod_cons]
    exact H.mul_mem (H.pow_mem (hg 0) _) ih'

/-- `∏ g_i^{c_i} − 1 ≡ Σ c_i (g_i − 1) (mod Δⁿ)` for `g_i ∈ D_{n−1}`. -/
theorem mk_ofFn_prod_sub_one {n r : ℕ} (g : Fin r → G) (hg : ∀ i, g i ∈ D (n - 1) G)
    (c : Fin r → ℕ) :
    Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (List.ofFn fun i => g i ^ c i).prod - 1) =
      ∑ i, c i • Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (g i) - 1) := by
  induction r with
  | zero =>
    rw [List.ofFn_zero, List.prod_nil, map_one, sub_self, map_zero, Finset.univ_eq_empty,
      Finset.sum_empty]
  | succ r ih =>
    have ih' : Ideal.Quotient.mk (augIdeal G ^ n)
        (of ℤ G (List.ofFn fun i : Fin r => g i.succ ^ c i.succ).prod - 1) =
          ∑ i : Fin r, c i.succ • Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (g i.succ) - 1) :=
      ih (fun i => g i.succ) (fun i => hg i.succ) (fun i => c i.succ)
    simp only [List.ofFn_succ, List.prod_cons, Fin.sum_univ_succ]
    rw [mk_mul_sub_one (pow_mem (hg 0) _), mk_pow_sub_one (hg 0), ih']

end Sieve

section SieveA

variable {G : Type*} [Group G] (φ : FreeGroup X →* G)

/-- `quotEquiv` sends `(φ w − 1) mod Δⁿ` to `(μ(w) − 1) mod J_n`. -/
theorem quotEquiv_sub_one (hφ : Function.Surjective φ) (hker : φ.ker = Subgroup.normalClosure R0) (n : ℕ) (w : FreeGroup X) :
    quotEquiv φ R0 hφ hker n (Ideal.Quotient.mk _ (of ℤ G (φ w) - 1)) =
      Ideal.Quotient.mk (Jideal R0 n) ((muF n w : A X n) - 1) := by
  simp only [map_sub, map_one, quotEquiv_mk_of]

/-- **§3.5 in `A_n/J_n`**: for `g_i = φ(w_i) ∈ D_{n−1}` and `c ∈ ℕ^r`,
`∏ g_i^{c_i} ∈ D_n ⟺ Σ c_i (μ(w_i) − 1) ∈ J_n`. -/
theorem prod_mem_D_iff (hφ : Function.Surjective φ) (hker : φ.ker = Subgroup.normalClosure R0)
    {n r : ℕ} (w : Fin r → FreeGroup X) (hw : ∀ i, φ (w i) ∈ D (n - 1) G)
    (c : Fin r → ℕ) :
    (List.ofFn fun i => φ (w i) ^ c i).prod ∈ D n G ↔
      ∑ i, c i • ((muF n (w i) : A X n) - 1) ∈ Jideal R0 n := by
  have hL : Ideal.Quotient.mk (augIdeal G ^ n)
      (of ℤ G (List.ofFn fun i => φ (w i) ^ c i).prod - 1) =
        ∑ i, c i • Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (φ (w i)) - 1) :=
    mk_ofFn_prod_sub_one (fun i => φ (w i)) hw c
  have key : quotEquiv φ R0 hφ hker n (Ideal.Quotient.mk (augIdeal G ^ n)
      (of ℤ G (List.ofFn fun i => φ (w i) ^ c i).prod - 1)) =
        Ideal.Quotient.mk (Jideal R0 n) (∑ i, c i • ((muF n (w i) : A X n) - 1)) := by
    rw [hL, map_sum, map_sum]
    simp only [map_nsmul, quotEquiv_sub_one R0 φ hφ hker]
  rw [mem_D, ← Ideal.Quotient.eq_zero_iff_mem,
    ← Ideal.Quotient.eq_zero_iff_mem (I := Jideal R0 n), ← key]
  exact (quotEquiv φ R0 hφ hker n).map_eq_zero_iff.symm

/-- If `g = φ(w) ∈ D_{n−1}` and `g^p = 1`, then `p (μ(w) − 1) ∈ J_n`. -/
theorem nsmul_sub_one_mem_J (hφ : Function.Surjective φ) (hker : φ.ker = Subgroup.normalClosure R0)
    {n p : ℕ} (w : FreeGroup X) (hw : φ w ∈ D (n - 1) G)
    (hp : φ w ^ p = 1) : p • ((muF n w : A X n) - 1) ∈ Jideal R0 n := by
  have h := mk_pow_sub_one (n := n) hw p
  rw [hp, map_one, sub_self, map_zero] at h
  have h2 : quotEquiv φ R0 hφ hker n
      (p • Ideal.Quotient.mk (augIdeal G ^ n) (of ℤ G (φ w) - 1)) = 0 := by
    rw [← h, map_zero]
  rw [map_nsmul, quotEquiv_sub_one R0 φ hφ hker] at h2
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_nsmul]
  exact h2

theorem nsmul_mod_eq {M : Type*} [AddCommMonoid M] {p : ℕ} {v : M} (hv : p • v = 0) (m : ℕ) :
    (m % p) • v = m • v := by
  have hq : ∀ q : ℕ, (p * q) • v = 0 := by
    intro q
    induction q with
    | zero => rw [Nat.mul_zero, zero_nsmul]
    | succ q ih => rw [Nat.mul_succ, add_nsmul, ih, hv, add_zero]
  conv_rhs => rw [← Nat.mod_add_div m p]
  rw [add_nsmul, hq, add_zero]

/-- **§3.5**: `c ↦ Σ c_i v_i mod J_n`, `v_i = μ(w_i) − 1`, as an additive map on `(ZMod p)^r`
(well defined since `p v_i ∈ J_n`). -/
def sieveLin {n r p : ℕ} [NeZero p] (w : Fin r → FreeGroup X)
    (hp : ∀ i, p • ((muF n (w i) : A X n) - 1) ∈ Jideal R0 n) :
    (Fin r → ZMod p) →+ A X n ⧸ Jideal R0 n where
  toFun c := ∑ i, (c i).val • Ideal.Quotient.mk (Jideal R0 n) ((muF n (w i) : A X n) - 1)
  map_zero' := by simp
  map_add' c d := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hv : p • Ideal.Quotient.mk (Jideal R0 n) ((muF n (w i) : A X n) - 1) = 0 := by
      have := hp i
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_nsmul] at this
      exact this
    rw [Pi.add_apply, ZMod.val_add, nsmul_mod_eq hv, add_nsmul]

/-- **§3.5**: for `g_i = φ(w_i) ∈ D_{n−1}` with `g_i^p = 1`, the kernel of `c ↦ Σ c_i v_i`
modulo `J_n` consists of the `c ∈ (ZMod p)^r` with `∏ g_i^{c_i} ∈ D_n`. -/
theorem mem_ker_sieveLin (hφ : Function.Surjective φ) (hker : φ.ker = Subgroup.normalClosure R0)
    {n r p : ℕ} [NeZero p] (w : Fin r → FreeGroup X)
    (hw : ∀ i, φ (w i) ∈ D (n - 1) G) (hp : ∀ i, φ (w i) ^ p = 1) (c : Fin r → ZMod p) :
    c ∈ (sieveLin R0 w fun i => nsmul_sub_one_mem_J R0 φ hφ hker (w i) (hw i) (hp i)).ker ↔
      (List.ofFn fun i => φ (w i) ^ (c i).val).prod ∈ D n G := by
  rw [AddMonoidHom.mem_ker, prod_mem_D_iff R0 φ hφ hker w hw, ← Ideal.Quotient.eq_zero_iff_mem,
    map_sum]
  simp only [map_nsmul]
  exact Iff.rfl

end SieveA

end

end GroupDimension.Kernel.Sieve
