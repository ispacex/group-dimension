import GroupDimension.ClassFour

/-!
# Non-metabelian `p`-groups of class 4 have order `≥ p^(d+5)` (Proposition 6.5)

Let `p` be an odd prime and `Q` a finite `p`-group of class `≤ 4` with `Q'' ≠ 1`. Write
`|Q/γ₂| = p^{a₁}`, `|γ₂/γ₃| = p^{a₂}`, `|γ₃/γ₄| = p^{a₃}`, `|γ₄| = p^{a₄}` (the type). Then
`d(Q) ≤ a₁`, `a₂ ≥ 2`, `a₃, a₄ ≥ 1`, and `a₂ ≥ 3` or `a₃ ≥ 2` (Lemma 6.3); moreover `d(Q) ≥ 3`.
Hence `|Q| ≥ p^{d(Q)+5}` (`card_ge_of_not_metabelian`), and Proposition 6.5:

* (1) `|Q| ≤ p^7`, or `|Q| = p^8` and `d(Q) ≥ 4`, implies `Q` metabelian
  (`metabelian_of_card_le`);
* (2) `|Q| = p^9` and `Q'' ≠ 1` imply `d(Q) ∈ {3, 4}`, and for `d(Q) = 4` the type is
  `(4,3,1,1)` or `(4,2,2,1)` (`rank_of_card_nine`, `type_of_card_nine`).

`d(Q)` is Mathlib's `Group.rank Q`. The statement "for `p = 3` both types occur" is a
computation and is not formalized.

General facts proved on the way: a group of order `≤ p^n` (a `p`-group) is generated by `n`
elements (`exists_generators_card_le`); in a finite `p`-group, `H γ₂ = G` implies `H = G`
(`eq_top_of_sup_commutator`); if `G = ⟨x, y⟩`, then `γ₂/γ₃` is generated by `⁅x, y⁆`
(`gamma_two_mod_of_pair`); if `γ₂/γ₃` is cyclic, then `[γ₂, γ₂] ⊆ γ₅`
(`commutator_gamma_two_le_gamma_five_of_cyclic`).
-/

namespace GroupDimension

open Subgroup ClassFour
open scoped commutatorElement

variable {G : Type*} [Group G]

/-! ## Generators of finite `p`-groups -/

section Generators

variable {p : ℕ} [Fact p.Prime] [Finite G]

theorem exists_finset_closure_eq (hG : IsPGroup p G) (H : Subgroup G) (m : ℕ) :
    ∀ S : Finset G, (S : Set G) ⊆ H → Nat.card H ≤ p ^ m * Nat.card (closure (S : Set G)) →
      ∃ T : Finset G, closure (T : Set G) = H ∧ T.card ≤ S.card + m := by
  classical
  induction m with
  | zero =>
    intro S hS hcard
    refine ⟨S, ?_, by simp⟩
    exact eq_of_le_of_card_ge ((closure_le H).mpr hS) (by simpa using hcard)
  | succ m ih =>
    intro S hS hcard
    have hle : closure (S : Set G) ≤ H := (closure_le H).mpr hS
    by_cases hc : closure (S : Set G) = H
    · exact ⟨S, hc, by omega⟩
    obtain ⟨h, hH, hnot⟩ : ∃ h ∈ H, h ∉ closure (S : Set G) := by
      by_contra hcon
      push Not at hcon
      exact hc (le_antisymm hle fun h hh => hcon h hh)
    have hS' : ((insert h S : Finset G) : Set G) ⊆ H := by
      intro x hx
      rw [Finset.coe_insert] at hx
      rcases hx with rfl | hx
      · exact hH
      · exact hS hx
    have hsub : closure (S : Set G) ≤ closure ((insert h S : Finset G) : Set G) :=
      closure_mono (by simp)
    have hne : closure (S : Set G) ≠ closure ((insert h S : Finset G) : Set G) := by
      intro he
      apply hnot
      rw [he]
      exact subset_closure (by simp)
    have hgrow : p * Nat.card (closure (S : Set G)) ≤
        Nat.card (closure ((insert h S : Finset G) : Set G)) := by
      obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp (hG.to_subgroup (closure ((insert h S : Finset G) : Set G)))
      obtain ⟨b, hb⟩ := IsPGroup.iff_card.mp (hG.to_subgroup (closure (S : Set G)))
      have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
      have hba : b < a := by
        by_contra hab
        push Not at hab
        exact hne (eq_of_le_of_card_ge hsub (by rw [ha, hb]; exact Nat.pow_le_pow_right (by omega) hab))
      rw [ha, hb, ← pow_succ']
      exact Nat.pow_le_pow_right (by omega) hba
    obtain ⟨T, hT, hTc⟩ := ih (insert h S) hS' (by
      calc Nat.card H ≤ p ^ (m + 1) * Nat.card (closure (S : Set G)) := hcard
        _ = p ^ m * (p * Nat.card (closure (S : Set G))) := by ring
        _ ≤ p ^ m * Nat.card (closure ((insert h S : Finset G) : Set G)) :=
          Nat.mul_le_mul_left _ hgrow)
    refine ⟨T, hT, ?_⟩
    have := Finset.card_insert_le h S
    omega

/-- A `p`-group of order `≤ p^n` is generated by at most `n` elements. -/
theorem exists_generators_card_le (hG : IsPGroup p G) {n : ℕ} (hcard : Nat.card G ≤ p ^ n) :
    ∃ T : Finset G, closure (T : Set G) = ⊤ ∧ T.card ≤ n := by
  obtain ⟨T, hT, hc⟩ := exists_finset_closure_eq hG ⊤ n ∅ (by simp)
    (by simpa [Subgroup.card_top] using hcard)
  exact ⟨T, hT, by simpa using hc⟩

/-- In a finite `p`-group every maximal subgroup contains `γ₂`. -/
theorem commutator_le_of_isCoatom (hG : IsPGroup p G) {K : Subgroup G} (hK : IsCoatom K) :
    commutator G ≤ K := by
  have htf := isNilpotent_of_finite_tfae (G := G)
  have h02 := htf.out 0 2
  haveI : K.Normal := h02.mp hG.isNilpotent K hK
  obtain ⟨g, hg⟩ : ∃ g, g ∉ K := by
    by_contra h
    push Not at h
    exact hK.1 (eq_top_iff.mpr fun g _ => h g)
  haveI : Nontrivial (G ⧸ K) :=
    ⟨⟨(g : G ⧸ K), 1, fun h => hg ((QuotientGroup.eq_one_iff g).mp h)⟩⟩
  have hQ : IsPGroup p (G ⧸ K) := hG.to_quotient K
  haveI := hQ.center_nontrivial
  obtain ⟨z, hz⟩ := exists_ne (1 : center (G ⧸ K))
  obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective (z : G ⧸ K)
  have hC : (center (G ⧸ K)).comap (QuotientGroup.mk' K) = ⊤ := by
    refine hK.2 _ (lt_of_le_of_ne (fun k hk => ?_) fun he => ?_)
    · show (k : G ⧸ K) ∈ center (G ⧸ K)
      rw [(QuotientGroup.eq_one_iff k).mpr hk]
      exact one_mem _
    · have hxK : x ∈ (center (G ⧸ K)).comap (QuotientGroup.mk' K) := by
        show (x : G ⧸ K) ∈ center (G ⧸ K)
        rw [hx]; exact z.2
      rw [← he] at hxK
      apply hz
      exact Subtype.ext (by rw [← hx]; exact (QuotientGroup.eq_one_iff x).mpr hxK)
  rw [_root_.commutator_def, commutator_le]
  intro a _ b _
  have ha : (a : G ⧸ K) ∈ center (G ⧸ K) := by
    have : a ∈ (center (G ⧸ K)).comap (QuotientGroup.mk' K) := hC ▸ mem_top a
    exact this
  rw [← QuotientGroup.eq_one_iff]
  show QuotientGroup.mk' K ⁅a, b⁆ = 1
  rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
  exact ((mem_center_iff.mp ha) (QuotientGroup.mk' K b)).symm

/-- In a finite `p`-group, `H γ₂ = G` implies `H = G`. -/
theorem eq_top_of_sup_commutator (hG : IsPGroup p G) {H : Subgroup G}
    (h : H ⊔ commutator G = ⊤) : H = ⊤ := by
  by_contra hne
  obtain ⟨K, hK, hHK⟩ := (eq_top_or_exists_le_coatom H).resolve_left hne
  have := sup_le hHK (commutator_le_of_isCoatom hG hK)
  rw [h] at this
  exact hK.1 (top_le_iff.mp this)

/-- `d(G) ≤ a₁` where `|G/γ₂| ≤ p^{a₁}`. -/
theorem rank_le_of_index (hG : IsPGroup p G) {n : ℕ} (hn : (commutator G).index ≤ p ^ n) :
    Group.rank G ≤ n := by
  classical
  have hQ : IsPGroup p (G ⧸ commutator G) := hG.to_quotient _
  obtain ⟨T, hT, hTc⟩ := exists_generators_card_le hQ (n := n) hn
  set T' : Finset G := T.image (fun q => q.out)
  have hmap : (closure (T' : Set G)).map (QuotientGroup.mk' (commutator G)) = ⊤ := by
    rw [MonoidHom.map_closure, ← hT]
    congr 1
    ext q
    simp only [T', Finset.coe_image, Set.mem_image, Finset.mem_coe, exists_exists_and_eq_and,
      QuotientGroup.mk'_apply, QuotientGroup.out_eq', exists_eq_right]
  have hsup : closure (T' : Set G) ⊔ commutator G = ⊤ := by
    have := congrArg (Subgroup.comap (QuotientGroup.mk' (commutator G))) hmap
    rwa [comap_map_eq, QuotientGroup.ker_mk', comap_top] at this
  have htop := eq_top_of_sup_commutator hG hsup
  calc Group.rank G ≤ T'.card := Group.rank_le htop
    _ ≤ T.card := Finset.card_image_le
    _ ≤ n := hTc

end Generators

/-! ## Two-element sets and commuting generators -/

theorem exists_pair_of_card_le_two {X : Type*} [One X] (T : Finset X) (h : T.card ≤ 2) :
    ∃ t₁ t₂ : X, (T : Set X) ⊆ {t₁, t₂} ∧ (T.card ≤ 1 → t₂ = 1) := by
  classical
  interval_cases hc : T.card
  · rw [Finset.card_eq_zero] at hc
    exact ⟨1, 1, by simp [hc], fun _ => rfl⟩
  · obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp hc
    exact ⟨a, 1, by simp, fun _ => rfl⟩
  · obtain ⟨a, b, -, rfl⟩ := Finset.card_eq_two.mp hc
    exact ⟨a, b, by simp, fun h => absurd h (by omega)⟩

theorem mem_closure_pair_of_commute {X : Type*} [Group X] {t₁ t₂ : X} (hc : Commute t₁ t₂)
    {x : X} (hx : x ∈ closure ({t₁, t₂} : Set X)) : ∃ a b : ℤ, t₁ ^ a * t₂ ^ b = x := by
  induction hx using closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact ⟨1, 0, by simp⟩
    · exact ⟨0, 1, by simp⟩
  | one => exact ⟨0, 0, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    refine ⟨a + c, b + d, ?_⟩
    rw [zpow_add, zpow_add, mul_assoc, mul_assoc, ← mul_assoc (t₂ ^ b),
      ((hc.zpow_zpow c b).symm).eq, mul_assoc]
  | inv x _ hx =>
    obtain ⟨a, b, rfl⟩ := hx
    refine ⟨-a, -b, ?_⟩
    rw [mul_inv_rev, zpow_neg, zpow_neg, ((hc.zpow_zpow a b).inv_inv).eq]

/-! ## `G = ⟨x, y⟩` makes `γ₂/γ₃` cyclic -/

/-- In a group of class `≤ 2` generated by `x, y`, every commutator is a power of `⁅x, y⁆`. -/
theorem comm_mem_zpowers_of_class_two {H : Type*} [Group H] (h3 : lowerCentralSeries H 2 = ⊥)
    {x y : H} (hxy : closure ({x, y} : Set H) = ⊤) (g h : H) :
    ⁅g, h⁆ ∈ zpowers ⁅x, y⁆ := by
  have central : ∀ a b c : H, c * ⁅a, b⁆ * c⁻¹ = ⁅a, b⁆ := by
    intro a b c
    have h1 : ⁅c, ⁅a, b⁆⁆ = 1 := by
      have := commutator_mem_lcs (by norm_num : 0 + 1 + 1 = 2) (mem_lcs_zero c) (commutator_mem_lcs_one a b)
      rwa [h3, mem_bot] at this
    rw [conj_eq_comm_mul, h1, one_mul]
  have mulL : ∀ a b c : H, ⁅a * b, c⁆ = ⁅b, c⁆ * ⁅a, c⁆ := by
    intro a b c; rw [comm_mul_left, central]
  have mulR : ∀ a b c : H, ⁅a, b * c⁆ = ⁅a, b⁆ * ⁅a, c⁆ := by
    intro a b c; rw [comm_mul_right, central]
  have invL : ∀ a c : H, ⁅a⁻¹, c⁆ = ⁅a, c⁆⁻¹ := by
    intro a c
    have := mulL a⁻¹ a c
    rw [inv_mul_cancel, commutatorElement_one_left] at this
    exact eq_inv_of_mul_eq_one_right this.symm
  have invR : ∀ a c : H, ⁅a, c⁻¹⁆ = ⁅a, c⁆⁻¹ := by
    intro a c
    have := mulR a c c⁻¹
    rw [mul_inv_cancel, commutatorElement_one_right] at this
    exact eq_inv_of_mul_eq_one_right this.symm
  have w_mem : ⁅x, y⁆ ∈ zpowers ⁅x, y⁆ := mem_zpowers _
  -- first argument: generators
  have step1 : ∀ g : H, ⁅g, x⁆ ∈ zpowers ⁅x, y⁆ ∧ ⁅g, y⁆ ∈ zpowers ⁅x, y⁆ := by
    intro g
    have hg : g ∈ closure ({x, y} : Set H) := hxy ▸ mem_top g
    induction hg using closure_induction with
    | mem g hg =>
      rcases hg with rfl | rfl
      · exact ⟨by rw [commutatorElement_self]; exact one_mem _, w_mem⟩
      · exact ⟨by have h := inv_mem w_mem; rwa [commutatorElement_inv] at h,
          by rw [commutatorElement_self]; exact one_mem _⟩
    | one => exact ⟨by rw [commutatorElement_one_left]; exact one_mem _,
        by rw [commutatorElement_one_left]; exact one_mem _⟩
    | mul a b _ _ ha hb => exact ⟨by rw [mulL]; exact mul_mem hb.1 ha.1,
        by rw [mulL]; exact mul_mem hb.2 ha.2⟩
    | inv a _ ha => exact ⟨by rw [invL]; exact inv_mem ha.1, by rw [invL]; exact inv_mem ha.2⟩
  have hh : h ∈ closure ({x, y} : Set H) := hxy ▸ mem_top h
  induction hh using closure_induction with
  | mem h hh =>
    rcases hh with rfl | rfl
    · exact (step1 g).1
    · exact (step1 g).2
  | one => rw [commutatorElement_one_right]; exact one_mem _
  | mul a b _ _ ha hb => rw [mulR]; exact mul_mem ha hb
  | inv a _ ha => rw [invR]; exact inv_mem ha

/-- If `G = ⟨x, y⟩`, then `γ₂/γ₃` is generated by `⁅x, y⁆`. -/
theorem gamma_two_mod_of_pair {x y : G} (hxy : closure ({x, y} : Set G) = ⊤) :
    ∀ z ∈ lowerCentralSeries G 1, ∃ a : ℤ, (⁅x, y⁆ ^ a)⁻¹ * z ∈ lowerCentralSeries G 2 := by
  set N := lowerCentralSeries G 2
  set π := QuotientGroup.mk' N
  have hxy' : closure ({π x, π y} : Set (G ⧸ N)) = ⊤ := by
    rw [show ({π x, π y} : Set (G ⧸ N)) = π '' {x, y} by simp [Set.image_pair],
      ← MonoidHom.map_closure, hxy, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top]
    exact QuotientGroup.mk'_surjective N
  intro z hz
  have hz' : π z ∈ lowerCentralSeries (G ⧸ N) 1 := lcs_map_mk N 1 ▸ mem_map_of_mem π hz
  have hz'' : π z ∈ zpowers ⁅π x, π y⁆ := by
    have hle : lowerCentralSeries (G ⧸ N) 1 ≤ zpowers ⁅π x, π y⁆ := by
      show ⁅(⊤ : Subgroup (G ⧸ N)), ⊤⁆ ≤ _
      rw [commutator_le]
      intro g _ h _
      exact comm_mem_zpowers_of_class_two (lowerCentralSeries_quotient_eq_bot 2) hxy' g h
    exact hle hz'
  obtain ⟨a, ha⟩ := mem_zpowers_iff.mp hz''
  refine ⟨a, ?_⟩
  rw [← map_commutatorElement, ← map_zpow] at ha
  have := (QuotientGroup.eq (s := N)).mp ha
  simpa using this

/-! ## The cyclic case of Lemma 6.3 -/

/-- If `γ₅ = 1` and `γ₂ = ⟨c⟩γ₃`, then `[γ₂, γ₂] = 1`. -/
theorem commutator_eq_bot_of_cyclic (h5 : lowerCentralSeries G 4 = ⊥) {c : G}
    (hc : c ∈ lowerCentralSeries G 1)
    (hcg : ∀ z ∈ lowerCentralSeries G 1, ∃ a : ℤ, (c ^ a)⁻¹ * z ∈ lowerCentralSeries G 2) :
    ⁅lowerCentralSeries G 1, lowerCentralSeries G 1⁆ = ⊥ := by
  rw [eq_bot_iff, commutator_le]
  intro z hz z' hz'
  rw [mem_bot, commutatorElement_eq_one_iff_mul_comm]
  have hcomm : ∀ u ∈ lowerCentralSeries G 1, ∀ v ∈ lowerCentralSeries G 2, Commute u v :=
    fun u hu v hv => commutatorElement_eq_one_iff_mul_comm.mp (comm_eq_one h5 (by norm_num) hu hv)
  obtain ⟨a, ha⟩ := hcg z hz
  obtain ⟨b, hb⟩ := hcg z' hz'
  have e : z = c ^ a * ((c ^ a)⁻¹ * z) := (mul_inv_cancel_left _ _).symm
  have e' : z' = c ^ b * ((c ^ b)⁻¹ * z') := (mul_inv_cancel_left _ _).symm
  have hs : (c ^ a)⁻¹ * z ∈ lowerCentralSeries G 1 := lcs_mem_of_le (by norm_num) ha
  have h1 : Commute (c ^ a * ((c ^ a)⁻¹ * z)) (c ^ b * ((c ^ b)⁻¹ * z')) := by
    refine Commute.mul_left (Commute.mul_right (Commute.zpow_zpow_self c a b)
      (hcomm _ (zpow_mem hc a) _ hb)) (Commute.mul_right ((hcomm _ (zpow_mem hc b) _ ha).symm)
      (hcomm _ hs _ hb))
  rw [e, e']
  exact h1.eq

/-- `[γ₂, γ₂] ⊆ γ₅` follows from the same statement for `G/γ₅`. -/
theorem le_gamma_five_of_quotient
    (h : ⁅lowerCentralSeries (G ⧸ lowerCentralSeries G 4) 1,
      lowerCentralSeries (G ⧸ lowerCentralSeries G 4) 1⁆ = ⊥) :
    ⁅lowerCentralSeries G 1, lowerCentralSeries G 1⁆ ≤ lowerCentralSeries G 4 := by
  rw [← lcs_map_mk _ 1, ← map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  exact h

/-- **The cyclic case of Lemma 6.3**: if `γ₂/γ₃` is cyclic, then `[γ₂, γ₂] ⊆ γ₅`. -/
theorem commutator_gamma_two_le_gamma_five_of_cyclic {c : G} (hc : c ∈ lowerCentralSeries G 1)
    (hcg : ∀ z ∈ lowerCentralSeries G 1, ∃ a : ℤ, (c ^ a)⁻¹ * z ∈ lowerCentralSeries G 2) :
    ⁅lowerCentralSeries G 1, lowerCentralSeries G 1⁆ ≤ lowerCentralSeries G 4 := by
  set N := lowerCentralSeries G 4
  set π := QuotientGroup.mk' N
  apply le_gamma_five_of_quotient
  refine commutator_eq_bot_of_cyclic (lowerCentralSeries_quotient_eq_bot 4)
    (lcs_map_mk N 1 ▸ mem_map_of_mem π hc) ?_
  intro z hz
  rw [← lcs_map_mk N 1] at hz
  obtain ⟨z', hz', rfl⟩ := hz
  obtain ⟨a, ha⟩ := hcg z' hz'
  refine ⟨a, ?_⟩
  rw [← lcs_map_mk N 2, ← map_zpow, ← map_inv, ← map_mul]
  exact mem_map_of_mem π ha

/-! ## The type of a non-metabelian group of class 4 -/

section TypeBounds

variable {p : ℕ} [Fact p.Prime] [Finite G]

/-- **The type bounds.** For a finite `p`-group (`p` odd) with `γ₅ = 1` and `G'' ≠ 1` there are
`a₁, …, a₄` with `|G/γ₂| = p^{a₁}`, `|γ₂/γ₃| = p^{a₂}`, `|γ₃/γ₄| = p^{a₃}`, `|γ₄| = p^{a₄}`,
`d(G) ≤ a₁`, `3 ≤ d(G)`, `a₂ ≥ 2`, `a₃ ≥ 1`, `a₄ ≥ 1`, and `a₂ ≥ 3` or `a₃ ≥ 2`. -/
theorem type_bounds (hp2 : p ≠ 2) (hG : IsPGroup p G) (h5 : lowerCentralSeries G 4 = ⊥)
    (hm : derivedSeries G 2 ≠ ⊥) :
    ∃ a₁ a₂ a₃ a₄ : ℕ,
      (lowerCentralSeries G 1).index = p ^ a₁ ∧
      (lowerCentralSeries G 2).relIndex (lowerCentralSeries G 1) = p ^ a₂ ∧
      (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = p ^ a₃ ∧
      Nat.card (lowerCentralSeries G 3) = p ^ a₄ ∧
      Nat.card G = p ^ (a₁ + a₂ + a₃ + a₄) ∧
      Group.rank G ≤ a₁ ∧ 3 ≤ Group.rank G ∧ 2 ≤ a₂ ∧ 1 ≤ a₃ ∧ 1 ≤ a₄ ∧ (3 ≤ a₂ ∨ 2 ≤ a₃) := by
  classical
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  -- non-metabelian: `[γ₂, γ₂] ≠ 1`
  have hm' : ¬ ⁅lowerCentralSeries G 1, lowerCentralSeries G 1⁆ ≤ lowerCentralSeries G 4 := by
    rw [h5, le_bot_iff]; exact hm
  have h21 : lowerCentralSeries G 2 ≤ lowerCentralSeries G 1 := lowerCentralSeries_antitone (by norm_num)
  have h32 : lowerCentralSeries G 3 ≤ lowerCentralSeries G 2 := lowerCentralSeries_antitone (by norm_num)
  -- the exponents
  obtain ⟨a₁, ha₁⟩ := hG.index (lowerCentralSeries G 1)
  obtain ⟨a₂, ha₂⟩ := (hG.to_subgroup (lowerCentralSeries G 1)).index
    ((lowerCentralSeries G 2).subgroupOf (lowerCentralSeries G 1))
  obtain ⟨a₃, ha₃⟩ := (hG.to_subgroup (lowerCentralSeries G 2)).index
    ((lowerCentralSeries G 3).subgroupOf (lowerCentralSeries G 2))
  obtain ⟨a₄, ha₄⟩ := IsPGroup.iff_card.mp (hG.to_subgroup (lowerCentralSeries G 3))
  change (lowerCentralSeries G 2).relIndex (lowerCentralSeries G 1) = p ^ a₂ at ha₂
  change (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = p ^ a₃ at ha₃
  have hcard : Nat.card G = p ^ (a₁ + a₂ + a₃ + a₄) := by
    rw [← card_mul_index (lowerCentralSeries G 3), ← relIndex_mul_index h32,
      ← relIndex_mul_index h21, ha₁, ha₂, ha₃, ha₄]
    ring
  -- `γ₄ ≠ 1`
  have h4 : lowerCentralSeries G 3 ≠ ⊥ := by
    intro h
    apply hm'
    rw [h5]
    have := commutator_lcs_le (G := G) 1 1
    rw [show 1 + 1 + 1 = 3 from rfl, h] at this
    exact this
  have ha₄1 : 1 ≤ a₄ := by
    by_contra h
    apply h4
    rw [← Subgroup.card_eq_one, ha₄, show a₄ = 0 by omega, pow_zero]
  -- `γ₃ ≠ γ₄`
  have ha₃1 : 1 ≤ a₃ := by
    by_contra h
    apply h4
    have h1 : (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = 1 := by
      rw [ha₃, show a₃ = 0 by omega, pow_zero]
    rw [relIndex_eq_one] at h1
    have : lowerCentralSeries G 3 ≤ lowerCentralSeries G 4 :=
      (commutator_mono h1 le_rfl : ⁅lowerCentralSeries G 2, ⊤⁆ ≤ ⁅lowerCentralSeries G 3, ⊤⁆)
    rw [h5] at this
    exact le_bot_iff.mp this
  -- `γ₂/γ₃` with at most `p²` elements has two generators
  have two_gen : a₂ ≤ 2 → ∃ c₁ c₂ : G, c₁ ∈ lowerCentralSeries G 1 ∧ c₂ ∈ lowerCentralSeries G 1 ∧
      (a₂ ≤ 1 → c₂ ∈ lowerCentralSeries G 2) ∧ ∀ z ∈ lowerCentralSeries G 1, ∃ a b : ℤ,
        (c₁ ^ a * c₂ ^ b)⁻¹ * z ∈ lowerCentralSeries G 2 := by
    intro ha2
    set K := lowerCentralSeries G 1
    set M := (lowerCentralSeries G 2).subgroupOf K
    have hQ : IsPGroup p (K ⧸ M) := (hG.to_subgroup K).to_quotient M
    have hKM : Nat.card (K ⧸ M) = p ^ a₂ := ha₂
    obtain ⟨T, hT, hTc⟩ := exists_generators_card_le hQ (n := a₂) hKM.le
    obtain ⟨t₁, t₂, hTt, ht₂⟩ := exists_pair_of_card_le_two T (by omega)
    obtain ⟨k₁, rfl⟩ := QuotientGroup.mk_surjective t₁
    obtain ⟨k₂, rfl⟩ := QuotientGroup.mk_surjective t₂
    have hcl : closure ({(k₁ : K ⧸ M), (k₂ : K ⧸ M)} : Set (K ⧸ M)) = ⊤ :=
      top_le_iff.mp (hT ▸ closure_mono hTt)
    -- `γ₂/γ₃` is abelian
    have hab : Commute (k₁ : K ⧸ M) (k₂ : K ⧸ M) := by
      show ((k₁ * k₂ : K) : K ⧸ M) = ((k₂ * k₁ : K) : K ⧸ M)
      rw [QuotientGroup.eq, mem_subgroupOf]
      have e : (((k₁ * k₂ : K))⁻¹ * (k₂ * k₁) : K) = ⁅(k₂ : G)⁻¹, (k₁ : G)⁻¹⁆ := by
        simp only [commutatorElement_def, coe_mul, coe_inv]; group
      rw [e]
      exact commutator_mem_lcs (by norm_num) (mem_lcs_zero _) (inv_mem k₁.2)
    refine ⟨k₁, k₂, k₁.2, k₂.2, ?_, ?_⟩
    · intro h1
      have := (QuotientGroup.eq_one_iff k₂).mp (ht₂ (by omega))
      rwa [mem_subgroupOf] at this
    · intro z hz
      obtain ⟨a, b, hab'⟩ := mem_closure_pair_of_commute hab
        (hcl ▸ mem_top ((⟨z, hz⟩ : K) : K ⧸ M))
      refine ⟨a, b, ?_⟩
      rw [← QuotientGroup.mk_zpow, ← QuotientGroup.mk_zpow, ← QuotientGroup.mk_mul,
        QuotientGroup.eq, mem_subgroupOf] at hab'
      simpa using hab'
  have hcyc : ∀ c ∈ lowerCentralSeries G 1, (∀ z ∈ lowerCentralSeries G 1, ∃ a : ℤ,
      (c ^ a)⁻¹ * z ∈ lowerCentralSeries G 2) → False :=
    fun c hc hcg => hm' (commutator_gamma_two_le_gamma_five_of_cyclic hc hcg)
  -- `a₂ ≥ 2`
  have ha₂2 : 2 ≤ a₂ := by
    by_contra h
    obtain ⟨c₁, c₂, hc₁, _, hc₂, hcg⟩ := two_gen (by omega)
    refine hcyc c₁ hc₁ fun z hz => ?_
    obtain ⟨a, b, hab⟩ := hcg z hz
    refine ⟨a, ?_⟩
    have e : (c₁ ^ a)⁻¹ * z = c₂ ^ b * ((c₁ ^ a * c₂ ^ b)⁻¹ * z) := by group
    rw [e]
    exact mul_mem (zpow_mem (hc₂ (by omega)) b) hab
  -- `a₂ ≥ 3` or `a₃ ≥ 2`, by Lemma 6.3
  have hor : 3 ≤ a₂ ∨ 2 ≤ a₃ := by
    by_contra h
    push Not at h
    obtain ⟨c₁, c₂, hc₁, hc₂, -, hcg⟩ := two_gen (by omega)
    have h3 : (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = p := by
      rw [ha₃, show a₃ = 1 by omega, pow_one]
    exact hm' (commutator_gamma_two_le_gamma_five hp2 h3 hc₁ hc₂ hcg)
  -- `d(G) ≤ a₁`
  have hr : Group.rank G ≤ a₁ := rank_le_of_index hG (ha₁ ▸ le_rfl)
  -- `d(G) ≥ 3`
  have hr3 : 3 ≤ Group.rank G := by
    by_contra h
    obtain ⟨S, hS, hSt⟩ := Group.rank_spec G
    obtain ⟨x, y, hSxy, -⟩ := exists_pair_of_card_le_two S (by omega)
    have hxy : closure ({x, y} : Set G) = ⊤ := top_le_iff.mp (hSt ▸ closure_mono hSxy)
    exact hcyc _ (commutator_mem_lcs_one x y) (gamma_two_mod_of_pair hxy)
  exact ⟨a₁, a₂, a₃, a₄, ha₁, ha₂, ha₃, ha₄, hcard, hr, hr3, ha₂2, ha₃1, ha₄1, hor⟩

/-- **`|Q| ≥ p^{d(Q)+5}`** for a non-metabelian `p`-group of class `≤ 4`, `p` odd; also
`d(Q) ≥ 3`. -/
theorem card_ge_of_not_metabelian (hp2 : p ≠ 2) (hG : IsPGroup p G)
    (h5 : lowerCentralSeries G 4 = ⊥) (hm : derivedSeries G 2 ≠ ⊥) :
    3 ≤ Group.rank G ∧ p ^ (Group.rank G + 5) ≤ Nat.card G := by
  obtain ⟨a₁, a₂, a₃, a₄, -, -, -, -, hcard, hr, h3, h2, h3', h4, hor⟩ := type_bounds hp2 hG h5 hm
  refine ⟨h3, ?_⟩
  rw [hcard]
  exact Nat.pow_le_pow_right (Fact.out : p.Prime).pos (by omega)

/-- **Proposition 6.5 (1).** A `p`-group of class `≤ 4` (`p` odd) with `|Q| ≤ p^7`, or with
`|Q| = p^8` and `d(Q) ≥ 4`, is metabelian. -/
theorem metabelian_of_card_le (hp2 : p ≠ 2) (hG : IsPGroup p G)
    (h5 : lowerCentralSeries G 4 = ⊥)
    (h : Nat.card G ≤ p ^ 7 ∨ (Nat.card G = p ^ 8 ∧ 4 ≤ Group.rank G)) :
    derivedSeries G 2 = ⊥ := by
  by_contra hm
  obtain ⟨h3, hb⟩ := card_ge_of_not_metabelian hp2 hG h5 hm
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  rcases h with h | ⟨h, h4⟩
  · have := (Nat.pow_le_pow_iff_right hp1).mp (hb.trans h)
    omega
  · rw [h] at hb
    have := (Nat.pow_le_pow_iff_right hp1).mp hb
    omega

/-- **Proposition 6.5 (2), first part.** A non-metabelian `p`-group of class `≤ 4` and order
`p^9` (`p` odd) has `d(Q) ∈ {3, 4}`. -/
theorem rank_of_card_nine (hp2 : p ≠ 2) (hG : IsPGroup p G) (h5 : lowerCentralSeries G 4 = ⊥)
    (hm : derivedSeries G 2 ≠ ⊥) (hcard : Nat.card G = p ^ 9) :
    Group.rank G = 3 ∨ Group.rank G = 4 := by
  obtain ⟨h3, hb⟩ := card_ge_of_not_metabelian hp2 hG h5 hm
  rw [hcard] at hb
  have := (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp hb
  omega

/-- **Proposition 6.5 (2), second part.** For `d(Q) = 4` the type is `(4,3,1,1)` or
`(4,2,2,1)`. -/
theorem type_of_card_nine (hp2 : p ≠ 2) (hG : IsPGroup p G) (h5 : lowerCentralSeries G 4 = ⊥)
    (hm : derivedSeries G 2 ≠ ⊥) (hcard : Nat.card G = p ^ 9) (hr : Group.rank G = 4) :
    ((lowerCentralSeries G 1).index = p ^ 4 ∧
      (lowerCentralSeries G 2).relIndex (lowerCentralSeries G 1) = p ^ 3 ∧
      (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = p ∧
      Nat.card (lowerCentralSeries G 3) = p) ∨
    ((lowerCentralSeries G 1).index = p ^ 4 ∧
      (lowerCentralSeries G 2).relIndex (lowerCentralSeries G 1) = p ^ 2 ∧
      (lowerCentralSeries G 3).relIndex (lowerCentralSeries G 2) = p ^ 2 ∧
      Nat.card (lowerCentralSeries G 3) = p) := by
  obtain ⟨a₁, a₂, a₃, a₄, h1, h2, h3, h4, hc, hr1, -, ha2, ha3, ha4, hor⟩ :=
    type_bounds hp2 hG h5 hm
  have hsum : a₁ + a₂ + a₃ + a₄ = 9 :=
    Nat.pow_right_injective (Fact.out : p.Prime).two_le (hc.symm.trans hcard)
  rw [h1, h2, h3, h4]
  have e1 : a₁ = 4 := by omega
  have e4 : a₄ = 1 := by omega
  rw [e1, e4, pow_one]
  rcases hor with h | h
  · left
    rw [show a₂ = 3 by omega, show a₃ = 1 by omega, pow_one]
    exact ⟨rfl, rfl, rfl, rfl⟩
  · right
    rw [show a₂ = 2 by omega, show a₃ = 2 by omega]
    exact ⟨rfl, rfl, rfl, rfl⟩

end TypeBounds

end GroupDimension
