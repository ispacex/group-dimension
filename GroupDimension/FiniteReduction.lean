module

public import GroupDimension.Reduction
public import GroupDimension.CentralRoot

@[expose] public section

/-!
# From class `≤ 3` to finite `2`-groups of class `3` (Proposition 2.1, Remark 2.3)

`Reduction.lean` proves `DimensionQuestion5 ↔ D₅ = 1` for every group of class `≤ 3`. Here the
remaining steps of Proposition 2.1 of the paper are done:

* **finite generation** (`exists_closure_finset_mem_D`): if `x ∈ D_n(G)` then `x ∈ D_n(H)` for
  a subgroup `H` generated by a finite set. Proved: every element of `Δ(G)^n` comes from
  `Δ(H)^n` for such an `H`, and `ℤ[H] → ℤ[G]` is injective;
* **exponent two**: by Passi's `D₄² ⊆ γ₄` (`PassiDFourSquare`, a hypothesis);
* **finite `2`-quotients**: by Gruenberg's theorem (`GruenbergResidualTwo`, a hypothesis here;
  it is proved in `Gruenberg.lean`, and `DThreeCorollaries.lean` restates the results without it).

The result is `dimensionQuestion5_iff_finite_two_groups`; with `D₃ = γ₃` (`DThreeEqGammaThree`,
a hypothesis) one may ask for class exactly `3` (`dimensionQuestion5_iff_class_three`).

For finite groups Gruenberg's theorem is not needed: a finite nilpotent group is the direct
product of its Sylow subgroups (Mathlib's `Sylow.directProductOfNormal`), and an element of
order `2` survives in the projection to the Sylow `2`-subgroup. This gives the bounded form,
Remark 2.3 (`D_five_le_of_bounded`, for class `≤ 3`), with Passi's theorem as the only
hypothesis; for class exactly `3`, as in the paper, also `D₃ = γ₃`
(`D_five_le_of_bounded_class_three`).

The three hypotheses are the `def … : Prop` of `Statements.lean`; nothing is assumed globally.
`DThreeEqGammaThree` is proved in `DThree.lean` (which imports this file);
`DThreeCorollaries.lean` restates the theorems here without it.
-/

namespace GroupDimension

open MonoidAlgebra

section FiniteGeneration

variable {G : Type*} [Group G]

/-- `y ∈ ℤ[G]` is the image of an element of `Δ(H)^n`, `H` generated by a finite set. -/
def FinRep (n : ℕ) (y : MonoidAlgebra ℤ G) : Prop :=
  ∃ s : Finset G, ∃ z ∈ augIdeal (Subgroup.closure (s : Set G)) ^ n,
    mapDomainRingHom ℤ (Subgroup.closure (s : Set G)).subtype z = y

theorem iota_inclusion {K L : Subgroup G} (h : K ≤ L) (z : MonoidAlgebra ℤ K) :
    mapDomainRingHom ℤ L.subtype (mapDomainRingHom ℤ (Subgroup.inclusion h) z) =
      mapDomainRingHom ℤ K.subtype z := by
  induction z using CentralRoot.induction_of with
  | h0 => simp only [_root_.map_zero]
  | hof g => simp only [mapDomainRingHom_of]; rfl
  | hneg y hy => simp only [_root_.map_neg, hy]
  | hadd y z hy hz => simp only [_root_.map_add, hy, hz]

/-- Enlarging the finite set. -/
theorem FinRep.mono {n : ℕ} {s t : Finset G} (hst : s ⊆ t) {z : MonoidAlgebra ℤ _}
    (hz : z ∈ augIdeal (Subgroup.closure (s : Set G)) ^ n) :
    ∃ z' ∈ augIdeal (Subgroup.closure (t : Set G)) ^ n,
      mapDomainRingHom ℤ (Subgroup.closure (t : Set G)).subtype z' =
        mapDomainRingHom ℤ (Subgroup.closure (s : Set G)).subtype z := by
  have h : Subgroup.closure (s : Set G) ≤ Subgroup.closure (t : Set G) :=
    Subgroup.closure_mono (Finset.coe_subset.mpr hst)
  exact ⟨_, mapDomain_mem_augIdeal_pow (Subgroup.inclusion h) n hz, iota_inclusion h z⟩

theorem FinRep.add {n : ℕ} {y y' : MonoidAlgebra ℤ G} (hy : FinRep n y) (hy' : FinRep n y') :
    FinRep n (y + y') := by
  classical
  obtain ⟨s, z, hz, rfl⟩ := hy
  obtain ⟨t, z', hz', rfl⟩ := hy'
  obtain ⟨u, hu, hu'⟩ := FinRep.mono (t := s ∪ t) Finset.subset_union_left hz
  obtain ⟨v, hv, hv'⟩ := FinRep.mono (t := s ∪ t) Finset.subset_union_right hz'
  exact ⟨s ∪ t, u + v, add_mem hu hv, by rw [_root_.map_add, hu', hv']⟩

theorem finRep_zero (y : MonoidAlgebra ℤ G) : FinRep 0 y := by
  classical
  induction y using CentralRoot.induction_of with
  | h0 => exact ⟨∅, 0, zero_mem _, _root_.map_zero _⟩
  | hof g =>
    refine ⟨{g}, of ℤ _ ⟨g, Subgroup.subset_closure (by simp)⟩,
      by simp [Submodule.pow_zero, Ideal.one_eq_top], ?_⟩
    rw [mapDomainRingHom_of]; rfl
  | hneg y hy =>
    obtain ⟨s, z, hz, rfl⟩ := hy
    exact ⟨s, -z, neg_mem hz, _root_.map_neg _ _⟩
  | hadd y z hy hz => exact hy.add hz

/-- Every element of `Δ(G)^n` comes from `Δ(H)^n` for a finitely generated `H ≤ G`. -/
theorem finRep_of_mem {n : ℕ} {y : MonoidAlgebra ℤ G} (hy : y ∈ augIdeal G ^ n) :
    FinRep n y := by
  induction n generalizing y with
  | zero => exact finRep_zero y
  | succ n ih =>
    rw [Submodule.pow_succ] at hy
    refine Submodule.mul_induction_on hy (fun a ha b hb => ?_) (fun _ _ h h' => h.add h')
    classical
    obtain ⟨s, z, hz, rfl⟩ := ih ha
    obtain ⟨t, w, hw, rfl⟩ := finRep_zero b
    obtain ⟨u, hu, hu'⟩ := FinRep.mono (t := s ∪ t) Finset.subset_union_left hz
    obtain ⟨v, -, hv'⟩ := FinRep.mono (t := s ∪ t) Finset.subset_union_right hw
    refine ⟨s ∪ t, u * v, ?_, by rw [_root_.map_mul, hu', hv']⟩
    rw [Submodule.pow_succ]
    refine Ideal.mul_mem_mul hu ?_
    rw [mem_augIdeal, ← augmentation_mapDomain
      (Subgroup.closure ((s ∪ t : Finset G) : Set G)).subtype, hv']
    exact mem_augIdeal.mp hb

/-- **Finite generation.** If `x ∈ D_n(G)`, then `x ∈ D_n(H)` for a subgroup `H` generated by a
finite set. -/
theorem exists_closure_finset_mem_D {n : ℕ} {x : G} (hx : x ∈ D n G) :
    ∃ s : Finset G, ∃ hs : x ∈ Subgroup.closure (s : Set G),
      (⟨x, hs⟩ : Subgroup.closure (s : Set G)) ∈ D n (Subgroup.closure (s : Set G)) := by
  classical
  obtain ⟨s, z, hz, hzx⟩ := finRep_of_mem (mem_D.mp hx)
  obtain ⟨z', hz', hz'x⟩ := FinRep.mono (t := insert x s) (Finset.subset_insert x s) hz
  have hxs : x ∈ Subgroup.closure ((insert x s : Finset G) : Set G) :=
    Subgroup.subset_closure (by simp)
  refine ⟨insert x s, hxs, ?_⟩
  rw [mem_D]
  have hinj : Function.Injective
      (mapDomainRingHom ℤ (Subgroup.closure ((insert x s : Finset G) : Set G)).subtype) :=
    MonoidAlgebra.mapDomain_injective Subtype.val_injective
  have e : of ℤ _ (⟨x, hxs⟩ : Subgroup.closure ((insert x s : Finset G) : Set G)) - 1 = z' := by
    apply hinj
    rw [hz'x, hzx, _root_.map_sub, _root_.map_one, mapDomainRingHom_of]; rfl
  rw [e]; exact hz'

end FiniteGeneration

section Sylow

variable {G H : Type*} [Group G] [Group H]

/-- An injective homomorphism into a group with `γ_{k+1} = 1`: the source has `γ_{k+1} = 1`. -/
theorem lowerCentralSeries_eq_bot_of_injective (f : G →* H) (hf : Function.Injective f) {k : ℕ}
    (h : (⊤ : Subgroup H).lowerCentralSeries k = ⊥) : (⊤ : Subgroup G).lowerCentralSeries k = ⊥ :=
  (Subgroup.map_eq_bot_iff_of_injective _ hf).mp (le_bot_iff.mp (h ▸ ((Subgroup.map_lowerCentralSeries ⊤ f k).le.trans (Subgroup.lowerCentralSeries_mono k le_top))))

/-- In a finite nilpotent group an element `x ≠ 1` with `x² = 1` survives in the projection to
the Sylow `2`-subgroup. -/
theorem exists_sylow_two_proj [Finite G] (hG : Group.IsNilpotent G) {x : G} (hx2 : x ^ 2 = 1)
    (hx : x ≠ 1) : ∃ P : Sylow 2 G, ∃ π : G →* (P : Subgroup G), π x ≠ 1 := by
  have hn := ((Group.isNilpotent_of_finite_tfae (G := G)).out 1 4).mp hG
  let e := Sylow.directProductOfNormal (G := G) (fun {p} _ P => hn p inferInstance P)
  have h2 : 2 ∈ (Nat.card G).primeFactors := by
    rw [Nat.mem_primeFactors]
    refine ⟨Nat.prime_two, ?_, Nat.card_pos.ne'⟩
    rw [← orderOf_eq_prime hx2 hx]
    exact orderOf_dvd_natCard x
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow 2 G))
  let π : G →* (P : Subgroup G) :=
    { toFun := fun g => e.symm g ⟨2, h2⟩ P
      map_one' := by simp
      map_mul' := fun a b => by simp }
  refine ⟨P, π, fun h1 => hx ?_⟩
  have h1' : e.symm x ⟨2, h2⟩ P = 1 := h1
  have hsq : (e.symm x) ^ 2 = 1 := by rw [← map_pow, hx2, map_one]
  have he : e.symm x = 1 := by
    funext p Q
    obtain ⟨p, hpm⟩ := p
    by_cases hp : p = 2
    · subst hp
      haveI := Sylow.unique_of_normal P (hn 2 inferInstance P)
      obtain rfl : Q = P := Subsingleton.elim Q P
      exact h1'
    · have hpp : p.Prime := Nat.prime_of_mem_primeFactors hpm
      haveI : Fact p.Prime := ⟨hpp⟩
      have hc2 : (e.symm x ⟨p, hpm⟩ Q) ^ 2 = 1 := by
        have := congrFun (congrFun hsq ⟨p, hpm⟩) Q
        simpa using this
      obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.mp Q.isPGroup' (e.symm x ⟨p, hpm⟩ Q)
      have hdvd : p ^ k ∣ 2 := hk ▸ orderOf_dvd_of_pow_eq_one hc2
      have hcop : Nat.Coprime p 2 := (Nat.coprime_primes hpp Nat.prime_two).mpr hp
      have ho : orderOf (e.symm x ⟨p, hpm⟩ Q) = 1 :=
        hk.trans ((hcop.pow_left k).eq_one_of_dvd hdvd)
      rw [orderOf_eq_one_iff] at ho
      rw [ho]; rfl
  simpa using congrArg e he

end Sylow

/-! ## Proposition 2.1 -/

/-- The core of `(3) ⇒ (2)`: a finitely generated group `H` of class `≤ 3` has `D₅(H) = 1`
if all finite `2`-groups of class `≤ 3` do. -/
theorem D_five_eq_bot_of_fg (hP : PassiDFourSquare) (hG : GruenbergResidualTwo)
    (h : ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
      D 5 Q = ⊥)
    (H : Type) [Group H] (hfg : Group.FG H) (hH : (⊤ : Subgroup H).lowerCentralSeries 3 = ⊥) :
    D 5 H = ⊥ := by
  rw [eq_bot_iff]
  intro y hy
  rw [Subgroup.mem_bot]
  by_contra hy1
  have hy2 : y ^ 2 = 1 := by
    have := hP H y (D_antitone (by norm_num : 4 ≤ 5) hy)
    rwa [hH, Subgroup.mem_bot] at this
  obtain ⟨N, _, _, h2, hyN⟩ := hG H hfg (Subgroup.nilpotent_iff_lowerCentralSeries.mpr ⟨3, hH⟩) y
    (fun m hm => by
      obtain ⟨k, rfl⟩ := hm
      rw [pow_succ, pow_mul, hy2, one_pow, one_mul]
      exact hy1)
  have hQ : (⊤ : Subgroup (H ⧸ N)).lowerCentralSeries 3 = ⊥ := by
    apply le_bot_iff.mp
    calc (⊤ : Subgroup (H ⧸ N)).lowerCentralSeries 3
        ≤ ((⊤ : Subgroup H).lowerCentralSeries 3).map (QuotientGroup.mk' N) :=
          lowerCentralSeries_le_map_of_surjective _ (QuotientGroup.mk'_surjective N) 3
      _ = ⊥ := by rw [hH, Subgroup.map_bot]
  have hmem := map_mem_D (QuotientGroup.mk' N) hy
  rw [h (H ⧸ N) h2 hQ, Subgroup.mem_bot, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff] at hmem
  exact hyN hmem

/-- `(3) ⇒ (2)` of Proposition 2.1, for one group of class `≤ 3`. -/
theorem D_five_eq_bot_of_two_groups (hP : PassiDFourSquare) (hG : GruenbergResidualTwo)
    (h : ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
      D 5 Q = ⊥)
    (M : Type) [Group M] (hM : (⊤ : Subgroup M).lowerCentralSeries 3 = ⊥) : D 5 M = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨s, hs, hxH⟩ := exists_closure_finset_mem_D hx
  have hH := D_five_eq_bot_of_fg hP hG h (Subgroup.closure (s : Set M))
    ((Group.fg_iff_subgroup_fg _).mpr ((Subgroup.fg_iff _).mpr ⟨_, rfl, s.finite_toSet⟩))
    (lowerCentralSeries_eq_bot_of_injective (Subgroup.closure (s : Set M)).subtype
      (Subgroup.subtype_injective _) hM)
  rw [hH, Subgroup.mem_bot] at hxH
  rw [Subgroup.mem_bot]
  exact congrArg Subtype.val hxH

/-- **Proposition 2.1, `(1) ⇔ (3)`.** Given Passi's `D₄² ⊆ γ₄` and Gruenberg's theorem,
`D₅(G) ⊆ γ₄(G)` for all groups iff `D₅(Q) = 1` for all finite `2`-groups of class `≤ 3`. -/
theorem dimensionQuestion5_iff_finite_two_groups (hP : PassiDFourSquare)
    (hG : GruenbergResidualTwo) :
    DimensionQuestion5 ↔
      ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
        D 5 Q = ⊥ := by
  rw [dimensionQuestion5_iff]
  exact ⟨fun h Q _ _ _ hQ => h Q hQ, fun h M _ hM => D_five_eq_bot_of_two_groups hP hG h M hM⟩

/-- Class `≤ 2` has `D₅ = 1`, given `D₃ = γ₃`. -/
theorem D_five_eq_bot_of_class_two (hD3 : DThreeEqGammaThree) (Q : Type) [Group Q]
    (h3 : (⊤ : Subgroup Q).lowerCentralSeries 2 = ⊥) : D 5 Q = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  have hg3 : g ∈ D 3 Q := D_antitone (by norm_num : 3 ≤ 5) hg
  rwa [hD3 Q, h3] at hg3

/-- **Proposition 2.1 with class exactly `3`**, given also `D₃ = γ₃` to exclude class `≤ 2`.
The paper's word "metabelian" is dropped by Remark 2.2 (class `≤ 3` implies metabelian), which
is not formalized. -/
theorem dimensionQuestion5_iff_class_three (hD3 : DThreeEqGammaThree) (hP : PassiDFourSquare)
    (hG : GruenbergResidualTwo) :
    DimensionQuestion5 ↔
      ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
        (⊤ : Subgroup Q).lowerCentralSeries 2 ≠ ⊥ → D 5 Q = ⊥ := by
  rw [dimensionQuestion5_iff_finite_two_groups hP hG]
  refine ⟨fun h Q _ _ h2 hQ _ => h Q h2 hQ, fun h Q _ _ h2 hQ => ?_⟩
  by_cases h3 : (⊤ : Subgroup Q).lowerCentralSeries 2 = ⊥
  · exact D_five_eq_bot_of_class_two hD3 Q h3
  · exact h Q h2 hQ h3

/-! ## Remark 2.3: the bounded form -/

/-- **Remark 2.3.** If `D₅(Q) = 1` for all `2`-groups `Q` of class `≤ 3` and order `≤ 2^k`, then
`D₅(G) ⊆ γ₄(G)` for every finite `G` whose Sylow `2`-subgroups have order `≤ 2^k`. Only Passi's
theorem is assumed: the finite `2`-quotient is the Sylow `2`-subgroup of `G/γ₄(G)`. -/
theorem D_five_le_of_bounded (hP : PassiDFourSquare) (k : ℕ)
    (h : ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
      Nat.card Q ≤ 2 ^ k → D 5 Q = ⊥)
    (G : Type) [Group G] [Finite G] (hG : ∀ P : Sylow 2 G, Nat.card P ≤ 2 ^ k) :
    D 5 G ≤ (⊤ : Subgroup G).lowerCentralSeries 3 := by
  apply D_le_of_D_quotient_eq_bot
  have hM : (⊤ : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 3)).lowerCentralSeries 3 = ⊥ :=
    lowerCentralSeries_quotient_eq_bot 3
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_bot]
  by_contra hx1
  have hx2 : x ^ 2 = 1 := by
    have := hP _ x (D_antitone (by norm_num : 4 ≤ 5) hx)
    rwa [hM, Subgroup.mem_bot] at this
  obtain ⟨P, π, hπ⟩ :=
    exists_sylow_two_proj (Subgroup.nilpotent_iff_lowerCentralSeries.mpr ⟨3, hM⟩) hx2 hx1
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hPγ : (⊤ : Subgroup (P : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 3))).lowerCentralSeries 3 = ⊥ :=
    lowerCentralSeries_eq_bot_of_injective (P : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 3)).subtype
      (Subgroup.subtype_injective _) hM
  have hcard : Nat.card (P : Subgroup (G ⧸ (⊤ : Subgroup G).lowerCentralSeries 3)) ≤ 2 ^ k := by
    obtain ⟨PG⟩ := (inferInstance : Nonempty (Sylow 2 G))
    refine le_trans ?_ (hG PG)
    rw [Sylow.card_eq_multiplicity, Sylow.card_eq_multiplicity]
    apply Nat.pow_le_pow_right two_pos
    exact (Nat.factorization_le_iff_dvd Nat.card_pos.ne' Nat.card_pos.ne').mpr
      (Subgroup.card_quotient_dvd_card _) 2
  have hm := map_mem_D π hx
  rw [h _ P.isPGroup' hPγ hcard, Subgroup.mem_bot] at hm
  exact hπ hm

/-- **Remark 2.3 with class exactly `3`**, as in the paper; class `≤ 2` is excluded with
`D₃ = γ₃`. -/
theorem D_five_le_of_bounded_class_three (hD3 : DThreeEqGammaThree) (hP : PassiDFourSquare)
    (k : ℕ)
    (h : ∀ (Q : Type) [Group Q] [Finite Q], IsPGroup 2 Q → (⊤ : Subgroup Q).lowerCentralSeries 3 = ⊥ →
      (⊤ : Subgroup Q).lowerCentralSeries 2 ≠ ⊥ → Nat.card Q ≤ 2 ^ k → D 5 Q = ⊥)
    (G : Type) [Group G] [Finite G] (hG : ∀ P : Sylow 2 G, Nat.card P ≤ 2 ^ k) :
    D 5 G ≤ (⊤ : Subgroup G).lowerCentralSeries 3 := by
  refine D_five_le_of_bounded hP k (fun Q _ _ h2 hQ hc => ?_) G hG
  by_cases h3 : (⊤ : Subgroup Q).lowerCentralSeries 2 = ⊥
  · exact D_five_eq_bot_of_class_two hD3 Q h3
  · exact h Q h2 hQ h3 hc

end GroupDimension
