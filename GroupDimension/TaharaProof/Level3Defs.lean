import GroupDimension.TaharaProof.Level1

/-!
# Level 3: the target `W₃* ⊕ W₄`, symbols, and `R₅*` ([Tah81, §5])

For a frame of a finite group of class `≤ 4` (`Frame.Class4`) we set up Tahara's Theorem 5.1:

* `M3 = W₃* ⊕ W₄` in coordinates: the free abelian group on `Sp³` (sorted triples of letters of
  weight 1), `A₁ ⊗ A₂` (pairs of letters of weights 1, 2) and `A₃` (letters of weight 3); and
  `W₄`: `Sp⁴(A₁)`, `Sp²(A₁) ⊗ A₂`, `A₁ ⊗ A₃`, `Sp²(A₂)` with their cyclic orders, and
  `A₄ = γ₄`.
* The *symbol* `Φ3 a` of an `m`-sequence, read off its (sorted) word: `x̄_i ∨ x̄_j ∨ x̄_k`,
  `x̄_i ⊗ x̄_k`, `x̄_l`, …, and `0` in weight `≠ 3, 4`.
* `nsum y β = ∑_m n_y(m) Φ(β + e_m)`, the symbol of `P(β) (y - 1)` to first order (`n_y` the
  normal form of `y`).
* `V3val i j`: Tahara's value (3) of `ψ₃` on `d(i)(x_i - 1)(x_j - 1)`.
* `R5`: the subgroup generated by Tahara's (I)–(VII), each written as the identity that the
  corresponding reduction produces.
-/

namespace GroupDimension

namespace TaharaProof

open MonoidAlgebra Tahara ExpThree ClassFour

variable {G : Type*} [Group G] {ι : Type*} [LinearOrder ι] [Fintype ι]

/-! ## Counting vectors of short words -/

/-- The `m`-sequence counting the letters of a list. -/
def cnt (l : List ι) : ι → ℕ := fun j => l.count j

theorem word_cnt {l : List ι} (hl : l.Pairwise (· ≤ ·)) : Frame.word (cnt l) = l :=
  Frame.word_eq hl fun _ => rfl

theorem cnt_append (l l' : List ι) : cnt (l ++ l') = cnt l + cnt l' := by
  funext j; simp [cnt, List.count_append]

theorem cnt_single (i : ι) : cnt [i] = Pi.single i 1 := by
  funext j; by_cases h : j = i
  · subst h; simp [cnt]
  · simp [cnt, Pi.single_eq_of_ne h, List.count_singleton, Ne.symm h]

theorem cnt_nil : cnt ([] : List ι) = 0 := by funext j; simp [cnt]

namespace Frame

variable (F : Frame G ι)

theorem P_cnt {l : List ι} (hl : l.Pairwise (· ≤ ·)) :
    F.P (cnt l) = (l.map F.X).prod :=
  (prod_map_eq_lprod F.X l hl).symm

theorem W_cnt (l : List ι) : F.W (cnt l) = (l.map F.w).sum := by
  induction l with
  | nil => simp [cnt_nil, W]
  | cons j l ih =>
    rw [show j :: l = [j] ++ l from rfl, cnt_append, W_add, ih, cnt_single, W_single]
    simp

/-! ## Hypotheses -/

/-- A frame of a group of class `≤ 4` with Tahara's divisibility chains in each layer. -/
structure Class4 : Prop where
  top : lowerCentralSeries G 4 = ⊥
  w_le : ∀ j, F.w j ≤ 4
  one_lt : ∀ j, 1 < F.o j
  dvd : ∀ i j, F.w i = F.w j → i ≤ j → F.o i ∣ F.o j

/-! ## The target -/

/-- `W₃*`: free on `Sp³(A₁)` (sorted triples), `A₁ ⊗ A₂`, `A₃`. -/
abbrev V3 := (ι × ι × ι → ℤ) × (ι × ι → ℤ) × (ι → ℤ)

/-- `W₄` in coordinates; the orders use the divisibility chains. -/
abbrev W4 := ((q : ι × ι × ι × ι) → ZMod (F.o q.1)) ×
  ((q : ι × ι × ι) → ZMod (Nat.gcd (F.o q.1) (F.o q.2.2))) ×
  ((q : ι × ι) → ZMod (Nat.gcd (F.o q.1) (F.o q.2))) × ((q : ι × ι) → ZMod (F.o q.1)) ×
  Additive (Layer G 3)

/-- Tahara's `W₃* ⊕ W₄`. -/
abbrev M3 := (V3 (ι := ι)) × F.W4

/-- `x̄_i ∨ x̄_j ∨ x̄_k ∈ W₃*` (`i ≤ j ≤ k`). -/
def E3 (i j k : ι) : F.M3 := ((Pi.single (i, j, k) 1, 0, 0), 0)

/-- `x̄_i ⊗ x̄_k ∈ W₃*` (weights `1, 2`). -/
def E12 (i k : ι) : F.M3 := ((0, Pi.single (i, k) 1, 0), 0)

/-- `x̄_l ∈ W₃*` (weight 3). -/
def E3' (l : ι) : F.M3 := ((0, 0, Pi.single l 1), 0)

/-- `x̄_i ∨ x̄_j ∨ x̄_k ∨ x̄_l ∈ Sp⁴(A₁)`. -/
def S4 (i j k l : ι) : F.M3 := (0, (Pi.single (i, j, k, l) 1, 0, 0, 0, 0))

/-- `(x̄_i ∨ x̄_j) ⊗ x̄_k ∈ Sp²(A₁) ⊗ A₂`. -/
def S22 (i j k : ι) : F.M3 := (0, (0, Pi.single (i, j, k) 1, 0, 0, 0))

/-- `x̄_i ⊗ x̄_l ∈ A₁ ⊗ A₃`. -/
def T13 (i l : ι) : F.M3 := (0, (0, 0, Pi.single (i, l) 1, 0, 0))

/-- `x̄_k ∨ x̄_l ∈ Sp²(A₂)`. -/
def S2' (k l : ι) : F.M3 := (0, (0, 0, 0, Pi.single (k, l) 1, 0))

/-- The class of `g ∈ γ₄` in `A₄`. -/
noncomputable def A4 (g : G) : F.M3 := (0, (0, 0, 0, 0, cl G 3 g))

/-- The symbol of a sorted word. -/
noncomputable def Φ3w : List ι → F.M3
  | [l] => if F.w l = 3 then F.E3' l else if F.w l = 4 then F.A4 (F.x l) else 0
  | [i, j] =>
    if F.w i = 1 ∧ F.w j = 2 then F.E12 i j
    else if F.w i = 1 ∧ F.w j = 3 then F.T13 i j
    else if F.w i = 2 ∧ F.w j = 2 then F.S2' i j else 0
  | [i, j, k] =>
    if F.w i = 1 ∧ F.w j = 1 ∧ F.w k = 1 then F.E3 i j k
    else if F.w i = 1 ∧ F.w j = 1 ∧ F.w k = 2 then F.S22 i j k else 0
  | [i, j, k, l] => if F.w i = 1 ∧ F.w j = 1 ∧ F.w k = 1 ∧ F.w l = 1 then F.S4 i j k l else 0
  | _ => 0

/-- The symbol of an `m`-sequence. -/
noncomputable def Φ3 (a : ι → ℕ) : F.M3 := F.Φ3w (word a)

theorem Φ3_cnt {l : List ι} (hl : l.Pairwise (· ≤ ·)) :
    F.Φ3 (cnt l) = F.Φ3w l := by
  rw [Φ3, word_cnt hl]

theorem Φ3w_long {l : List ι} (h : 5 ≤ l.length) : F.Φ3w l = 0 := by
  match l, h with
  | [], h => simp at h
  | [_], h => simp at h
  | [_, _], h => simp at h
  | [_, _, _], h => simp at h
  | [_, _, _, _], h => simp at h
  | _ :: _ :: _ :: _ :: _ :: _, _ => rfl

/-- The symbol vanishes outside weights `3, 4`. -/
theorem Φ3_eq_zero_of_W {a : ι → ℕ} (h : F.W a ≠ 3 ∧ F.W a ≠ 4) : F.Φ3 a = 0 := by
  have hW := F.W_eq_word a
  unfold Φ3
  generalize word a = l at hW
  have hp := F.w_pos
  match l with
  | [] => rfl
  | [i] =>
    simp at hW
    simp only [Φ3w]; rw [if_neg (by omega), if_neg (by omega)]
  | [i, j] =>
    simp at hW
    have := hp i; have := hp j
    simp only [Φ3w]; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega)]
  | [i, j, k] =>
    simp at hW
    have := hp i; have := hp j; have := hp k
    simp only [Φ3w]; rw [if_neg (by omega), if_neg (by omega)]
  | [i, j, k, l] =>
    simp at hW
    have := hp i; have := hp j; have := hp k; have := hp l
    simp only [Φ3w]; rw [if_neg (by omega)]
  | _ :: _ :: _ :: _ :: _ :: _ => rfl

theorem Φ3_eq_zero_of_five_le {a : ι → ℕ} (h : 5 ≤ F.W a) : F.Φ3 a = 0 :=
  F.Φ3_eq_zero_of_W ⟨by omega, by omega⟩

/-! ## Normal-form coordinates and first-order symbols -/

/-- The normal form of `y`. -/
noncomputable def nfc (y : G) : ι → ℕ := (F.nfEquiv.symm y).val

theorem nfc_lt (y : G) (j : ι) : F.nfc y j < F.o j := (F.nfEquiv.symm y).val_lt j

theorem nprod_nfc (y : G) : F.nprod (F.nfc y) = y := F.nfEquiv.apply_symm_apply y

theorem nfc_eq {b : ι → ℕ} (hb : ∀ j, b j < F.o j) {y : G} (h : F.nprod b = y) : F.nfc y = b :=
  F.nf_unique _ _ (F.nfc_lt y) hb ((F.nprod_nfc y).trans h.symm)

/-- `nsum y β = ∑_m n_y(m) Φ(β + e_m)`: the symbol of `P(β)(y - 1)` to first order. -/
noncomputable def nsum (y : G) (β : ι → ℕ) : F.M3 :=
  ∑ m, (F.nfc y m : ℤ) • F.Φ3 (β + Pi.single m 1)

/-! ## Tahara's value (3) and the relations (I)–(VII) -/

/-- `y_i = x_i^{o_i}`. -/
def yy (i : ι) : G := F.x i ^ F.o i

/-- `[x_i^{o_i}, x_j]` (Tahara's commutator). -/
def cc (i j : ι) : G := tc (F.yy i) (F.x j)

/-- Tahara's value (3): `ψ₃(d(i)(x_i - 1)(x_j - 1))` for letters `i ≤ j` of weight 1. -/
noncomputable def V3val (i j : ι) : F.M3 :=
  F.nsum (F.yy i) (cnt [j]) + F.nsum (F.cc i j) 0 + F.nsum (F.cc i j) (cnt [j]) -
    ((F.o i).choose 2 : ℤ) • F.Φ3 (cnt [i, i, j]) - ((F.o i).choose 3 : ℤ) • F.Φ3 (cnt [i, i, i, j])

/-- (I): `f(l) x̄_l - \overline{x_l^{f(l)}}`. -/
noncomputable def gI (l : ι) : F.M3 := (F.o l : ℤ) • F.Φ3 (cnt [l]) - F.nsum (F.yy l) 0

/-- (II), for `i < j` of weight 1. -/
noncomputable def gII (i j : ι) : F.M3 :=
  F.nsum (F.yy j) (cnt [i]) - ((F.o j / F.o i : ℕ) : ℤ) • F.V3val i j -
    ((F.o j).choose 2 : ℤ) • F.Φ3 (cnt [i, j, j]) - ((F.o j).choose 3 : ℤ) • F.Φ3 (cnt [i, j, j, j])

/-- (III), for `i` of weight 1 and `k` of weight 2. -/
noncomputable def gIII (i k : ι) : F.M3 :=
  F.nsum (F.yy i) (cnt [k]) +
    ∑ m, (F.nfc (F.yy i) m : ℤ) • (if k < m then F.nsum (tc (F.x m) (F.x k)) 0 else 0) -
    (F.o i : ℤ) • F.Φ3 (cnt [i, k]) - ((F.o i).choose 2 : ℤ) • F.Φ3 (cnt [i, i, k])

/-- (IV), for `i` of weight 1 and `k` of weight 2. -/
noncomputable def gIV (i k : ι) : F.M3 :=
  F.nsum (F.yy k) (cnt [i]) - (F.o k : ℤ) • F.Φ3 (cnt [i, k])

/-- (V), for `i ≤ j ≤ k` of weight 1 (the power on the first letter). -/
noncomputable def gV (i j k : ι) : F.M3 :=
  F.nsum (F.yy i) (cnt [j, k]) + F.nsum (F.cc i k) (cnt [j]) + F.nsum (F.cc i j) (cnt [k]) +
    F.nsum (tc (F.cc i j) (F.x k)) 0 -
    (F.o i : ℤ) • F.Φ3 (cnt [i, j, k]) - ((F.o i).choose 2 : ℤ) • F.Φ3 (cnt [i, i, j, k])

/-- (VI), for `i ≤ j ≤ k` of weight 1 (the power on the middle letter). -/
noncomputable def gVI (i j k : ι) : F.M3 :=
  F.nsum (F.yy j) (cnt [i, k]) + F.nsum (F.cc j k) (cnt [i]) -
    (F.o j : ℤ) • F.Φ3 (cnt [i, j, k]) - ((F.o j).choose 2 : ℤ) • F.Φ3 (cnt [i, j, j, k])

/-- (VII), for `i ≤ j < k` of weight 1 (the power on the last letter). -/
noncomputable def gVII (i j k : ι) : F.M3 :=
  F.nsum (F.yy k) (cnt [i, j]) -
    (F.o k : ℤ) • F.Φ3 (cnt [i, j, k]) - ((F.o k).choose 2 : ℤ) • F.Φ3 (cnt [i, j, k, k])

/-- Index sets of the relations. -/
abbrev IdxI := {l : ι // F.w l = 3}
abbrev IdxII := {p : ι × ι // F.w p.1 = 1 ∧ F.w p.2 = 1 ∧ p.1 < p.2}
abbrev Idx12 := {p : ι × ι // F.w p.1 = 1 ∧ F.w p.2 = 2}
abbrev Idx111 := {q : ι × ι × ι // F.w q.1 = 1 ∧ F.w q.2.1 = 1 ∧ F.w q.2.2 = 1 ∧
  q.1 ≤ q.2.1 ∧ q.2.1 ≤ q.2.2}
abbrev Idx111' := {q : ι × ι × ι // F.w q.1 = 1 ∧ F.w q.2.1 = 1 ∧ F.w q.2.2 = 1 ∧
  q.1 ≤ q.2.1 ∧ q.2.1 < q.2.2}

/-- Tahara's `R₅*`, generated by (I)–(VII). -/
noncomputable def R5 : Submodule ℤ F.M3 :=
  Submodule.span ℤ (Set.range fun l : F.IdxI => F.gI l.1) ⊔
  Submodule.span ℤ (Set.range fun p : F.IdxII => F.gII p.1.1 p.1.2) ⊔
  Submodule.span ℤ (Set.range fun p : F.Idx12 => F.gIII p.1.1 p.1.2) ⊔
  Submodule.span ℤ (Set.range fun p : F.Idx12 => F.gIV p.1.1 p.1.2) ⊔
  Submodule.span ℤ (Set.range fun q : F.Idx111 => F.gV q.1.1 q.1.2.1 q.1.2.2) ⊔
  Submodule.span ℤ (Set.range fun q : F.Idx111 => F.gVI q.1.1 q.1.2.1 q.1.2.2) ⊔
  Submodule.span ℤ (Set.range fun q : F.Idx111' => F.gVII q.1.1 q.1.2.1 q.1.2.2)

theorem gI_mem {l : ι} (h : F.w l = 3) : F.gI l ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  exact Submodule.subset_span ⟨⟨l, h⟩, rfl⟩

theorem gII_mem {i j : ι} (hi : F.w i = 1) (hj : F.w j = 1) (h : i < j) : F.gII i j ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, j), hi, hj, h⟩, rfl⟩

theorem gIII_mem {i k : ι} (hi : F.w i = 1) (hk : F.w k = 2) : F.gIII i k ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, k), hi, hk⟩, rfl⟩

theorem gIV_mem {i k : ι} (hi : F.w i = 1) (hk : F.w k = 2) : F.gIV i k ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, k), hi, hk⟩, rfl⟩

theorem gV_mem {i j k : ι} (hi : F.w i = 1) (hj : F.w j = 1) (hk : F.w k = 1) (hij : i ≤ j)
    (hjk : j ≤ k) : F.gV i j k ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, j, k), hi, hj, hk, hij, hjk⟩, rfl⟩

theorem gVI_mem {i j k : ι} (hi : F.w i = 1) (hj : F.w j = 1) (hk : F.w k = 1) (hij : i ≤ j)
    (hjk : j ≤ k) : F.gVI i j k ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_left
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, j, k), hi, hj, hk, hij, hjk⟩, rfl⟩

theorem gVII_mem {i j k : ι} (hi : F.w i = 1) (hj : F.w j = 1) (hk : F.w k = 1) (hij : i ≤ j)
    (hjk : j < k) : F.gVII i j k ∈ F.R5 := by
  unfold R5
  apply Submodule.mem_sup_right
  exact Submodule.subset_span ⟨⟨(i, j, k), hi, hj, hk, hij, hjk⟩, rfl⟩

end Frame

end TaharaProof

end GroupDimension
