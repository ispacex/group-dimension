import GroupDimension.TaharaProof.Induction
import GroupDimension.DTwo

/-!
# `Δ^n ⊆ Λ_n` and `D₃ = γ₃` for finite groups ([Tah81, Theorem 4.1])

**`Δ^n ⊆ Sp n`.** `Δ` is spanned by the `g - 1`, which lie in `Sp 1` (Lemma 2.1), and the
sorting lemma gives `Sp k · Sp l ⊆ Sp (k + l)`.

**`D₃ ⊆ γ₃`.** Following Tahara's Theorem 4.1 (only the direction we need), let
`M₁ = W₁* ⊕ W₂`: the free abelian group on the letters, `Sp²(G/γ₂)` in coordinates
(`ℤ/(o_i, o_j)` at the pair `i ≤ j` of letters of weight `1`), and `γ₂/γ₃`. The map
`ψ₁ : ℤ[G] → M₁` sends a basic product to its *symbol* `Φ₁`: `x̄_i` for `x_i - 1` (weight `1`),
`x̄_i ∨ x̄_j` for `(x_i - 1)(x_j - 1)`, the class of `x_k` for `x_k - 1` (weight `2`), and `0` in
weight `≥ 3`. With `R₁` generated by `o_i x̄_i + C(o_i, 2) x̄_i ∨ x̄_i - \overline{x_i^{o_i}}`, every
proper product satisfies `ψ₁(P a) ≡ Φ₁(a) (mod R₁)` (`U1`, by Tahara's induction); hence
`ψ₁(Δ³) ⊆ R₁`. For `g ∈ D₃ ⊆ γ₂`, `ψ₁(g - 1)` is the class of `g` in `γ₂/γ₃`, and an element of
`R₁` with zero free part is `0`; so `g ∈ γ₃`.
-/

namespace GroupDimension

namespace TaharaProof

open MonoidAlgebra Tahara ExpThree ClassFour

variable {G : Type*} [Group G] {ι : Type*} [LinearOrder ι] [Fintype ι]

namespace Frame

variable (F : Frame G ι)

/-! ## `Δ^n ⊆ Sp n` -/

theorem Sp_mul_Sp_univ {k r : ℕ} {z v : MonoidAlgebra ℤ G} (hz : z ∈ F.Sp k Set.univ)
    (hv : v ∈ F.Sp r Set.univ) : z * v ∈ F.Sp (k + r) Set.univ :=
  F.Sp_mul_Sp (fun i _ => F.Sp_mul_X isUpperSet_univ i (Set.mem_univ i)) hz hv

theorem Sp_zero_eq_top : F.Sp 0 Set.univ = ⊤ := by
  rw [eq_top_iff, ← F.P_span]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨b, rfl⟩
  exact F.P_mem_Sp (Nat.zero_le _) fun _ _ => Set.mem_univ _

theorem augIdeal_le_Sp {y : MonoidAlgebra ℤ G} (hy : y ∈ augIdeal G) : y ∈ F.Sp 1 Set.univ := by
  have key : ∀ z : MonoidAlgebra ℤ G, z - (augmentation G z : ℤ) • (1 : MonoidAlgebra ℤ G) ∈
      F.Sp 1 Set.univ := by
    intro z
    induction z using CentralRoot.induction_of with
    | h0 => simp
    | hof g =>
      rw [augmentation_of, one_smul]
      exact F.of_sub_one_mem (k := 1) (by simp) _ fun _ _ => Set.mem_univ _
    | hneg y hy =>
      have : -y - (augmentation G (-y) : ℤ) • (1 : MonoidAlgebra ℤ G) =
          -(y - (augmentation G y : ℤ) • (1 : MonoidAlgebra ℤ G)) := by
        rw [_root_.map_neg, neg_smul]; abel
      rw [this]; exact neg_mem hy
    | hadd y z hy hz =>
      have : y + z - (augmentation G (y + z) : ℤ) • (1 : MonoidAlgebra ℤ G) =
          (y - (augmentation G y : ℤ) • 1) + (z - (augmentation G z : ℤ) • 1) := by
        rw [map_add, add_smul]; abel
      rw [this]; exact add_mem hy hz
  have := key y
  rwa [mem_augIdeal.mp hy, zero_smul, sub_zero] at this

/-- `Δ^n ⊆ Sp n` (so `Δ^n ⊆ Λ_n`). -/
theorem augIdeal_pow_le_Sp (n : ℕ) {z : MonoidAlgebra ℤ G} (hz : z ∈ augIdeal G ^ n) :
    z ∈ F.Sp n Set.univ := by
  induction n generalizing z with
  | zero => rw [F.Sp_zero_eq_top]; exact Submodule.mem_top
  | succ n ih =>
    rw [Submodule.pow_succ] at hz
    refine Submodule.mul_induction_on hz (fun a ha b hb => ?_) (fun _ _ h h' => add_mem h h')
    exact F.Sp_mul_Sp_univ (ih ha) (F.augIdeal_le_Sp hb)

theorem P_single (j : ι) : F.P (Pi.single j 1) = F.X j := by
  rw [← zero_add (Pi.single j 1 : ι → ℕ), ← F.P_mul_X (by simp), P_zero, one_mul]

/-! ## Words of small length -/

theorem eq_single_of_word {a : ι → ℕ} {i : ι} (h : word a = [i]) : a = Pi.single i 1 := by
  classical
  funext j
  rw [← count_word a j, h]
  by_cases hj : j = i
  · subst hj; simp
  · simp [List.count_singleton, Ne.symm hj, Pi.single_eq_of_ne hj]

theorem count_of_word {a : ι → ℕ} {l : List ι} (h : word a = l) (j : ι) : a j = l.count j := by
  classical
  rw [← count_word a j, h]

theorem W_of_word {a : ι → ℕ} {l : List ι} (h : word a = l) : F.W a = (l.map F.w).sum := by
  rw [F.W_eq_word, h]

/-! ## The target `M₁` -/

/-- `W₁* ⊕ W₂` in coordinates. -/
abbrev M1 := (ι → ℤ) × ((p : ι × ι) → ZMod (Nat.gcd (F.o p.1) (F.o p.2))) ×
  Additive (Layer G 1)

/-- `x̄_i ∈ W₁*`. -/
def v1 (i : ι) : F.M1 := (Pi.single i 1, 0, 0)

/-- `x̄_i ∨ x̄_j ∈ Sp²`. -/
def s2 (i j : ι) : F.M1 := (0, Pi.single (i, j) 1, 0)

/-- The class of `g` in `γ₂/γ₃`. -/
noncomputable def c2 (g : G) : F.M1 := (0, 0, cl G 1 g)

/-- The symbol of a word in `M₁`. -/
noncomputable def Φ1w : List ι → F.M1
  | [i] => if F.w i = 1 then F.v1 i else if F.w i = 2 then F.c2 (F.x i) else 0
  | [i, j] => if F.w i = 1 ∧ F.w j = 1 then F.s2 i j else 0
  | _ => 0

/-- The symbol of an `m`-sequence in `M₁`. -/
noncomputable def Φ1 (a : ι → ℕ) : F.M1 := F.Φ1w (word a)

theorem Φ1w_long {l : List ι} (h : 3 ≤ l.length) : F.Φ1w l = 0 := by
  match l, h with
  | [], h => simp at h
  | [_], h => simp at h
  | [_, _], h => simp at h
  | _ :: _ :: _ :: _, _ => rfl

theorem c2_mul {g h : G} (hg : g ∈ lowerCentralSeries G 1) (hh : h ∈ lowerCentralSeries G 1) :
    F.c2 (g * h) = F.c2 g + F.c2 h := by
  simp [c2, cl_mul hg hh]

theorem c2_of_mem {g : G} (hg : g ∈ lowerCentralSeries G 2) : F.c2 g = 0 := by
  by_cases h1 : g ∈ lowerCentralSeries G 1
  · simp [c2, (cl_eq_zero_iff h1).mpr hg]
  · exact absurd (lcs_mem_of_le (by norm_num) hg) h1

theorem Φ1_single (i : ι) : F.Φ1 (Pi.single i 1) =
    if F.w i = 1 then F.v1 i else if F.w i = 2 then F.c2 (F.x i) else 0 := by
  classical
  rw [Φ1, word_single]; rfl

/-- For a letter of weight `≥ 2`, the symbol of `x - 1` is its class in `γ₂/γ₃`. -/
theorem Φ1_single_of_two_le {i : ι} (h : 2 ≤ F.w i) : F.Φ1 (Pi.single i 1) = F.c2 (F.x i) := by
  rw [Φ1_single, if_neg (by omega)]
  split_ifs with h2
  · rfl
  · exact (F.c2_of_mem (lcs_mem_of_le (by omega) (F.mem i))).symm

theorem Φ1_eq_zero_of_length {a : ι → ℕ} (h : 3 ≤ ∑ j, a j) : F.Φ1 a = 0 :=
  F.Φ1w_long (by rw [length_word]; exact h)

theorem Φ1_eq_zero_of_W {a : ι → ℕ} (h : 3 ≤ F.W a) : F.Φ1 a = 0 := by
  have hW := F.W_eq_word a
  unfold Φ1
  generalize word a = l at hW
  match l with
  | [] => rfl
  | [i] =>
    simp at hW
    simp only [Φ1w]; rw [if_neg (by omega), if_neg (by omega)]
  | [i, j] =>
    simp at hW
    simp only [Φ1w]; rw [if_neg (by omega)]
  | _ :: _ :: _ :: _ => rfl

theorem Φ1_nsmul_single (n : ℕ) (i : ι) : F.Φ1 (n • Pi.single i 1) =
    if n = 1 then F.Φ1 (Pi.single i 1) else if n = 2 ∧ F.w i = 1 then F.s2 i i else 0 := by
  classical
  rcases n with _ | _ | _ | n
  · rw [Φ1, word_nsmul_single]; rfl
  · simp
  · rw [Φ1, word_nsmul_single]
    simp only [List.replicate, Φ1w]
    by_cases h : F.w i = 1 <;> simp [h]
  · rw [F.Φ1_eq_zero_of_length (by rw [sum_nsmul_single]; omega)]
    simp

theorem zsmul_single_zmod {p : ι × ι} {n : ℤ} (h : (Nat.gcd (F.o p.1) (F.o p.2) : ℤ) ∣ n) :
    n • (Pi.single p 1 : (q : ι × ι) → ZMod (Nat.gcd (F.o q.1) (F.o q.2))) = 0 := by
  classical
  funext q
  by_cases hq : q = p
  · subst hq
    simp only [Pi.smul_apply, Pi.single_eq_same, zsmul_eq_mul, mul_one, Pi.zero_apply]
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr h
  · simp [Pi.single_eq_of_ne hq]

/-- `o_x Φ₁(c) = 0` when `x` occurs in `c ≠ e_x`. -/
theorem o_smul_Φ1 {c : ι → ℕ} {x : ι} (hcx : c x ≠ 0) (hne : c ≠ Pi.single x 1) :
    (F.o x : ℤ) • F.Φ1 c = 0 := by
  classical
  have hcnt := count_of_word (a := c) rfl
  unfold Φ1
  generalize word c = l at hcnt
  match l with
  | [] => simp [Φ1w]
  | [i] =>
    exfalso
    have : c = Pi.single i 1 := funext fun j => by
      rw [hcnt j, List.count_singleton, single_apply']
      by_cases h : j = i
      · subst h; simp
      · simp [h, Ne.symm h]
    subst this
    by_cases h : x = i
    · subst h; exact hne rfl
    · exact hcx (by simp [Pi.single_eq_of_ne h])
  | [i, j] =>
    simp only [Φ1w]
    split_ifs
    · have hx : x = i ∨ x = j := by
        by_contra h; push Not at h
        apply hcx; rw [hcnt x]
        simp [List.count_cons, Ne.symm h.1, Ne.symm h.2]
      simp only [s2, Prod.smul_mk, smul_zero, Prod.mk_eq_zero, true_and, and_true]
      apply F.zsmul_single_zmod
      rcases hx with rfl | rfl
      · exact Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_left _ _)
      · exact Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right _ _)
    · simp
  | _ :: _ :: _ :: _ => simp [Φ1w]

/-! ## `ψ₁` and `R₁` -/

/-- Tahara's `R₁*`. -/
noncomputable def R1 : Submodule ℤ F.M1 :=
  Submodule.span ℤ (Set.range fun i : {i : ι // F.w i = 1} =>
    (F.o i : ℤ) • F.v1 i + ((F.o i).choose 2 : ℤ) • F.s2 i i - F.c2 (F.x i ^ F.o i))

variable [Fintype G]

/-- `ψ₁ : ℤ[G] → M₁`, the symbol on basic products. -/
noncomputable def ψ1 : MonoidAlgebra ℤ G →ₗ[ℤ] F.M1 := F.basis.constr ℤ fun b => F.Φ1 b.val

theorem ψ1_basic {a : ι → ℕ} (ha : ∀ j, a j < F.o j) : F.ψ1 (F.P a) = F.Φ1 a := by
  have : F.P a = F.basis (F.toBasic a ha) := by rw [basis_apply, toBasic_val]
  rw [this, ψ1, Module.Basis.constr_basis, toBasic_val]

/-- Pairs `(z, v)` with `ψ₁ z ≡ v (mod R₁)`. -/
noncomputable def rel1 : Submodule ℤ (MonoidAlgebra ℤ G × F.M1) :=
  (F.R1).comap (F.ψ1.comp (LinearMap.fst ℤ _ _) - LinearMap.snd ℤ _ _)

theorem mem_rel1 {z : MonoidAlgebra ℤ G} {v : F.M1} : (z, v) ∈ F.rel1 ↔ F.ψ1 z - v ∈ F.R1 := by
  simp [rel1]

theorem rel1_congr {z : MonoidAlgebra ℤ G} {v v' : F.M1} (h : (z, v) ∈ F.rel1)
    (hv : v - v' ∈ F.R1) : (z, v') ∈ F.rel1 := by
  rw [mem_rel1] at *
  have := add_mem h hv
  rwa [sub_add_sub_cancel] at this

theorem gen_mem_R1 {i : ι} (hi : F.w i = 1) :
    (F.o i : ℤ) • F.v1 i + ((F.o i).choose 2 : ℤ) • F.s2 i i - F.c2 (F.x i ^ F.o i) ∈ F.R1 :=
  Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩

theorem rel1_zero : ((0 : MonoidAlgebra ℤ G), (0 : F.M1)) ∈ F.rel1 := by
  rw [mem_rel1, map_zero, sub_zero]; exact zero_mem _

theorem rel1_add {z z' : MonoidAlgebra ℤ G} {v v' : F.M1} (h : (z, v) ∈ F.rel1)
    (h' : (z', v') ∈ F.rel1) : (z + z', v + v') ∈ F.rel1 := by
  rw [mem_rel1] at *
  convert add_mem h h' using 1
  rw [map_add]; abel

theorem rel1_sub {z z' : MonoidAlgebra ℤ G} {v v' : F.M1} (h : (z, v) ∈ F.rel1)
    (h' : (z', v') ∈ F.rel1) : (z - z', v - v') ∈ F.rel1 := by
  rw [mem_rel1] at *
  convert sub_mem h h' using 1
  rw [_root_.map_sub]; abel

theorem rel1_smul {z : MonoidAlgebra ℤ G} {v : F.M1} (c : ℤ) (h : (z, v) ∈ F.rel1) :
    (c • z, c • v) ∈ F.rel1 := by
  rw [mem_rel1] at *
  convert Submodule.smul_mem _ c h using 1
  rw [map_zsmul, smul_sub]

theorem rel1_sum {α : Type*} (s : Finset α) (c : α → ℤ) (z : α → MonoidAlgebra ℤ G)
    (v : α → F.M1) (h : ∀ i ∈ s, (z i, v i) ∈ F.rel1) :
    (∑ i ∈ s, c i • z i, ∑ i ∈ s, c i • v i) ∈ F.rel1 := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using F.rel1_zero
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi]
    exact F.rel1_add (F.rel1_smul _ (h i (Finset.mem_insert_self i s)))
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

/-- `∑ b_j (x_j - 1)` against `∑ b_j Φ₁(e_j)` when all the `e_j` with `b_j ≠ 0` are handled. -/
theorem sum_rel {b : ι → ℕ} (h : ∀ j, b j ≠ 0 → (F.P (Pi.single j 1), F.Φ1 (Pi.single j 1)) ∈ F.rel1) :
    (∑ j, (b j : ℤ) • F.X j, ∑ j, (b j : ℤ) • F.Φ1 (Pi.single j 1)) ∈ F.rel1 := by
  have e : ∀ j, F.X j = F.P (Pi.single j 1) := fun j => (F.P_single j).symm
  simp only [e]
  have key : ∀ j ∈ (Finset.univ.filter fun j => b j ≠ 0),
      (F.P (Pi.single j 1), F.Φ1 (Pi.single j 1)) ∈ F.rel1 :=
    fun j hj => h j (Finset.mem_filter.mp hj).2
  have := F.rel1_sum _ (fun j => (b j : ℤ)) _ _ key
  rwa [Finset.sum_filter_of_ne (p := fun j => b j ≠ 0) (fun j _ h0 hj => h0 (by simp [hj])),
    Finset.sum_filter_of_ne (p := fun j => b j ≠ 0) (fun j _ h0 hj => h0 (by simp [hj]))] at this

/-- The class of a product of letters of weight `≥ 2`. -/
theorem c2_nprod {b : ι → ℕ} (hb : ∀ j, b j ≠ 0 → 2 ≤ F.w j) :
    F.c2 (F.nprod b) = ∑ j, (b j : ℤ) • F.c2 (F.x j) := by
  have hmem : ∀ j, b j ≠ 0 → F.x j ∈ lowerCentralSeries G 1 := fun j hj =>
    lcs_mem_of_le (by have := hb j hj; omega) (F.mem j)
  have key : ∀ l : List ι, (∀ j ∈ l, b j ≠ 0 → F.x j ∈ lowerCentralSeries G 1) →
      F.c2 (l.map fun j => F.x j ^ b j).prod = (l.map fun j => (b j : ℤ) • F.c2 (F.x j)).sum := by
    intro l
    induction l with
    | nil => simp [c2, cl_one]
    | cons j l ih =>
      intro hl
      have hj : F.x j ^ b j ∈ lowerCentralSeries G 1 := by
        by_cases h : b j = 0
        · simp [h, one_mem]
        · exact _root_.pow_mem (hl j List.mem_cons_self h) _
      have hrest : (l.map fun j => F.x j ^ b j).prod ∈ lowerCentralSeries G 1 := by
        refine list_prod_mem fun z hz => ?_
        obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hz
        by_cases h : b i = 0
        · simp [h, one_mem]
        · exact _root_.pow_mem (hl i (List.mem_cons_of_mem _ hi) h) _
      rw [List.map_cons, List.prod_cons, F.c2_mul hj hrest, ih fun i hi => hl i
        (List.mem_cons_of_mem _ hi), List.map_cons, List.sum_cons]
      congr 1
      by_cases h : b j = 0
      · simp [h, c2, cl_one]
      · simp [c2, ← natCast_zsmul, ← cl_zpow (hl j List.mem_cons_self h)]
  rw [nprod, lprod, key _ fun j _ hj => hmem j hj, sum_ordL]

/-! ## The induction -/

set_option maxHeartbeats 1000000 in
/-- **`ψ₁(P a) ≡ Φ₁(a) (mod R₁)`** for every `m`-sequence `a`. -/
theorem U1 (a : ι → ℕ) : (F.P a, F.Φ1 a) ∈ F.rel1 := by
  classical
  refine (lexLT_wf (ι := ι)).induction (C := fun a => (F.P a, F.Φ1 a) ∈ F.rel1) a ?_
  intro a IH
  by_cases hb : ∀ j, a j < F.o j
  · rw [mem_rel1, F.ψ1_basic hb, sub_self]; exact zero_mem _
  push Not at hb
  obtain ⟨x, hx⟩ := hb
  have hd1 : 1 ≤ F.o x := F.o_pos x
  -- the binomial terms
  have hbin : ∀ h ∈ Finset.range (F.o x - 1),
      (F.P (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ)),
        F.Φ1 (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ))) ∈ F.rel1 := by
    intro h hh
    rw [Finset.mem_range] at hh
    refine IH _ (lexLT_of x (fun j hj => ?_) ?_)
    · simp only [Pi.sub_apply, nsmul_single_apply, if_neg hj.ne, tsub_zero]
    · simp only [Pi.sub_apply, nsmul_single_apply, ↓reduceIte]; omega
  have hsum : (∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
        F.P (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ)),
      ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
        F.Φ1 (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ))) ∈ F.rel1 := by
    exact F.rel1_sum _ _ _ _ hbin
  rw [F.P_reduce hx]
  have hsplit := F.lo_add_hi hx (F.o x) le_rfl
  rw [Nat.sub_self, zero_smul, tsub_zero] at hsplit
  by_cases hlh : F.lo a x + hi a x = 0
  · -- `a = d e_x`: the term `x^d - 1`
    have ha : a = F.o x • Pi.single x 1 := by
      rw [← hsplit, add_right_comm, hlh, zero_add]
    have hlo : F.lo a x = 0 := funext fun j => by
      have := congrFun hlh j; simp only [Pi.add_apply, Pi.zero_apply] at this ⊢; omega
    have hhi : hi a x = 0 := funext fun j => by
      have := congrFun hlh j; simp only [Pi.add_apply, Pi.zero_apply] at this ⊢; omega
    rw [hlo, hhi, P_zero, one_mul, mul_one]
    obtain ⟨b, hbo, hbe⟩ := F.nf (F.x x ^ F.o x)
    have hyw : F.x x ^ F.o x ∈ lowerCentralSeries G (F.w x + 1 - 1) := by
      simpa using F.pow_mem x
    have hbw : ∀ j, b j ≠ 0 → F.w x + 1 ≤ F.w j := fun j hj =>
      F.nf_weight hyw hbo hbe hj
    have hxj : ∀ j, b j ≠ 0 → x < j := fun j hj => F.lt_of_w_lt (by have := hbw j hj; omega)
    have hwx := F.w_pos x
    -- `x^d - 1 ≡ ∑ b_j Φ₁(e_j)`
    have hT : (of ℤ G (F.x x ^ F.o x) - 1, ∑ j, (b j : ℤ) • F.Φ1 (Pi.single j 1)) ∈ F.rel1 := by
      have h2 := (F.of_nprod_sub_one b).2
      rw [show F.nprod b = F.x x ^ F.o x from hbe] at h2
      have hlin := F.sum_rel (b := b) fun j hj => IH _ (lexLT_of x (fun i hi => by
          rw [ha, nsmul_single_apply, if_neg hi.ne, single_apply',
            if_neg (ne_of_lt (lt_trans hi (hxj j hj)))]) (by
          rw [ha, nsmul_single_apply, if_pos rfl, single_apply', if_neg (hxj j hj).ne]
          omega))
      have hjunk : (of ℤ G (F.x x ^ F.o x) - 1 - ∑ j, (b j : ℤ) • F.X j, (0 : F.M1)) ∈ F.rel1 := by
        generalize of ℤ G (F.x x ^ F.o x) - 1 - ∑ j, (b j : ℤ) • F.X j = z0 at h2 ⊢
        induction h2 using Submodule.span_induction with
        | zero => exact F.rel1_zero
        | add u v _ _ hu hv =>
          have := F.rel1_add hu hv; rwa [add_zero] at this
        | smul c u _ hu =>
          have := F.rel1_smul c hu; rwa [smul_zero] at this
        | mem z hz =>
        obtain ⟨β, hβb, hβ2, rfl⟩ := hz
        have hβ : ∀ j, β j ≠ 0 → b j ≠ 0 := fun j hj h0 => hj (by
          have : β j ≤ b j := hβb j; omega)
        have hW : 3 ≤ F.W β := by
          have h4 : 2 * 2 ≤ F.W β := by
            calc 2 * 2 ≤ (∑ j, β j) * 2 := Nat.mul_le_mul_right _ hβ2
              _ = ∑ j, β j * 2 := Finset.sum_mul _ _ _
              _ ≤ ∑ j, β j * F.w j := Finset.sum_le_sum fun j _ => by
                  by_cases h : β j = 0
                  · simp [h]
                  · exact Nat.mul_le_mul_left _ (by have := hbw j (hβ j h); omega)
          omega
        have hlt : lexLT β a := by
          refine lexLT_of x (fun j hj => ?_) ?_
          · have : β j = 0 := by
              by_contra h
              exact absurd (hxj j (hβ j h)) (not_lt.2 hj.le)
            rw [this, ha, nsmul_single_apply, if_neg hj.ne]
          · have : β x = 0 := by
              by_contra h
              exact lt_irrefl x (hxj x (hβ x h))
            rw [this, ha, nsmul_single_apply, if_pos rfl]; omega
        have : (F.P β, F.Φ1 β) ∈ F.rel1 := IH β hlt
        rwa [F.Φ1_eq_zero_of_W hW] at this
      have := F.rel1_add hlin hjunk
      rwa [add_sub_cancel, add_zero] at this
    refine F.rel1_congr (F.rel1_sub hT hsum) ?_
    -- the identity in `M₁`
    have hval : ∀ m, m ≤ F.o x → a - (F.o x - m) • (Pi.single x 1 : ι → ℕ) = m • Pi.single x 1 := by
      intro m hm; rw [ha]; funext j
      simp only [Pi.sub_apply, nsmul_single_apply]
      split_ifs <;> omega
    have hs : ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
          F.Φ1 (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ)) =
        ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
          F.Φ1 ((h + 1) • (Pi.single x 1 : ι → ℕ)) :=
      Finset.sum_congr rfl fun h hh => by
        rw [hval (h + 1) (by rw [Finset.mem_range] at hh; omega)]
    rw [hs]
    rw [ha]
    have hΦ2 : ∀ m, 3 ≤ m → F.Φ1 (m • (Pi.single x 1 : ι → ℕ)) = 0 := fun m hm =>
      F.Φ1_eq_zero_of_length (by rw [sum_nsmul_single]; exact hm)
    have key : ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
          F.Φ1 ((h + 1) • (Pi.single x 1 : ι → ℕ)) + F.Φ1 (F.o x • (Pi.single x 1 : ι → ℕ)) =
        (F.o x : ℤ) • F.Φ1 (Pi.single x 1) + ((F.o x).choose 2 : ℤ) • F.Φ1 (2 • Pi.single x 1) := by
      generalize F.o x = d at hd1 ⊢
      rcases Nat.lt_or_ge d 3 with h3 | h3
      · interval_cases d
        · simp
        · rw [show (2 : ℕ) - 1 = 1 from rfl, Finset.sum_range_one]
          simp only [zero_add, one_smul, Nat.choose_one_right, Nat.choose_self, Nat.cast_one]
      · obtain ⟨n, hn⟩ : ∃ n, d - 1 = n + 2 := ⟨d - 3, by omega⟩
        rw [hn, Finset.sum_range_succ', Finset.sum_range_succ', hΦ2 d h3, add_zero]
        rw [Finset.sum_eq_zero fun h _ => by rw [hΦ2 _ (by omega), smul_zero]]
        simp [natCast_zsmul]; abel
    have hc2 : ∑ j, (b j : ℤ) • F.Φ1 (Pi.single j 1) = F.c2 (F.x x ^ F.o x) := by
      rw [← hbe]
      change _ = F.c2 (F.nprod b)
      rw [F.c2_nprod fun j hj => by have := hbw j hj; omega]
      refine Finset.sum_congr rfl fun j _ => ?_
      by_cases hj : b j = 0
      · simp [hj]
      · rw [F.Φ1_single_of_two_le (by have := hbw j hj; omega)]
    have e : ∑ j, (b j : ℤ) • F.Φ1 (Pi.single j 1) -
        ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
          F.Φ1 ((h + 1) • (Pi.single x 1 : ι → ℕ)) - F.Φ1 (F.o x • (Pi.single x 1 : ι → ℕ)) =
        F.c2 (F.x x ^ F.o x) - ((F.o x : ℤ) • F.Φ1 (Pi.single x 1) +
          ((F.o x).choose 2 : ℤ) • F.Φ1 (2 • Pi.single x 1)) := by
      rw [← key, hc2]; abel
    rw [e]
    by_cases hw1 : F.w x = 1
    · rw [F.Φ1_nsmul_single, F.Φ1_single, if_pos hw1, if_neg (by norm_num), if_pos ⟨rfl, hw1⟩]
      have := neg_mem (F.gen_mem_R1 hw1)
      convert this using 1; abel
    · have hw2 : 2 ≤ F.w x := by omega
      rw [F.Φ1_nsmul_single, if_neg (by norm_num), if_neg (by omega),
        F.Φ1_single_of_two_le hw2, smul_zero, add_zero]
      have hx1 : F.x x ∈ lowerCentralSeries G 1 := lcs_mem_of_le (by omega) (F.mem x)
      have : F.c2 (F.x x ^ F.o x) = (F.o x : ℤ) • F.c2 (F.x x) := by
        simp [c2, ← zpow_natCast, cl_zpow hx1]
      rw [this, sub_self]; exact zero_mem _
  · -- `a ≠ d e_x`: everything vanishes
    have hW1 : 1 ≤ F.W (F.lo a x) + F.W (hi a x) := by
      rw [← W_add]; exact F.W_pos hlh
    have hT : (F.P (F.lo a x) * (of ℤ G (F.x x ^ F.o x) - 1) * F.P (hi a x), (0 : F.M1)) ∈
        F.rel1 := by
      refine F.below_rel F.rel1 (a := a) (K := 3) (fun β hβ hK => ?_) ?_
      · have : (F.P β, F.Φ1 β) ∈ F.rel1 := IH β hβ
        rwa [F.Φ1_eq_zero_of_W hK] at this
      · exact F.Below_mono (by have := F.w_pos x; omega) (F.T_mem hx)
    have hs1 : 1 ≤ ∑ j, (F.lo a x + hi a x) j := by
      by_contra h0; push Not at h0
      apply hlh; funext j
      have := (Finset.sum_eq_zero_iff.mp (by omega : ∑ j, (F.lo a x + hi a x) j = 0)) j
        (Finset.mem_univ j)
      simpa using this
    have hsumc : ∀ m, ∑ j, (F.lo a x + m • (Pi.single x 1 : ι → ℕ) + hi a x) j =
        ∑ j, (F.lo a x + hi a x) j + m := by
      intro m
      have := sum_nsmul_single m x
      simp only [Pi.add_apply, Finset.sum_add_distrib] at this ⊢
      omega
    have hsum0 : ∑ h ∈ Finset.range (F.o x - 1), ((F.o x).choose (h + 1) : ℤ) •
        F.Φ1 (a - (F.o x - (h + 1)) • (Pi.single x 1 : ι → ℕ)) = 0 := by
      refine Finset.sum_eq_zero fun h hh => ?_
      rw [Finset.mem_range] at hh
      rw [← F.lo_add_hi hx (h + 1) (by omega)]
      rcases Nat.eq_zero_or_pos h with rfl | hpos
      · simp only [zero_add, Nat.choose_one_right]
        refine F.o_smul_Φ1 (by simp) ?_
        intro heq; apply hlh
        funext j
        have := congrFun heq j
        simp only [Pi.add_apply, one_smul, single_apply'] at this
        simp only [Pi.add_apply, Pi.zero_apply]
        split_ifs at this <;> omega
      · rw [F.Φ1_eq_zero_of_length (by rw [hsumc]; omega), smul_zero]
    have hΦa : F.Φ1 a = 0 := by
      rcases Nat.lt_or_ge (F.o x) 2 with hd2 | hd2
      · have hd1' : F.o x = 1 := by omega
        have := F.o_smul_Φ1 (c := a) (x := x) (by omega) (by
          intro h; apply hlh; funext j
          have := congrFun h j
          rw [← hsplit] at this
          simp only [Pi.add_apply, hd1', one_smul, single_apply'] at this
          simp only [Pi.add_apply, Pi.zero_apply]
          split_ifs at this <;> omega)
        rwa [hd1', Nat.cast_one, one_smul] at this
      · refine F.Φ1_eq_zero_of_length ?_
        have := hsumc (F.o x)
        rw [hsplit] at this
        omega
    refine F.rel1_congr (F.rel1_sub hT hsum) ?_
    rw [hsum0, hΦa, sub_zero, sub_zero]; exact zero_mem _

/-- `ψ₁(Δ³) ⊆ R₁`. -/
theorem ψ1_mem_R1_of_mem_Sp3 {z : MonoidAlgebra ℤ G} (hz : z ∈ F.Sp 3 Set.univ) : F.ψ1 z ∈ F.R1 := by
  induction hz using Submodule.span_induction with
  | zero => rw [map_zero]; exact zero_mem _
  | add u v _ _ hu hv => rw [map_add]; exact add_mem hu hv
  | smul c u _ hu => rw [map_zsmul]; exact Submodule.smul_mem _ c hu
  | mem z hz =>
  obtain ⟨a, ha, -, rfl⟩ := hz
  have := F.U1 a
  rwa [mem_rel1, F.Φ1_eq_zero_of_W ha, sub_zero] at this

/-- `ψ₁(g - 1)` is the class of `g ∈ γ₂` in `γ₂/γ₃`. -/
theorem ψ1_of_sub_one {g : G} (hg : g ∈ lowerCentralSeries G 1) :
    F.ψ1 (of ℤ G g - 1) = F.c2 g := by
  classical
  obtain ⟨b, hb, rfl⟩ := F.nf g
  have hbw : ∀ j, b j ≠ 0 → 2 ≤ F.w j := fun j hj =>
    F.nf_weight (k := 2) (by simpa using hg) hb rfl hj
  obtain ⟨-, h2⟩ := F.of_nprod_sub_one b
  have hjunk : F.ψ1 (of ℤ G (F.nprod b) - 1 - ∑ j, (b j : ℤ) • F.X j) = 0 := by
    generalize of ℤ G (F.nprod b) - 1 - ∑ j, (b j : ℤ) • F.X j = z0 at h2 ⊢
    induction h2 using Submodule.span_induction with
    | zero => exact map_zero _
    | add u v _ _ hu hv => rw [map_add, hu, hv, add_zero]
    | smul c u _ hu => rw [map_zsmul, hu, smul_zero]
    | mem z hz =>
    obtain ⟨β, hβb, hβ2, rfl⟩ := hz
    have hβ : ∀ j, β j ≠ 0 → b j ≠ 0 := fun j hj h0 => hj (by
      have : β j ≤ b j := hβb j; omega)
    have hW : 3 ≤ F.W β := by
      have h4 : 2 * 2 ≤ F.W β := by
        calc 2 * 2 ≤ (∑ j, β j) * 2 := Nat.mul_le_mul_right _ hβ2
          _ = ∑ j, β j * 2 := Finset.sum_mul _ _ _
          _ ≤ ∑ j, β j * F.w j := Finset.sum_le_sum fun j _ => by
              by_cases h : β j = 0
              · simp [h]
              · exact Nat.mul_le_mul_left _ (hbw j (hβ j h))
      omega
    rw [F.ψ1_basic (fun j => lt_of_le_of_lt (hβb j) (hb j)), F.Φ1_eq_zero_of_W hW]
  have hlin : F.ψ1 (∑ j, (b j : ℤ) • F.X j) = F.c2 (F.nprod b) := by
    rw [F.c2_nprod hbw, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hj : b j = 0
    · simp [hj]
    rw [map_zsmul, ← F.P_single, F.ψ1_basic, F.Φ1_single_of_two_le (hbw j hj)]
    intro i
    by_cases hi : i = j
    · subst hi; have := hb i; simp; omega
    · simp [Pi.single_eq_of_ne hi]; exact F.o_pos i
  have e : of ℤ G (F.nprod b) - 1 =
      ∑ j, (b j : ℤ) • F.X j + (of ℤ G (F.nprod b) - 1 - ∑ j, (b j : ℤ) • F.X j) := by abel
  show F.ψ1 (of ℤ G (F.nprod b) - 1) = F.c2 (F.nprod b)
  rw [e, map_add, hjunk, hlin, add_zero]

/-- An element of `R₁` with no free part is zero. -/
theorem eq_zero_of_mem_R1 {v : Additive (Layer G 1)} (h : ((0 : ι → ℤ), (0 : _), v) ∈ F.R1) :
    v = 0 := by
  classical
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp h
  have hc0 : ∀ i, c i = 0 := by
    intro i
    have h1 := congrArg (fun m : F.M1 => m.1 i.1) hc
    simp only [Prod.fst_sum, Prod.smul_fst, Prod.fst_add, Prod.fst_sub, v1, s2, c2,
      Finset.sum_apply, Pi.smul_apply, Pi.add_apply, Pi.sub_apply, smul_zero, add_zero,
      sub_zero, Pi.zero_apply] at h1
    rw [Finset.sum_eq_single i] at h1
    · simp at h1
      rcases h1 with h1 | h1
      · exact h1
      · exact absurd h1 (F.o_pos i.1).ne'
    · intro j _ hj
      have : i.1 ≠ j.1 := fun h => hj (Subtype.ext h.symm)
      simp [Pi.single_eq_of_ne this]
    · simp
  have h3 := congrArg (fun m : F.M1 => m.2.2) hc
  simp only [hc0, zero_smul, Finset.sum_const_zero] at h3
  simpa using h3.symm

include F in
/-- **`D₃(G) ⊆ γ₃(G)`** for a finite group with a frame ([Tah81, Theorem 4.1]; Passi). -/
theorem D_three_le : D 3 G ≤ lowerCentralSeries G 2 := by
  intro g hg
  have hg2 : g ∈ lowerCentralSeries G 1 := by
    rw [← D_two]; exact D_antitone (by norm_num) hg
  have h1 := F.ψ1_mem_R1_of_mem_Sp3 (F.augIdeal_pow_le_Sp 3 (mem_D.mp hg))
  rw [F.ψ1_of_sub_one hg2] at h1
  have := F.eq_zero_of_mem_R1 h1
  rwa [cl_eq_zero_iff hg2] at this

