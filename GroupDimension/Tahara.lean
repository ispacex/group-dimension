import GroupDimension.Basic

/-!
# Tahara's description of `D₅` for groups of class `≤ 4` ([Tah81, Thm. 6.1]) — formulation only

This file states Tahara's Theorem 6.1 as a `Prop`, `TaharaFiveOne`. It is **not** proved here
and not assumed globally: a theorem that uses it takes it as an explicit hypothesis
(`ExpThree.lean`). The formulation follows the original (J. Algebra 71 (1981), checked against
the scan: the uniqueness basis p. 143, the structure constants p. 150, conditions (A)–(F)
pp. 159–160, the generators p. 161).

**Setting** ([Tah81, §6, p. 159]). `G` is a finite group with an `N`-series
`G = H₁ ⊇ H₂ ⊇ H₃ ⊇ H₄ ⊇ H₅ = 1`; we take `H_i = γ_i(G)` (`lowerCentralSeries G (i-1)`), so
`G` has class `≤ 4`. Tahara's `G ∩ (1 + Λ₅)` is `D₅(G)`: for this series the canonical
filtration `Λ_k` is the power `Δ^k` of the augmentation ideal, since `Λ_k ⊇ Δ^k`
([Tah81, p. 143]) and `Λ_k ⊆ Δ^k` because `γ_w - 1 ⊆ Δ^w`.

**Commutators.** Tahara writes `[y, x] = y⁻¹x⁻¹yx` and `[x, y, z] = [[x, y], z]`
([Tah81, Lemma 2.2]); here `tc y x`. (Mathlib's `⁅y, x⁆` is `y x y⁻¹ x⁻¹`.)

**Uniqueness basis** ([Tah81, p. 143]). For each layer `H_i/H_{i+1}` (a finite abelian group)
elements `x_{i1}, …, x_{iλ(i)}` of `H_i` such that every element of the layer is uniquely
`∑ a_j x̄_{ij}` with `0 ≤ a_j < o*(x_{ij})`, where `o*` is the order of the coset, and
`o*(x_{ij}) ∣ o*(x_{i,j+1})`. `IsLayerBasis` states this as: the cosets span, a product
`∏ x_{ij}^{a_j}` lies in `H_{i+1}` exactly when every `o*(x_{ij})` divides `a_j`, and the orders
form a divisibility chain. We also require `o* > 1` (the basis elements are not in `H_{i+1}`);
this only restricts the bases the statement speaks about. The theorem uses the layers
`i = 1, 2, 3`; the basis of `H₄` does not enter the statement.

**Structure constants** ([Tah81, p. 150]). With `d(i), e(k), f(l)` the orders of the basis
elements of the first three layers, in the normal form `(#)` of p. 143:
* `x_{1i}^{d(i)} = x_{21}^{b_{i1}} ⋯ x_{2t}^{b_{it}} x_{31}^{c_{i1}} ⋯ x_{3u}^{c_{iu}} y_{4i}`,
  `y_{4i} ∈ H₄`;
* `x_{2k}^{e(k)} = x_{31}^{d_{k1}} ⋯ x_{3u}^{d_{ku}} y'_{4k}`, `y'_{4k} ∈ H₄`;
* `[x_{1i}^{d(i)}, x_{1j}] = x_{31}^{α^{(ij)}_1} ⋯ x_{3u}^{α^{(ij)}_u} · (H₄)` for `i < j`.
The exponents are those of the normal form: `0 ≤ b_{ik} < e(k)`, `0 ≤ c_{il}, d_{kl},
α^{(ij)}_l < f(l)`. Condition (E) also contains `α^{(gg)}`, which Tahara does not define; we
define it by the same formula for `g = h`, where `[x^{d(g)}_{1g}, x_{1g}] = 1` forces
`α^{(gg)} = 0` (this is how the term arises from the generators (V), (VI) of p. 150–151).

**The theorem** ([Tah81, Thm. 6.1, p. 161]). `G ∩ (1 + Λ₅)` is generated by the elements
`∑_{i<j} u_{ij} (d(j)/d(i)) [x_{1i}^{d(i)}, x_{1j}] + ∑_{i,k} v_{ik} (∑_{k<l} b_{il} [x_{2l}, x_{2k}])
 + ∑_{i≤j≤k} w_{ijk} [x_{1i}^{d(i)}, x_{1j}, x_{1k}]`
(written additively in the abelian group `H₃`) for all integers `u_{ij}` (`i < j`), `v_{ik}`,
`v'_{ik}`, `w_{ijk}` (`i ≤ j ≤ k`), `w'_{ijk}` (`i < j ≤ k`), `w''_{ijk}` (`i ≤ j < k`) satisfying
(A)–(F). Here the families are total functions; only the entries in these index ranges occur in
the generator and in the conditions. The product below runs in a fixed order; since `H₃` is
abelian, the order does not matter. `TaharaFiveOne` states the inclusion of `D₅(G)` in the
subgroup generated by these elements (Tahara proves equality; only this direction is used).

Indices start at `0` (`Fin s`), not at `1`. As in `Statements.lean`, the groups in
`TaharaFiveOne` live in `Type` (universe `0`).
-/

namespace GroupDimension

namespace Tahara

variable {G : Type*} [Group G]

/-- Tahara's commutator `[y, x] = y⁻¹ x⁻¹ y x`. -/
def tc (y x : G) : G := y⁻¹ * x⁻¹ * y * x

/-- The ordered product `x₀^{a₀} x₁^{a₁} ⋯ x_{n-1}^{a_{n-1}}`. -/
def oprod {n : ℕ} (x : Fin n → G) (a : Fin n → ℤ) : G :=
  (List.ofFn fun i => x i ^ a i).prod

/-- `x` (with coset orders `o`) is a uniqueness basis of the layer `γ_{k+1}/γ_{k+2}`
(Mathlib index `k`). Taking `a = m • (single i)` in `indep` shows that `o i` is the order of the
coset of `x i`, Tahara's `o*(x_i)`; with `span`, `indep` is the uniqueness of the normal form with
`0 ≤ a_i < o*(x_i)`. -/
structure IsLayerBasis (k : ℕ) {n : ℕ} (x : Fin n → G) (o : Fin n → ℕ) : Prop where
  mem : ∀ i, x i ∈ lowerCentralSeries G k
  one_lt : ∀ i, 1 < o i
  dvd : ∀ i j, i ≤ j → o i ∣ o j
  indep : ∀ a : Fin n → ℤ, oprod x a ∈ lowerCentralSeries G (k + 1) ↔ ∀ i, (o i : ℤ) ∣ a i
  span : ∀ g ∈ lowerCentralSeries G k, ∃ a : Fin n → ℤ,
    (oprod x a)⁻¹ * g ∈ lowerCentralSeries G (k + 1)

/-- The data of Tahara's Theorem 6.1: uniqueness bases of the first three layers with their
orders, and the structure constants `b, c, d, α` (`dd` is Tahara's `d_{kl}`). -/
structure Data (G : Type*) [Group G] where
  s : ℕ
  t : ℕ
  u : ℕ
  x₁ : Fin s → G
  d : Fin s → ℕ
  x₂ : Fin t → G
  e : Fin t → ℕ
  x₃ : Fin u → G
  f : Fin u → ℕ
  b : Fin s → Fin t → ℤ
  c : Fin s → Fin u → ℤ
  dd : Fin t → Fin u → ℤ
  α : Fin s → Fin s → Fin u → ℤ

/-- The data are a uniqueness basis with its structure constants ([Tah81, p. 143, p. 150]). -/
structure Data.Valid (T : Data G) : Prop where
  basis₁ : IsLayerBasis 0 T.x₁ T.d
  basis₂ : IsLayerBasis 1 T.x₂ T.e
  basis₃ : IsLayerBasis 2 T.x₃ T.f
  b_range : ∀ i k, 0 ≤ T.b i k ∧ T.b i k < T.e k
  c_range : ∀ i l, 0 ≤ T.c i l ∧ T.c i l < T.f l
  dd_range : ∀ k l, 0 ≤ T.dd k l ∧ T.dd k l < T.f l
  α_range : ∀ g h l, g ≤ h → 0 ≤ T.α g h l ∧ T.α g h l < T.f l
  hb : ∀ i, (oprod T.x₂ (T.b i) * oprod T.x₃ (T.c i))⁻¹ * T.x₁ i ^ T.d i ∈
    lowerCentralSeries G 3
  hdd : ∀ k, (oprod T.x₃ (T.dd k))⁻¹ * T.x₂ k ^ T.e k ∈ lowerCentralSeries G 3
  hα : ∀ g h, g ≤ h →
    (oprod T.x₃ (T.α g h))⁻¹ * tc (T.x₁ g ^ T.d g) (T.x₁ h) ∈ lowerCentralSeries G 3

/-- Tahara's integer families `u, v, v', w, w', w''`. -/
structure Coeffs (s t : ℕ) where
  u : Fin s → Fin s → ℤ
  v : Fin s → Fin t → ℤ
  v' : Fin s → Fin t → ℤ
  w : Fin s → Fin s → Fin s → ℤ
  w' : Fin s → Fin s → Fin s → ℤ
  w'' : Fin s → Fin s → Fin s → ℤ

variable (T : Data G)

/-- `d(j)/d(i)` as an integer (exact when `i ≤ j`). -/
def Data.q (i j : Fin T.s) : ℤ := ((T.d j / T.d i : ℕ) : ℤ)

/-- `binom(d(i), r)` as an integer. -/
def Data.ch (i : Fin T.s) (r : ℕ) : ℤ := ((T.d i).choose r : ℤ)

/-- Conditions (A)–(F) of [Tah81, pp. 159–160]; `(m, n)` there is `gcd m n`. -/
structure Data.Admissible (τ : Coeffs T.s T.t) : Prop where
  A₁ : ∀ i, τ.w i i i = 0
  A₂ : ∀ i j, i < j →
    τ.u i j * T.q i j * T.ch i 2 + τ.w i i j * T.d i + τ.w'' i i j * T.d j = 0
  A₃ : ∀ i j, i < j → -τ.u i j * T.ch j 2 + τ.w i j j * T.d i + τ.w' i j j * T.d j = 0
  A₄ : ∀ i j k, i < j → j < k →
    τ.w i j k * T.d i + τ.w' i j k * T.d j + τ.w'' i j k * T.d k = 0
  B : ∀ i k, (∑ h, if i < h then τ.u i h * T.b h k else 0)
      - (∑ h, if h < i then τ.u h i * T.q h i * T.b h k else 0)
      + τ.v i k * T.d i + τ.v' i k * T.e k = 0
  C₁ : ∀ i j, i < j → τ.u i j * T.q i j * T.ch i 3 + τ.w i i j * T.ch i 2 ≡ 0 [ZMOD T.d i]
  C₂ : ∀ i j, i < j → τ.w i j j * T.ch i 2 + τ.w'' i i j * T.ch j 2 ≡ 0 [ZMOD T.d i]
  C₃ : ∀ i j, i < j → -τ.u i j * T.ch j 3 + τ.w' i j j * T.ch j 2 ≡ 0 [ZMOD T.d i]
  C₄ : ∀ i j k, i < j → j < k →
    τ.w i j k * T.ch i 2 ≡ 0 [ZMOD T.d i] ∧ τ.w' i j k * T.ch j 2 ≡ 0 [ZMOD T.d i] ∧
      τ.w'' i j k * T.ch k 2 ≡ 0 [ZMOD T.d i]
  D₁ : ∀ i k, τ.v i k * T.ch i 2 - (∑ h, if h ≤ i then τ.w h i i * T.b h k else 0)
      - (∑ h, if i < h then τ.w'' i i h * T.b h k else 0) ≡ 0 [ZMOD (Nat.gcd (T.d i) (T.e k))]
  D₂ : ∀ i j k, i < j → (∑ h, if h ≤ i then τ.w h i j * T.b h k else 0)
      + (∑ h, if i < h ∧ h ≤ j then τ.w' i h j * T.b h k else 0)
      + (∑ h, if j < h then τ.w'' i j h * T.b h k else 0) ≡ 0 [ZMOD (Nat.gcd (T.d i) (T.e k))]
  E : ∀ i l, -(∑ h, if h < i then τ.u h i * T.q h i * T.α h i l else 0)
      + (∑ h, if i < h then τ.u i h * T.c h l else 0)
      - (∑ h, if h < i then τ.u h i * T.q h i * T.c h l else 0)
      - (∑ k, τ.v' i k * T.dd k l)
      - (∑ g, ∑ h, if g ≤ i ∧ i ≤ h then τ.w g i h * T.α g h l else 0)
      - (∑ g, ∑ h, if g ≤ h ∧ h ≤ i then τ.w g h i * T.α g h l else 0)
      - (∑ g, ∑ h, if i < g ∧ g ≤ h then τ.w' i g h * T.α g h l else 0)
      ≡ 0 [ZMOD (Nat.gcd (T.d i) (T.f l))]
  F₁ : ∀ k, (∑ i, τ.v i k * T.b i k) ≡ 0 [ZMOD T.e k]
  F₂ : ∀ k l, k < l → (∑ i, τ.v i k * T.b i l) + (∑ i, τ.v i l * T.b i k) ≡ 0 [ZMOD T.e k]

/-- The `u`-part `∑_{i<j} u_{ij} (d(j)/d(i)) [x_{1i}^{d(i)}, x_{1j}]`. -/
def Data.genA (τ : Coeffs T.s T.t) : G :=
  (List.ofFn fun i => (List.ofFn fun j =>
    if i < j then tc (T.x₁ i ^ T.d i) (T.x₁ j) ^ (τ.u i j * T.q i j) else 1).prod).prod

/-- The `v`-part `∑_{i,k} v_{ik} (∑_{k<l} b_{il} [x_{2l}, x_{2k}])`. -/
def Data.genB (τ : Coeffs T.s T.t) : G :=
  (List.ofFn fun i => (List.ofFn fun k => (List.ofFn fun l =>
    if k < l then tc (T.x₂ l) (T.x₂ k) ^ T.b i l else 1).prod ^ τ.v i k).prod).prod

/-- The `w`-part `∑_{i≤j≤k} w_{ijk} [x_{1i}^{d(i)}, x_{1j}, x_{1k}]`. -/
def Data.genC (τ : Coeffs T.s T.t) : G :=
  (List.ofFn fun i => (List.ofFn fun j => (List.ofFn fun k =>
    if i ≤ j ∧ j ≤ k then tc (tc (T.x₁ i ^ T.d i) (T.x₁ j)) (T.x₁ k) ^ τ.w i j k
    else 1).prod).prod).prod

/-- Tahara's generator of `D₅` attached to the family `τ`. -/
def Data.gen (τ : Coeffs T.s T.t) : G := T.genA τ * T.genB τ * T.genC τ

end Tahara

open Tahara in
/-- **Tahara's Theorem 6.1** [Tah81, p. 161] (the inclusion `⊆`): for a finite group `G` of
class `≤ 4` and any uniqueness basis with its structure constants, `D₅(G)` lies in the subgroup
generated by the elements `gen τ` over the families `τ` satisfying (A)–(F).
Formulation only, not proved here; see the module docstring for how it matches the original. -/
def TaharaFiveOne : Prop :=
  ∀ (G : Type) [Group G] [Finite G], lowerCentralSeries G 4 = ⊥ →
    ∀ T : Data G, T.Valid →
      D 5 G ≤ Subgroup.closure {z | ∃ τ : Coeffs T.s T.t, T.Admissible τ ∧ z = T.gen τ}

end GroupDimension
