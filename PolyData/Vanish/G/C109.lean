namespace PolyData.Vanish.G.C109

open GroupDimension.TraceReplay

set_option maxHeartbeats 0

def rels0 : List (List (List (Nat × Int) × Int)) := [
  [([(2, -1), (1, -1), (6, -1), (1, 1), (6, 1), (2, 1), (6, -1), (1, -1), (6, 1), (1, 1), (2, -1), (1, -1), (6, -1), (1, 1), (6, 1), (2, -1), (6, -1), (1, -1), (6, 1), (1, 1), (2, 2)], 1), ([(3, -2), (4, -1), (3, 1), (4, 1), (3, 1), (4, -1), (3, -1), (4, 1), (3, 1), (6, -1), (3, -1), (4, -1), (3, 1), (4, 1), (3, -1), (4, -1), (3, -1), (4, 1), (3, 2), (6, 1)], 4096)]]

def rels : List (List (List (Nat × Int) × Int)) :=
  rels0

set_option maxRecDepth 100000 in
theorem ok : checkVanish 6 4 Maps.maps rels = true := by decide +kernel

end PolyData.Vanish.G.C109
