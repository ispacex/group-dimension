module

public import PolyData.Vanish.G.Maps

@[expose] public section

/-!
Check 1 of `check_trace --polymaps` in the kernel for 1 relators shared by the presentations
['G', 'c66_R0_m14_0', 'c66_Rk14_m14_0', 'c66_Rk34_m14_0', 'c66_Rk36_m14_0'] (set `G`; generated by `poly_to_lean.py vanish`). The relators are
factors `(word, k)`: nested factors as given, long flat relators split into runs `u^k` (the expansion
asserted equal to the relator by the generator).
-/

namespace PolyData.Vanish.G.C42

open GroupDimension.TraceReplay

set_option maxHeartbeats 0

def rels0 : List (List (List (Nat × Int) × Int)) := [
  [([(2, -1), (1, -1), (2, -1), (1, 1), (2, 1), (1, -1), (2, 1), (1, 1), (2, -1), (1, -1), (2, -1), (1, 1), (2, -1), (1, -1), (2, 1), (1, 1), (2, 2)], 1)]]

def rels : List (List (List (Nat × Int) × Int)) :=
  rels0

set_option maxRecDepth 100000 in
theorem ok : checkVanish 6 4 Maps.maps rels = true := by decide +kernel

end PolyData.Vanish.G.C42
