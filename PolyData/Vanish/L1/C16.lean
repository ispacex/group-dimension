module

public import PolyData.Vanish.L1.Maps

@[expose] public section

/-!
Check 1 of `check_trace --polymaps` in the kernel for 1 relators shared by the presentations
['c4m4_L1', 'c66_L1_m6_0'] (set `L1`; generated by `poly_to_lean.py vanish`). The relators are
factors `(word, k)`: nested factors as given, long flat relators split into runs `u^k` (the expansion
asserted equal to the relator by the generator).
-/

namespace PolyData.Vanish.L1.C16

open GroupDimension.TraceReplay

set_option maxHeartbeats 0

def rels : List (List (List (Nat × Int) × Int)) := [
  [([(3, -1)], 1), ([(5, -1), (4, -1), (5, 1), (4, 1), (3, 1), (4, -1), (5, -1), (4, 1), (5, 1), (3, -1), (5, -1), (4, -1), (5, 1), (4, 1), (3, -1), (4, -1), (5, -1), (4, 1), (5, 1), (3, 1)], 63), ([(5, -1), (4, -1), (5, 1), (4, 1), (3, 1), (4, -1), (5, -1), (4, 1), (5, 1), (3, -1), (5, -1), (4, -1), (5, 1), (4, 1), (3, -1), (4, -1), (5, -1), (4, 1), (5, 1), (3, 2)], 1)]]

set_option maxRecDepth 100000 in
theorem ok : checkVanish 5 4 Maps.maps rels = true := by decide +kernel

end PolyData.Vanish.L1.C16
