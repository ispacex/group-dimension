abbrev VecZ := List (Nat × Int)

def mergeZ : Nat → VecZ → VecZ → VecZ
  | 0, a, b => a ++ b
  | _ + 1, [], b => b
  | _ + 1, a, [] => a
  | n + 1, (i, x) :: a, (j, y) :: b =>
    bif Nat.blt i j then (i, x) :: mergeZ n a ((j, y) :: b)
    else bif Nat.blt j i then (j, y) :: mergeZ n ((i, x) :: a) b
    else (let s := x + y; bif s == 0 then mergeZ n a b else (i, s) :: mergeZ n a b)

/-- `c · x · X_j^m`, terms below degree `k` only. -/
def shiftZ (d k j m : Nat) (c : Int) (x : VecZ) : VecZ :=
  x.filterMap fun t =>
    let g := degOf d t.1
    bif Nat.blt (g + m) k then some (off d (g + m) + ((t.1 - off d g) * d ^ m + j * off d m), c * t.2) else none

def mulGenPowZ (d k j : Nat) (e : Int) (x : VecZ) : VecZ :=
  (List.range' 1 (k - 1)).foldl (fun acc m =>
    let c := binom e m
    bif c == 0 then acc else mergeZ (acc.length + x.length) acc (shiftZ d k j m c x)) x

def magnusZ (d k : Nat) (w : List (Nat × Int)) : VecZ :=
  w.foldl (fun x f => mulGenPowZ d k (f.1 - 1) f.2 x) [(0, 1)]

def vanVal (d w : Nat) (lam : List Int) (v : VecZ) (a u b vv : Nat) : Int :=
  v.foldl (fun s t =>
    let g := degOf d t.1
    bif Nat.blt 0 g && Nat.ble (a + g + b) w then
      s + t.2 * lam.getD (off d (a + g + b) + ((u * d ^ g + (t.1 - off d g)) * d ^ b + vv) - 1) 0
    else s) 0

def checkVanishRel (d : Nat) (r : List (Nat × Int)) (m : Nat × List Int) : Bool :=
  let v := magnusZ d (m.1 + 1) r
  (List.range m.1).all fun a => (List.range (m.1 - a)).all fun b =>
    (List.range (d ^ a)).all fun u => (List.range (d ^ b)).all fun vv => vanVal d m.1 m.2 v a u b vv == 0

def checkVanish (d : Nat) (rels : List (List (Nat × Int))) (maps : List (Nat × List Int)) : Bool :=
  rels.all fun r => r.all (fun f => Nat.blt 0 f.1 && Nat.ble f.1 d) && maps.all fun m => checkVanishRel d r m


